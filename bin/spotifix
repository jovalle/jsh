#!/usr/bin/env bash
# Update and control Spotify through the desktop client.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR
if [[ -z ${JSH_ROOT:-} ]]; then
  if [[ -n ${JSH_DIR:-} ]]; then
    JSH_ROOT=${JSH_DIR}
  elif [[ -f ${SCRIPT_DIR}/../lib/ui.sh ]]; then
    JSH_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd -P)
  else
    JSH_ROOT=${HOME}/.jsh
  fi
fi
readonly JSH_ROOT
readonly SPOTIFY_CONFIGURE_SCRIPT=${SPOTIFY_CONFIGURE_SCRIPT:-"${SCRIPT_DIR}/../scripts/unix/configure/spotify.sh"}
readonly SPOTIFY_PLAY_ROUTE=spotify:search:spotifix-play
readonly SPOTIFY_MPRIS_SERVICE=org.mpris.MediaPlayer2.spotify
readonly SPOTIFY_MPRIS_PATH=/org/mpris/MediaPlayer2
readonly MINI_DIR=${JSH_MINI_DIR:-"${JSH_ROOT}/local/mini"}
readonly MINI_APP="${MINI_DIR}/Mini Player.app"
readonly MINI_BINARY="${MINI_APP}/Contents/MacOS/mini"
readonly MINI_CONFIG="${MINI_DIR}/config.json"
readonly MINI_AGENT="${HOME}/Library/LaunchAgents/dev.jsh.mini.plist"
# shellcheck source=../lib/ui.sh
. "${JSH_ROOT}/lib/ui.sh"
jsh::init

usage() {
  cat << 'EOF'
Usage: spotifix [apply|restart|stop|open|play [180g|liked|playlist] [options]|mini [command]]

Commands:
  apply    Reapply the managed Spicetify configuration
  restart  Close and reopen Spotify
  stop     Close Spotify
  open     Open Spotify
  play     Play a random library selection
           180g       random album from the 180g playlist
           liked      random song from Liked Songs
           playlist   random saved playlist
           --shuffle, --smart-shuffle select the playback mode
           -y, --yes skips the existing-playback confirmation
  mini     Control the macOS mini player (default: start)
           start      build if needed and open the menu bar companion
           stop       stop the companion
           install    enable Spotify integration and login startup
           uninstall  disable startup and the bridge, keeping preferences
           status     show companion status
           prepare    build and self-test without starting

With no command, update Spicetify and configure Spotify.
EOF
}

spotify_is_running() {
  pgrep -x spotify > /dev/null 2>&1 ||
    pgrep -f 'Spotify.app/Contents/MacOS/Spotify' > /dev/null 2>&1
}

spotify_flatpak_is_running() {
  pgrep -f '/app/extra/share/spotify/spotify' > /dev/null 2>&1
}

spotify_flatpak_is_installed() {
  command -v flatpak > /dev/null 2>&1 && flatpak info com.spotify.Client > /dev/null 2>&1
}

spotify_native_binary() {
  local candidate
  for candidate in "${SPOTIFY_BINARY:-}" /usr/bin/spotify /usr/local/bin/spotify; do
    [[ -n ${candidate} && -x ${candidate} ]] || continue
    [[ ! ${candidate} -ef ${BASH_SOURCE[0]} ]] || continue
    printf '%s\n' "${candidate}"
    return 0
  done
  return 1
}

open_spotify() {
  local uri=${1:-} platform=${SPOTIFY_PLATFORM:-$(uname -s)} binary
  local -a command

  case ${platform} in
    Darwin)
      if [[ -n ${uri} ]]; then
        open "${uri}"
      else
        open -a Spotify
      fi
      ;;
    Linux)
      # shellcheck disable=SC2310 # Backend detection is intentionally used as a predicate.
      if spotify_flatpak_is_installed; then
        command=(flatpak run com.spotify.Client)
      elif binary=$(spotify_native_binary); then
        command=("${binary}")
      else
        printf 'spotifix: Spotify is not installed.\n' >&2
        return 1
      fi
      [[ -z ${uri} ]] || command+=("--uri=${uri}")
      "${command[@]}" > /dev/null 2>&1 &
      ;;
    *)
      printf 'spotifix: unsupported platform: %s\n' "${platform}" >&2
      return 1
      ;;
  esac
}

stop_spotify() {
  local platform=${SPOTIFY_PLATFORM:-$(uname -s)} attempt
  # shellcheck disable=SC2310 # Running state is intentionally used as a predicate.
  spotify_is_running || return 0

  case ${platform} in
    Darwin) osascript -e 'tell application "Spotify" to quit' > /dev/null ;;
    Linux)
      # Ask Spotify to quit so it can save its current window bounds.
      if command -v gdbus > /dev/null 2>&1 &&
        gdbus call --session --dest "${SPOTIFY_MPRIS_SERVICE}" \
          --object-path "${SPOTIFY_MPRIS_PATH}" \
          --method org.mpris.MediaPlayer2.Quit > /dev/null 2>&1; then
        for ((attempt = 0; attempt < 25; attempt++)); do
          spotify_is_running || return 0
          sleep 0.2
        done
      fi
      # shellcheck disable=SC2310 # Backend detection is intentionally used as a predicate.
      if spotify_flatpak_is_running && command -v flatpak > /dev/null 2>&1; then
        flatpak kill com.spotify.Client > /dev/null 2>&1
      else
        pkill -TERM -x spotify > /dev/null 2>&1
      fi
      ;;
    *)
      printf 'spotifix: unsupported platform: %s\n' "${platform}" >&2
      return 1
      ;;
  esac

  for ((attempt = 0; attempt < 50; attempt++)); do
    # shellcheck disable=SC2310 # Running state is intentionally used as a predicate.
    spotify_is_running || return 0
    sleep 0.2
  done
  printf 'spotifix: Spotify did not stop.\n' >&2
  return 1
}

restart_spotify() {
  stop_spotify
  open_spotify
}

spotify_mpris_property() {
  local property=$1
  command -v gdbus > /dev/null 2>&1 || return 1
  gdbus call --session --dest "${SPOTIFY_MPRIS_SERVICE}" \
    --object-path "${SPOTIFY_MPRIS_PATH}" \
    --method org.freedesktop.DBus.Properties.Get \
    org.mpris.MediaPlayer2.Player "${property}" 2> /dev/null
}

open_spotify_uri() {
  local uri=$1 platform=${SPOTIFY_PLATFORM:-$(uname -s)} attempt
  if [[ ${platform} == Linux ]]; then
    if spotify_playback_status > /dev/null 2>&1; then
      spotify_mpris_open_uri "${uri}"
      return
    fi
    open_spotify
    for ((attempt = 0; attempt < 50; attempt++)); do
      spotify_mpris_open_uri "${uri}" && return 0
      sleep 0.2
    done
    return 1
  fi
  open_spotify "${uri}"
}

spotify_mpris_open_uri() {
  local uri=$1
  command -v gdbus > /dev/null 2>&1 || return 1
  gdbus call --session --dest "${SPOTIFY_MPRIS_SERVICE}" \
    --object-path "${SPOTIFY_MPRIS_PATH}" \
    --method org.mpris.MediaPlayer2.Player.OpenUri "${uri}" > /dev/null 2>&1
}

spotify_playback_status() {
  local output
  output=$(spotify_mpris_property PlaybackStatus) || return 1
  case ${output} in
    *"'Playing'"*) printf 'Playing\n' ;;
    *"'Paused'"*) printf 'Paused\n' ;;
    *"'Stopped'"*) printf 'Stopped\n' ;;
    *) return 1 ;;
  esac
}

spotify_has_existing_playback() {
  local metadata can_go_next
  metadata=$(spotify_mpris_property Metadata 2> /dev/null) || metadata=
  [[ ${metadata} == *"'mpris:trackid'"* ]] && return 0
  can_go_next=$(spotify_mpris_property CanGoNext 2> /dev/null) || return 1
  [[ ${can_go_next} == *true* ]]
}

spotify_resume_existing_playback() {
  local status attempt
  status=$(spotify_playback_status) || return 1
  [[ ${status} == Playing ]] && return 0
  [[ ${status} == Paused || ${status} == Stopped ]] || return 1
  spotify_has_existing_playback || return 1
  gdbus call --session --dest "${SPOTIFY_MPRIS_SERVICE}" \
    --object-path "${SPOTIFY_MPRIS_PATH}" \
    --method org.mpris.MediaPlayer2.Player.Play > /dev/null 2>&1
  for ((attempt = 0; attempt < 50; attempt++)); do
    [[ $(spotify_playback_status 2> /dev/null) == Playing ]] && return 0
    sleep 0.1
  done
  printf 'spotifix: Spotify playback did not resume.\n' >&2
  return 1
}

confirm_play() {
  spotify_has_existing_playback || return 0
  [[ ${JSH_ASSUME_YES:-0} != 1 ]] || return 0
  [[ ! -t 0 ]] && return 0
  jsh::confirm 'Spotify already has playback or a queue. Play something else?' --default no
}

play_selection() {
  local selector=$1 shuffle_mode=$2 timestamp
  if ! confirm_play; then
    spotify_resume_existing_playback
    return
  fi
  timestamp=$(date +%s)
  open_spotify_uri "${SPOTIFY_PLAY_ROUTE}-${selector}-${shuffle_mode}-${timestamp}-${RANDOM}"
}

play_command() {
  local selector=library shuffle_mode=sequential selector_set=0 option
  for option in "$@"; do
    case ${option} in
      180g | liked | playlist)
        ((selector_set == 0)) || {
          printf 'spotifix: play accepts only one selector.\n' >&2
          return 2
        }
        selector=${option}
        selector_set=1
        ;;
      --shuffle)
        [[ ${shuffle_mode} == sequential ]] || {
          printf 'spotifix: play accepts only one shuffle mode.\n' >&2
          return 2
        }
        shuffle_mode=shuffle
        ;;
      --smart-shuffle)
        [[ ${shuffle_mode} == sequential ]] || {
          printf 'spotifix: play accepts only one shuffle mode.\n' >&2
          return 2
        }
        shuffle_mode=smart-shuffle
        ;;
      -y | --yes) JSH_ASSUME_YES=1 ;;
      *)
        printf 'spotifix: unknown play option: %s\n' "${option}" >&2
        return 2
        ;;
    esac
  done
  play_selection "${selector}" "${shuffle_mode}"
}

configure_spotify() {
  "${SPOTIFY_CONFIGURE_SCRIPT}" --yes "$@"
}

mini_prepare() {
  mkdir -p -- "${MINI_DIR}"
  chmod 700 "${MINI_DIR}"
  python3 - "${MINI_CONFIG}" << 'PY'
import json, os, secrets, sys
from pathlib import Path
path = Path(sys.argv[1])
disabled = path.with_name('config.disabled.json')
if not path.exists() and disabled.exists():
    disabled.rename(path)
if not path.exists():
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    with os.fdopen(os.open(path, flags, 0o600), 'w') as stream:
        json.dump({'token': secrets.token_hex(32), 'port': 47683,
                   'keys': ['m', 'h', 'l', 'p', 'r'], 'modifiers': 6400}, stream)
os.chmod(path, 0o600)
PY
  mkdir -p -- "${MINI_APP}/Contents/MacOS"
  if [[ ! -x ${MINI_BINARY} || ${JSH_ROOT}/lib/darwin/mini.swift -nt ${MINI_BINARY} ]]; then
    xcrun swiftc -module-cache-path "${MINI_DIR}/swift-cache" \
      "${JSH_ROOT}/lib/darwin/mini.swift" -o "${MINI_BINARY}"
    rm -f -- "${MINI_APP}/Contents/MacOS/spotimini"
    cat > "${MINI_APP}/Contents/Info.plist" << 'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>dev.jsh.mini</string>
<key>CFBundleName</key><string>Mini Player</string>
<key>CFBundleExecutable</key><string>mini</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSUIElement</key><true/>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
  fi
  "${MINI_BINARY}" --self-test
}

mini_stop() {
  launchctl bootout "gui/$(id -u)/dev.jsh.mini" 2> /dev/null || true
  pkill -f "${MINI_APP}/Contents/MacOS/" 2> /dev/null || true
}

mini_install() {
  mini_prepare
  JSH_MINI_CONFIG="${MINI_CONFIG}" configure_spotify
  mkdir -p -- "${MINI_AGENT%/*}"
  python3 - "${MINI_AGENT}" "${MINI_BINARY}" "${MINI_CONFIG}" "${MINI_DIR}" << 'PY'
import plistlib, sys
from pathlib import Path
path, binary, config, directory = sys.argv[1:]
with Path(path).open('wb') as stream:
    plistlib.dump({'Label': 'dev.jsh.mini', 'ProgramArguments': [binary, config],
                  'RunAtLoad': True, 'StandardOutPath': directory + '/stdout.log',
                  'StandardErrorPath': directory + '/stderr.log'}, stream)
PY
  mini_stop
  launchctl bootstrap "gui/$(id -u)" "${MINI_AGENT}"
  printf 'Mini Player installed. Toggle with Control+Option+Command+M.\n'
}

mini_uninstall() {
  local config_file spotify_path
  mini_stop
  rm -f -- "${MINI_AGENT}"
  config_file=$(spicetify -c)
  spotify_path=$(awk -F= '$1 ~ /^[[:space:]]*spotify_path[[:space:]]*$/ {sub(/^[[:space:]]*/, "", $2); sub(/[[:space:]]*$/, "", $2); print $2; exit}' "${config_file}")
  rm -f -- "${config_file%/*}/Extensions/mini-bridge.json" \
    "${spotify_path}/Apps/xpui/extensions/mini-bridge.json"
  if [[ -f ${MINI_CONFIG} ]]; then mv -- "${MINI_CONFIG}" "${MINI_DIR}/config.disabled.json"; fi
  printf 'Companion disabled; preferences retained.\n'
}

mini_status() {
  python3 - "${MINI_CONFIG}" << 'PY'
import json, sys, urllib.request
from pathlib import Path
try:
    config = json.loads(Path(sys.argv[1]).read_text())
    request = urllib.request.Request(f"http://127.0.0.1:{config['port']}/status",
                                    headers={'Authorization': 'Bearer ' + config['token']})
    with urllib.request.urlopen(request, timeout=3) as response:
        print(json.dumps(json.load(response), indent=2))
except (OSError, ValueError, KeyError):
    print('Mini Player companion is stopped or unavailable.', file=sys.stderr)
    sys.exit(1)
PY
}

mini_command() {
  [[ ${SPOTIFY_PLATFORM:-$(uname -s)} == Darwin ]] || {
    printf 'spotifix: mini requires macOS.\n' >&2
    return 1
  }
  case ${1:-start} in
    prepare) mini_prepare ;;
    start)
      mini_prepare
      open -a "${MINI_APP}" --args "${MINI_CONFIG}"
      ;;
    stop) mini_stop ;;
    install) mini_install ;;
    uninstall) mini_uninstall ;;
    status) mini_status ;;
    *)
      printf 'spotifix: unknown mini command: %s\n' "$1" >&2
      return 2
      ;;
  esac
}

update_spicetify() {
  command -v spicetify > /dev/null 2>&1 || {
    printf 'spotifix: spicetify is not installed.\n' >&2
    return 1
  }
  spicetify update
}

main() {
  case ${1:-} in
    '')
      update_spicetify
      configure_spotify
      ;;
    apply) configure_spotify --force ;;
    restart) restart_spotify ;;
    stop) stop_spotify ;;
    open) open_spotify ;;
    play)
      shift
      play_command "$@"
      ;;
    mini)
      shift
      mini_command "$@"
      ;;
    -h | --help | help) usage ;;
    *)
      printf 'spotifix: unknown command: %s\n' "$1" >&2
      usage >&2
      return 2
      ;;
  esac
}

if [[ ${SPOTIFY_SOURCE_ONLY:-0} != 1 ]]; then
  main "$@"
fi
