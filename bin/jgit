#!/usr/bin/env bash
##% jgit
##+ git
## identity [list|set NAME] ## Choose, list, or set the repository identity
## identities ## List configured identities
## profile [NAME|list] ## Choose or apply a repository identity
## profiles ## List configured identities
## create NAME ## Create a Git project and select its identity
## commit [-t TIME] [ARGS...] ## Commit with an optional timestamp
## amend [REF] -t TIME [--dry-run] [--yes] ## Move a commit timestamp and following commits
## rewrite [--last N|REF...] ## Rewrite commit messages and timestamps
## stash [push options] ## Stash tracked and untracked changes, excluding ignored files
## update [--stash] [--all [DIR]] ## Fast-forward repositories from their upstreams
## heal [--yes] ## Repair broken tool-owned refs
## save [--exclude PATH]... ## Back up uncommitted changes to a secret gist
## backup [--exclude PATH]... ## Alias for save
## load [--exclude PATH]... ## Restore uncommitted changes from a secret gist
## restore [--exclude PATH]... ## Alias for load
## @git-command ## Git command
##? identity list ## List configured identities
##? identity set ## Set the repository identity
##? identity set @profile ## Configured identity
##? identity @profile ## Configured identity
##? profile @profile ## Configured identity
##? amend --dry-run ## Preview timestamp changes without rewriting history
##? amend --yes ## Rewrite history without confirmation
##? update --stash ## Stash and restore local changes
##? update --all ## Update the base directory and immediate child repositories
##? update --all @directory ## Repository base directory
##? heal --yes ## Back up and remove broken tool-owned refs
##? save --exclude @path ## Exclude a repository-relative path
##? backup --exclude @path ## Exclude a repository-relative path
##? load --exclude @path ## Exclude a repository-relative path
##? restore --exclude @path ## Exclude a repository-relative path

set -euo pipefail

case $0 in
  /*) jgit_launcher=$0 ;;
  *) jgit_launcher=${PWD}/$0 ;;
esac

if [[ -z ${JSH_ROOT:-} ]]; then
  JSH_ROOT=$(CDPATH='' cd -P "${jgit_launcher%/*}/.." 2> /dev/null && pwd -P) || {
    printf 'jgit: cannot locate the repository root\n' >&2
    exit 1
  }
fi

for library_file in "${JSH_ROOT}"/lib/*; do
  [[ -f ${library_file} && -x ${library_file} ]] || continue
  # shellcheck source=/dev/null
  . "${library_file}"
done
unset library_file
jsh::init

JGIT_CONFIG=${JGIT_CONFIG:-${JSH_ROOT}/conf/git.json}
JGIT_VERSION=1.0.0
JGIT_COLOR=0
jsh_color_enabled 1 && JGIT_COLOR=1

_jgit_usage() {
  cat << 'EOF'
Usage: jgit [command] [args...]

Run without arguments in a Git repository to show its status and identity.
All unrecognized commands and options are passed directly to Git.

Commands:
  identity              Choose the repository identity
  identity list         List configured identities
  identity set NAME     Set the repository identity
  profile [NAME|list]   Alias for identity commands
  profiles              Alias for identity list
  create NAME           Create a Git project and select its identity
  commit [-t TIME]      Commit with a relative or absolute timestamp
  amend [REF] -t TIME   Move a commit timestamp and following commits
  rewrite REF...        Rewrite selected commits by hash, tag, or other ref
  rewrite --last N      Rewrite the last N first-parent commits
  stash [push options]  Stash tracked and untracked changes, excluding ignored files
  update [--stash]      Fast-forward the current branch from its upstream
  update --all [DIR]    Update repositories in DIR and its immediate children
  heal [--yes]          Repair broken tool-owned refs; preview by default
  save [--exclude PATH] Back up uncommitted changes to a secret gist
  backup                 Alias for save
  load [--exclude PATH] Restore uncommitted changes from a secret gist
  restore                Alias for load

Timestamp examples:
  +30m                  30 minutes after the latest commit
  -2h                   2 hours before the latest commit
  now, now+1h           Current time, optionally with an offset
  2026-09-05 14         Absolute hour; randomizes minutes and seconds
  2026-09-05 14:30      Absolute local date and time

Unspecified lower-order fields are randomized. Add zero-valued units for exact
relative offsets, for example +5h0m0s.

Amending an older first-parent commit shifts every following first-parent commit
by the same effective delta while preserving trees, messages, and merge parents.

Backup examples:
  jgit save --exclude .env --exclude build
  jgit load --exclude .env

Backups preserve staged, unstaged, untracked, and recursive submodule changes.
Secret gists are unlisted, not encrypted.

Environment:
  JGIT_CONFIG           Profile file (default: conf/git.json)
  JSH_PROJECT_DIR       Project directory (default: ~/projects)
EOF
}

_jgit_die() {
  jsh::log_error "$*"
  exit 1
}

_jgit_section() {
  [[ ${2:-} == first ]] || printf '\n'
  if ((JGIT_COLOR)); then
    printf '\033[1;36m%s\033[0m\n' "$1"
  else
    printf '%s\n' "$1"
  fi
}

_jgit_row() {
  printf '  %-14s %s\n' "$1" "$2"
}

_jgit_state() {
  local state=$1 text=$2 color
  case ${state} in
    ok)
      color=32
      ;;
    warn)
      color=33
      ;;
    error)
      color=31
      ;;
    *)
      color=36
      ;;
  esac
  if ((JGIT_COLOR)); then
    printf '\033[%sm%s\033[0m' "${color}" "${text}"
  else
    printf '%s' "${text}"
  fi
}

_jgit_expand_home() {
  if [[ $1 == \~ ]]; then
    printf '%s\n' "${HOME}"
  elif [[ ${1:0:2} == \~/ ]]; then
    printf '%s/%s\n' "${HOME}" "${1:2}"
  else
    printf '%s\n' "$1"
  fi
}

_jgit_ssh_key_path() {
  case $1 in
    */*) printf '%s\n' "$1" ;;
    *) printf '%s/.ssh/%s\n' \~ "$1" ;;
  esac
}

_jgit_ssh_key_type() {
  local key_name=${1##*/}
  case ${key_name} in
    id_ed25519_sk* | id_ed25519-sk*) printf 'ed25519-sk\n' ;;
    id_ecdsa_sk* | id_ecdsa-sk*) printf 'ecdsa-sk\n' ;;
    id_ed25519*) printf 'ed25519\n' ;;
    id_ecdsa*) printf 'ecdsa\n' ;;
    id_rsa*) printf 'rsa\n' ;;
    id_dsa*) printf 'dsa\n' ;;
    *) ;;
  esac
}

_jgit_generate_ssh_key() {
  local configured=$1 key_path expanded_key key_type key_directory
  key_path=$(_jgit_ssh_key_path "${configured}")
  expanded_key=$(_jgit_expand_home "${key_path}")
  [[ -e ${expanded_key} ]] && return 0

  jsh::confirm "Generate missing SSH key ${key_path}?" --default yes || return 0

  key_type=$(_jgit_ssh_key_type "${key_path}")
  if [[ -z ${key_type} ]]; then
    if [[ ${JSH_INTERACTIVE:-0} == 1 ]]; then
      key_type=$(jsh::input 'SSH key type') || _jgit_die 'SSH key type is required'
    else
      jsh_prompt 'SSH key type: '
      read -r key_type || _jgit_die 'SSH key type is required'
    fi
    [[ -n ${key_type} ]] || _jgit_die 'SSH key type is required'
  fi

  command -v ssh-keygen > /dev/null 2>&1 || _jgit_die 'ssh-keygen is required'
  key_directory=${expanded_key%/*}
  [[ ${key_directory} == "${expanded_key}" ]] || mkdir -p "${key_directory}"
  command ssh-keygen -t "${key_type}" -f "${expanded_key}" -C ''
  jsh::log_success "Generated SSH key ${key_path}"
}

_jgit_profile_names() {
  [[ -r ${JGIT_CONFIG} ]] || return 0
  jq -er '.profiles | keys_unsorted[]' "${JGIT_CONFIG}"
}

_jgit_git_commands() {
  LC_ALL=C GIT_PAGER=cat git help -a 2> /dev/null | awk '
    /^   [[:alnum:]][[:alnum:]-]*[[:space:]][[:space:]]+/ {
      command = $1
      $1 = ""
      sub(/^[[:space:]]+/, "")
      print command "\t" $0
    }
  '
  git config --get-regexp '^alias\.' 2> /dev/null | awk '
    {
      alias_name = $1
      sub(/^alias\./, "", alias_name)
      $1 = ""
      sub(/^[[:space:]]+/, "")
      print alias_name "\tAlias for " $0
    }
  ' || true
}

_jgit_profile_field() {
  local profile=$1 field=$2
  [[ -r ${JGIT_CONFIG} ]] || return 1
  jq -er --arg profile "${profile}" --arg field "${field}" \
    '.profiles[$profile][$field] // empty' "${JGIT_CONFIG}"
}

_jgit_profile_exists() {
  local candidate
  while IFS= read -r candidate; do
    [[ ${candidate} == "$1" ]] && return 0
  done < <(_jgit_profile_names)
  return 1
}

_jgit_profile_validate() {
  local profile=$1 field value
  for field in name email user ssh_key; do
    value=$(_jgit_profile_field "${profile}" "${field}")
    [[ -n ${value} ]] || {
      jsh::log_error "profile '${profile}' is missing ${field}"
      return 1
    }
  done
}

_jgit_file_metadata() {
  local metadata
  metadata=$(stat -f '%u %Lp' "$1" 2> /dev/null || true)
  if [[ ! ${metadata} =~ ^[0-9]+\ [0-7]{3,4}$ ]]; then
    metadata=$(stat -c '%u %a' "$1" 2> /dev/null || true)
  fi
  [[ ${metadata} =~ ^[0-9]+\ [0-7]{3,4}$ ]] || return 1
  printf '%s\n' "${metadata}"
}

_jgit_key_health() {
  local configured=$1 key_path key_file metadata owner mode
  HEALTH_STATE=error
  HEALTH_TEXT='not configured'
  [[ -n ${configured} ]] || return 0

  key_path=$(_jgit_ssh_key_path "${configured}")
  key_file=$(_jgit_expand_home "${key_path}")
  HEALTH_TEXT=${key_path}
  if [[ ! -e ${key_file} ]]; then
    HEALTH_TEXT="${key_path} (missing)"
    return 0
  fi
  if [[ ! -f ${key_file} || ! -r ${key_file} ]]; then
    HEALTH_TEXT="${key_path} (not a readable file)"
    return 0
  fi
  metadata=$(_jgit_file_metadata "${key_file}") || {
    HEALTH_TEXT="${key_path} (permissions unavailable)"
    return 0
  }
  owner=${metadata%% *}
  mode=${metadata#* }
  if [[ ${owner} != "$(id -u)" ]]; then
    HEALTH_TEXT="${key_path} (owned by uid ${owner})"
    return 0
  fi
  if (((8#${mode} & 0077) != 0)); then
    HEALTH_STATE=warn
    HEALTH_TEXT="${key_path} (permissions too open)"
    return 0
  fi

  HEALTH_STATE=ok
  HEALTH_TEXT=${key_path}
}

_jgit_helper_health() {
  local helper helper_name exec_dir
  helper=$(git config --get-all credential.helper 2> /dev/null |
    awk 'NF { value = $0 } END { print value }' || true)
  if [[ -z ${helper} ]]; then
    HEALTH_STATE=warn
    HEALTH_TEXT='not configured'
    return
  fi
  case ${helper} in
    '!'*)
      HEALTH_STATE=info
      HEALTH_TEXT="custom command (not executed)"
      return
      ;;
    /*)
      helper_name=${helper%% *}
      if [[ -x ${helper_name} ]]; then HEALTH_STATE=ok; else HEALTH_STATE=warn; fi
      ;;
    *)
      helper_name=${helper%% *}
      exec_dir=$(git --exec-path)
      if command -v "git-credential-${helper_name}" > /dev/null 2>&1 ||
        [[ -x ${exec_dir}/git-credential-${helper_name} ]]; then
        HEALTH_STATE=ok
      else
        HEALTH_STATE=warn
      fi
      ;;
  esac
  HEALTH_TEXT=${helper}
  [[ ${HEALTH_STATE} == ok ]] || HEALTH_TEXT="${helper} (helper not found)"
}

_jgit_active_profile() {
  git config --local --get jsh.profile 2> /dev/null || true
}

_jgit_profile_status() {
  git rev-parse --git-dir > /dev/null 2>&1 || _jgit_die 'not in a Git repository'
  local profile name email expected_name expected_email ssh_key
  profile=$(_jgit_active_profile)
  name=$(git config --get user.name 2> /dev/null || true)
  email=$(git config --get user.email 2> /dev/null || true)

  _jgit_section Identity
  if [[ -z ${profile} ]]; then
    _jgit_row Profile "$(_jgit_state warn 'not assigned')"
  elif ! _jgit_profile_exists "${profile}"; then
    _jgit_row Profile "$(_jgit_state error "${profile} (not found in ${JGIT_CONFIG})")"
  else
    expected_name=$(_jgit_profile_field "${profile}" name)
    expected_email=$(_jgit_profile_field "${profile}" email)
    if [[ ${name} == "${expected_name}" && ${email} == "${expected_email}" ]]; then
      _jgit_row Profile "$(_jgit_state ok "${profile}")"
    else
      _jgit_row Profile "$(_jgit_state warn "${profile} (Git identity differs)")"
    fi
  fi
  _jgit_row Name "${name:-not set}"
  _jgit_row Email "${email:-not set}"

  _jgit_section Credentials
  ssh_key=
  [[ -z ${profile} ]] || ssh_key=$(_jgit_profile_field "${profile}" ssh_key 2> /dev/null || true)
  _jgit_key_health "${ssh_key}"
  _jgit_row 'SSH key' "$(_jgit_state "${HEALTH_STATE}" "${HEALTH_TEXT}")"
  _jgit_helper_health
  _jgit_row 'HTTPS helper' "$(_jgit_state "${HEALTH_STATE}" "${HEALTH_TEXT}")"
}

_jgit_dashboard() {
  git rev-parse --git-dir > /dev/null 2>&1 || exec git
  local root branch remote upstream ahead behind staged unstaged untracked conflicts stashes summary
  root=$(git rev-parse --show-toplevel)
  branch=$(git symbolic-ref --quiet --short HEAD 2> /dev/null || git rev-parse --short HEAD)
  remote=$(git remote get-url origin 2> /dev/null || true)
  upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2> /dev/null || true)

  _jgit_section Repository first
  _jgit_row Root "${root}"
  _jgit_row Branch "${branch}"
  [[ -z ${remote} ]] || _jgit_row Remote "${remote}"
  if [[ -n ${upstream} ]]; then
    ahead=$(git rev-list --count '@{upstream}..HEAD')
    behind=$(git rev-list --count 'HEAD..@{upstream}')
    _jgit_row Upstream "${upstream} (${ahead} ahead, ${behind} behind)"
  fi

  staged=$(git diff --cached --name-only | wc -l | tr -d ' ')
  unstaged=$(git diff --name-only | wc -l | tr -d ' ')
  untracked=$(git ls-files --others --exclude-standard | wc -l | tr -d ' ')
  conflicts=$(git diff --name-only --diff-filter=U | wc -l | tr -d ' ')
  stashes=$(git stash list | wc -l | tr -d ' ')
  if ((staged + unstaged + untracked + conflicts == 0)); then
    summary=$(_jgit_state ok clean)
  else
    summary="${staged} staged, ${unstaged} modified, ${untracked} untracked"
    ((conflicts == 0)) || summary="${summary}, ${conflicts} conflicted"
    summary=$(_jgit_state warn "${summary}")
  fi
  _jgit_row 'Working tree' "${summary}"
  ((stashes == 0)) || _jgit_row Stashes "${stashes}"

  _jgit_profile_status

  _jgit_section 'Recent commits'
  git log -3 --format='  %h  %s  (%cr)' 2> /dev/null || printf '  No commits\n'
}

_jgit_profile_list() {
  local profile name email user ssh_key count=0
  [[ -r ${JGIT_CONFIG} ]] || _jgit_die "profile config not found: ${JGIT_CONFIG}"
  _jgit_section Profiles first
  while IFS= read -r profile; do
    count=$((count + 1))
    name=$(_jgit_profile_field "${profile}" name)
    email=$(_jgit_profile_field "${profile}" email)
    user=$(_jgit_profile_field "${profile}" user)
    ssh_key=$(_jgit_profile_field "${profile}" ssh_key)
    printf '  %s\n' "${profile}"
    printf '    %s <%s> (%s)\n' "${name:-not set}" "${email:-not set}" "${user:-not set}"
    _jgit_key_health "${ssh_key}"
    printf '    SSH key: %s\n' "$(_jgit_state "${HEALTH_STATE}" "${HEALTH_TEXT}")"
  done < <(_jgit_profile_names)
  ((count > 0)) || _jgit_die "no profiles found in ${JGIT_CONFIG}"
}

_jgit_profile_choices() {
  local preferred=$1 profile name email user label
  if [[ -n ${preferred} ]] && _jgit_profile_exists "${preferred}"; then
    name=$(_jgit_profile_field "${preferred}" name)
    email=$(_jgit_profile_field "${preferred}" email)
    user=$(_jgit_profile_field "${preferred}" user)
    printf '%s\t%-16s %-24s %-36s %s\n' "${preferred}" "${preferred} *" "${name}" "${email}" "${user}"
  fi
  while IFS= read -r profile; do
    [[ ${profile} != "${preferred}" ]] || continue
    name=$(_jgit_profile_field "${profile}" name)
    email=$(_jgit_profile_field "${profile}" email)
    user=$(_jgit_profile_field "${profile}" user)
    label=${profile}
    printf '%s\t%-16s %-24s %-36s %s\n' "${profile}" "${label}" "${name}" "${email}" "${user}"
  done < <(_jgit_profile_names)
}

_jgit_profile_select() {
  local preferred=${1:-} profile label selected answer
  local -a choices=()
  [[ -r ${JGIT_CONFIG} ]] || _jgit_die "profile config not found: ${JGIT_CONFIG}"
  _jgit_profile_names | grep -q . || _jgit_die "no profiles found in ${JGIT_CONFIG}"

  if [[ ${JSH_INTERACTIVE:-0} == 1 ]]; then
    while IFS=$'\t' read -r profile label; do
      choices+=("${profile}" "${label}")
    done < <(_jgit_profile_choices "${preferred}")
    jsh::choose_one 'PROFILE          NAME                     EMAIL                                USER' \
      "${choices[@]}" || return
    return
  fi

  printf '%-16s %-24s %-36s %s\n' PROFILE NAME EMAIL USER >&2
  _jgit_profile_choices "${preferred}" | cut -f2- >&2
  if [[ -n ${preferred} ]]; then
    jsh_prompt "Profile [${preferred}]: " >&2
  else
    jsh_prompt 'Profile: ' >&2
  fi
  read -r answer || return 1
  selected=${answer:-${preferred}}
  [[ -n ${selected} ]] || return 1
  _jgit_profile_exists "${selected}" || _jgit_die "unknown profile: ${selected}"
  printf '%s\n' "${selected}"
}

_jgit_profile_select_apply() {
  local profile
  git rev-parse --git-dir > /dev/null 2>&1 || _jgit_die 'not in a Git repository'
  profile=$(_jgit_profile_select "$(_jgit_active_profile)") || {
    jsh::log_warn 'Profile selection cancelled'
    return 1
  }
  _jgit_profile_apply "${profile}"
}

_jgit_rewrite_github_https_remotes() {
  local remote url push_url
  while IFS= read -r remote; do
    url=$(git remote get-url "${remote}" 2> /dev/null || true)
    if [[ ${url} == https://github.com/* ]]; then
      git remote set-url "${remote}" "git@github.com:${url#https://github.com/}"
    fi

    push_url=$(git config --local --get "remote.${remote}.pushurl" 2> /dev/null || true)
    if [[ ${push_url} == https://github.com/* ]]; then
      git remote set-url --push "${remote}" "git@github.com:${push_url#https://github.com/}"
    fi
  done < <(git remote)
}

_jgit_profile_apply() {
  local profile=$1 show_status=${2:-1} name email ssh_key key_path expanded_key ssh_command
  git rev-parse --git-dir > /dev/null 2>&1 || _jgit_die 'not in a Git repository'
  [[ -r ${JGIT_CONFIG} ]] || _jgit_die "profile config not found: ${JGIT_CONFIG}"
  _jgit_profile_exists "${profile}" || _jgit_die "unknown profile: ${profile}"
  _jgit_profile_validate "${profile}" || exit 1

  name=$(_jgit_profile_field "${profile}" name)
  email=$(_jgit_profile_field "${profile}" email)
  ssh_key=$(_jgit_profile_field "${profile}" ssh_key)
  key_path=$(_jgit_ssh_key_path "${ssh_key}")
  expanded_key=$(_jgit_expand_home "${key_path}")
  [[ ${expanded_key} != *'"'* && ${expanded_key} != *$'\n'* ]] || _jgit_die 'SSH key path contains unsupported characters'
  _jgit_generate_ssh_key "${key_path}"
  ssh_command="ssh -i \"${expanded_key}\" -o IdentitiesOnly=yes -o IdentityAgent=none"

  git config --local jsh.profile "${profile}"
  git config --local user.name "${name}"
  git config --local user.email "${email}"
  git config --local core.sshCommand "${ssh_command}"
  _jgit_rewrite_github_https_remotes
  jsh::log_success "Applied Git profile '${profile}'"
  if ((show_status)); then
    _jgit_profile_status
  fi
}

_jgit_profile_command() {
  case ${1:-} in
    '') _jgit_profile_select_apply ;;
    list | ls) _jgit_profile_list ;;
    set)
      [[ -n ${2:-} ]] || _jgit_die 'profile set requires a profile name'
      _jgit_profile_apply "$2"
      ;;
    -h | --help | help) printf 'Usage: jgit profile [NAME|list]\n' ;;
    *) _jgit_profile_apply "$1" ;;
  esac
}

_jgit_identity_command() {
  case ${1:-} in
    '') _jgit_profile_select_apply ;;
    list | ls) _jgit_profile_list ;;
    set)
      [[ -n ${2:-} ]] || _jgit_die 'identity set requires a profile name'
      _jgit_profile_apply "$2"
      ;;
    -h | --help | help)
      printf '%s\n' \
        'Usage: jgit identity' \
        '       jgit identity list' \
        '       jgit identity set NAME'
      ;;
    *) _jgit_profile_apply "$1" ;;
  esac
}

_jgit_create() {
  local name project_root project_path preferred profile
  (($# == 1)) || _jgit_die 'create requires one project name'
  name=$1
  case ${name} in
    '' | . | .. | -* | */*) _jgit_die "invalid project name: ${name}" ;;
  esac

  project_root=$(_jgit_expand_home "${JSH_PROJECT_DIR:-~/projects}")
  project_path=${project_root%/}/${name}
  [[ ! -e ${project_path} && ! -L ${project_path} ]] || _jgit_die "project already exists: ${project_path}"
  preferred=$(_jgit_active_profile)

  mkdir -p "${project_root}"
  mkdir "${project_path}"
  git -C "${project_path}" init

  profile=$(_jgit_profile_select "${preferred}") || {
    jsh::log_warn "Profile selection cancelled; repository kept at ${project_path}"
    return 1
  }
  (
    cd "${project_path}"
    _jgit_profile_apply "${profile}" 0
  )
  jsh::log_success "Created Git project ${project_path}"
}

_jgit_is_gnu_date() {
  date --version > /dev/null 2>&1
}

_jgit_now() {
  date +%s
}

_jgit_parse_offset() {
  local input=$1 sign=1 total=0 precision=86400 remaining number unit unit_precision
  case ${input} in
    -*)
      sign=-1
      remaining=${input#-}
      ;;
    +*) remaining=${input#+} ;;
    *) return 1 ;;
  esac
  while [[ -n ${remaining} ]]; do
    [[ ${remaining} =~ ^([0-9]+)([smhdwMy])(.*)$ ]] || return 1
    number=$((10#${BASH_REMATCH[1]}))
    unit=${BASH_REMATCH[2]}
    remaining=${BASH_REMATCH[3]}
    case ${unit} in
      s) total=$((total + number)) ;;
      m) total=$((total + number * 60)) ;;
      h) total=$((total + number * 3600)) ;;
      d) total=$((total + number * 86400)) ;;
      w) total=$((total + number * 604800)) ;;
      M) total=$((total + number * 2592000)) ;;
      y) total=$((total + number * 31536000)) ;;
    esac
    case ${unit} in
      s) unit_precision=1 ;;
      m) unit_precision=60 ;;
      h) unit_precision=3600 ;;
      *) unit_precision=86400 ;;
    esac
    if ((unit_precision < precision)); then
      precision=${unit_precision}
    fi
  done
  printf '%s %s\n' "$((sign * total))" "${precision}"
}

_jgit_parse_absolute() {
  local parsed
  parsed=$(_jgit_parse_absolute_with_precision "$1") || return 1
  printf '%s\n' "${parsed%% *}"
}

_jgit_parse_absolute_with_precision() {
  local input=$1 normalized format precision epoch round_trip
  case ${input} in
    ????-??-??)
      [[ ${input} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
      normalized="${input} 00:00:00"
      format='%Y-%m-%d %H:%M:%S'
      precision=86400
      ;;
    ????-??-??\ ??)
      [[ ${input} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}$ ]] || return 1
      normalized="${input}:00:00"
      format='%Y-%m-%d %H:%M:%S'
      precision=3600
      ;;
    ????-??-??\ ??:??)
      [[ ${input} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] || return 1
      normalized="${input}:00"
      format='%Y-%m-%d %H:%M:%S'
      precision=60
      ;;
    ????-??-??\ ??:??:??)
      [[ ${input} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || return 1
      normalized=${input}
      format='%Y-%m-%d %H:%M:%S'
      precision=1
      ;;
    ??)
      [[ ${input} =~ ^[0-9]{2}$ ]] || return 1
      normalized="$(date +%Y-%m-%d) ${input}:00:00"
      format='%Y-%m-%d %H:%M:%S'
      precision=3600
      ;;
    ??:??)
      [[ ${input} =~ ^[0-9]{2}:[0-9]{2}$ ]] || return 1
      normalized="$(date +%Y-%m-%d) ${input}:00"
      format='%Y-%m-%d %H:%M:%S'
      precision=60
      ;;
    ??:??:??)
      [[ ${input} =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || return 1
      normalized="$(date +%Y-%m-%d) ${input}"
      format='%Y-%m-%d %H:%M:%S'
      precision=1
      ;;
    *) return 1 ;;
  esac

  if _jgit_is_gnu_date; then
    epoch=$(date -d "${normalized}" +%s 2> /dev/null) || return 1
    round_trip=$(date -d "@${epoch}" '+%Y-%m-%d %H:%M:%S') || return 1
  else
    epoch=$(date -j -f "${format}" "${normalized}" +%s 2> /dev/null) || return 1
    round_trip=$(date -r "${epoch}" '+%Y-%m-%d %H:%M:%S') || return 1
  fi
  [[ ${round_trip} == "${normalized}" ]] || return 1
  printf '%s %s\n' "${epoch}" "${precision}"
}

_jgit_random_below() {
  local limit=$1 value
  if [[ ${JGIT_RANDOM_VALUE:-} =~ ^[0-9]+$ ]]; then
    value=${JGIT_RANDOM_VALUE}
  else
    value=$((RANDOM * 32768 + RANDOM))
  fi
  JGIT_RANDOM_RESULT=$((value % limit))
}

_jgit_randomize_timestamp() {
  local epoch=$1 precision=$2 local_date random timestamp resolved attempts=0
  if ((precision == 1)); then
    printf '%s\n' "${epoch}"
    return
  fi

  local_date=$(_jgit_git_date "${epoch}") || return 1
  while ((attempts < 10)); do
    attempts=$((attempts + 1))
    _jgit_random_below "${precision}"
    random=${JGIT_RANDOM_RESULT}
    case ${precision} in
      60) printf -v timestamp '%s%02d' "${local_date:0:17}" "${random}" ;;
      3600)
        printf -v timestamp '%s%02d:%02d' "${local_date:0:14}" \
          "$((random / 60))" "$((random % 60))"
        ;;
      86400)
        printf -v timestamp '%s%02d:%02d:%02d' "${local_date:0:11}" \
          "$((random / 3600))" "$(((random % 3600) / 60))" "$((random % 60))"
        ;;
    esac
    if resolved=$(_jgit_parse_absolute "${timestamp}"); then
      printf '%s\n' "${resolved}"
      return
    fi
  done
  return 1
}

_jgit_resolve_timestamp() {
  local base
  base=$(git log -1 --format='%at' 2> /dev/null || _jgit_now)
  _jgit_resolve_timestamp_from "$1" "${base}"
}

_jgit_resolve_timestamp_from() {
  local input=$1 base=$2 parsed offset precision
  case ${input} in
    now) _jgit_now ;;
    now+* | now-*)
      base=$(_jgit_now)
      parsed=$(_jgit_parse_offset "${input#now}") || return 1
      offset=${parsed%% *}
      precision=${parsed#* }
      _jgit_randomize_timestamp "$((base + offset))" "${precision}"
      ;;
    +* | -*)
      parsed=$(_jgit_parse_offset "${input}") || return 1
      offset=${parsed%% *}
      precision=${parsed#* }
      _jgit_randomize_timestamp "$((base + offset))" "${precision}"
      ;;
    *)
      parsed=$(_jgit_parse_absolute_with_precision "${input}") || return 1
      offset=${parsed%% *}
      precision=${parsed#* }
      _jgit_randomize_timestamp "${offset}" "${precision}"
      ;;
  esac
}

_jgit_git_date() {
  if _jgit_is_gnu_date; then
    date -d "@$1" '+%Y-%m-%d %H:%M:%S %z'
  else
    date -r "$1" '+%Y-%m-%d %H:%M:%S %z'
  fi
}

_jgit_parse_timestamp_args() {
  TIMESTAMP=
  GIT_ARGS=()
  while (($#)); do
    case $1 in
      -t | --timestamp)
        (($# >= 2)) || _jgit_die "option $1 requires a timestamp"
        TIMESTAMP=$2
        shift 2
        ;;
      -t=* | --timestamp=*)
        TIMESTAMP=${1#*=}
        shift
        ;;
      *)
        GIT_ARGS+=("$1")
        shift
        ;;
    esac
  done
}

_jgit_commit() {
  local epoch git_date
  _jgit_parse_timestamp_args "$@"
  if [[ -z ${TIMESTAMP} ]]; then
    exec git commit "${GIT_ARGS[@]}"
  fi
  epoch=$(_jgit_resolve_timestamp "${TIMESTAMP}") || _jgit_die "invalid timestamp: ${TIMESTAMP}"
  git_date=$(_jgit_git_date "${epoch}")
  GIT_AUTHOR_DATE=${git_date} GIT_COMMITTER_DATE=${git_date} \
    git commit --date="${git_date}" "${GIT_ARGS[@]}"
}

_jgit_amend_map_parent() {
  local parent=$1 index
  for ((index = 0; index < ${#AMEND_OLD_COMMITS[@]}; index++)); do
    if [[ ${AMEND_OLD_COMMITS[index]} == "${parent}" ]]; then
      printf '%s\n' "${AMEND_NEW_COMMITS[index]}"
      return
    fi
  done
  printf '%s\n' "${parent}"
}

_jgit_amend_reject_extra_headers() {
  local commit=$1 header
  while IFS= read -r header; do
    case ${header} in
      tree | parent | author | committer) ;;
      *) _jgit_die "cannot safely rewrite ${commit:0:12}: unsupported ${header} header" ;;
    esac
  done < <(git cat-file commit "${commit}" | awk '/^$/{exit} /^[^ ]/{print $1}')
}

_jgit_amend_cleanup() {
  [[ -z ${JGIT_AMEND_TEMP:-} ]] || rm -rf "${JGIT_AMEND_TEMP}"
}

_jgit_amend() {
  local target_ref=HEAD target_set=0 timestamp='' dry_run=0 assume_yes=0 argument target old_tip branch
  local target_epoch resolved_epoch delta index commit parent parent_epoch new_author new_committer
  local author_timezone committer_timezone tree message rewritten_message new_commit answer
  local -a parents parent_args
  AMEND_OLD_COMMITS=()
  AMEND_NEW_COMMITS=()
  AMEND_AUTHOR_EPOCHS=()
  AMEND_COMMITTER_EPOCHS=()

  while (($#)); do
    argument=$1
    case ${argument} in
      -t | --timestamp)
        (($# >= 2)) || _jgit_die "option ${argument} requires a timestamp"
        timestamp=$2
        shift 2
        ;;
      -t=* | --timestamp=*) timestamp=${argument#*=}; shift ;;
      --dry-run) dry_run=1; shift ;;
      -y | --yes) assume_yes=1; shift ;;
      -h | --help)
        printf '%s\n' \
          'Usage: jgit amend [REF] -t TIME [--dry-run] [--yes]' \
          '' \
          'Moves REF (default HEAD) and every following first-parent commit by' \
          'the effective timestamp delta. Trees, messages, and merge topology are preserved.'
        return
        ;;
      -*) _jgit_die "unknown amend option: ${argument}" ;;
      *)
        ((target_set == 0)) || _jgit_die 'amend accepts at most one commit ref'
        target_ref=${argument}
        target_set=1
        shift
        ;;
    esac
  done

  [[ -n ${timestamp} ]] || _jgit_die 'amend requires -t or --timestamp'
  git rev-parse --git-dir > /dev/null 2>&1 || _jgit_die 'not in a Git repository'
  branch=$(git symbolic-ref --quiet HEAD 2> /dev/null) || _jgit_die 'amend requires a branch checkout'
  old_tip=$(git rev-parse --verify HEAD) || _jgit_die 'amend requires at least one commit'
  target=$(git rev-parse --verify "${target_ref}^{commit}" 2> /dev/null) ||
    _jgit_die "invalid commit ref: ${target_ref}"
  [[ $(git rev-parse --is-shallow-repository) == false ]] ||
    _jgit_die 'amend requires complete history; unshallow the repository first'
  [[ -z $(git replace -l) ]] || _jgit_die 'amend does not support replacement refs'
  [[ -z $(git rev-parse -q --verify MERGE_HEAD 2> /dev/null || true) ]] ||
    _jgit_die 'a merge is in progress'
  [[ -z $(git rev-parse -q --verify CHERRY_PICK_HEAD 2> /dev/null || true) ]] ||
    _jgit_die 'a cherry-pick is in progress'
  [[ -z $(git rev-parse -q --verify REVERT_HEAD 2> /dev/null || true) ]] ||
    _jgit_die 'a revert is in progress'
  [[ ! -d $(git rev-parse --git-path rebase-merge) && ! -d $(git rev-parse --git-path rebase-apply) ]] ||
    _jgit_die 'a rebase is in progress'
  [[ ! -d $(git rev-parse --git-path sequencer) ]] || _jgit_die 'a sequencer operation is in progress'

  while IFS= read -r commit; do
    if [[ ${commit} == "${target}" || -n ${AMEND_OLD_COMMITS[0]+set} ]]; then
      AMEND_OLD_COMMITS+=("${commit}")
    fi
  done < <(git rev-list --first-parent --reverse HEAD)
  [[ -n ${AMEND_OLD_COMMITS[0]+set} ]] ||
    _jgit_die 'target must be on the current branch first-parent history'

  target_epoch=$(git show -s --format='%ct' "${target}")
  resolved_epoch=$(_jgit_resolve_timestamp_from "${timestamp}" "${target_epoch}") ||
    _jgit_die "invalid timestamp: ${timestamp}"
  delta=$((resolved_epoch - target_epoch))

  for ((index = 0; index < ${#AMEND_OLD_COMMITS[@]}; index++)); do
    commit=${AMEND_OLD_COMMITS[index]}
    _jgit_amend_reject_extra_headers "${commit}"
    if ((index == 0)); then
      new_author=${resolved_epoch}
      new_committer=${resolved_epoch}
    else
      new_author=$(($(git show -s --format='%at' "${commit}") + delta))
      new_committer=$(($(git show -s --format='%ct' "${commit}") + delta))
    fi
    _jgit_git_date "${new_author}" > /dev/null 2>&1 || _jgit_die 'author date is out of range'
    _jgit_git_date "${new_committer}" > /dev/null 2>&1 || _jgit_die 'committer date is out of range'
    AMEND_AUTHOR_EPOCHS+=("${new_author}")
    AMEND_COMMITTER_EPOCHS+=("${new_committer}")
  done

  for ((index = 0; index < ${#AMEND_OLD_COMMITS[@]}; index++)); do
    commit=${AMEND_OLD_COMMITS[index]}
    new_committer=${AMEND_COMMITTER_EPOCHS[index]}
    for parent in $(git show -s --format='%P' "${commit}"); do
      parent_epoch=$(git show -s --format='%ct' "${parent}")
      for ((argument = 0; argument < ${#AMEND_OLD_COMMITS[@]}; argument++)); do
        if [[ ${AMEND_OLD_COMMITS[argument]} == "${parent}" ]]; then
          parent_epoch=${AMEND_COMMITTER_EPOCHS[argument]}
          break
        fi
      done
      ((new_committer >= parent_epoch)) ||
        _jgit_die "timestamp would place ${commit:0:12} before parent ${parent:0:12}"
    done
  done

  printf 'Commits to move by %+d seconds:\n' "${delta}"
  for ((index = 0; index < ${#AMEND_OLD_COMMITS[@]}; index++)); do
    commit=${AMEND_OLD_COMMITS[index]}
    printf '  %s  %s -> %s  %s\n' "${commit:0:12}" \
      "$(_jgit_git_date "$(git show -s --format='%ct' "${commit}")")" \
      "$(_jgit_git_date "${AMEND_COMMITTER_EPOCHS[index]}")" \
      "$(git show -s --format='%s' "${commit}")"
  done
  if ((dry_run)); then
    return 0
  fi

  jsh::log_warn 'This rewrites commit IDs and may require a force push.'
  if ((assume_yes == 0)) && ! jsh::confirm 'Continue?' --default no; then
    jsh::log_warn 'Amend cancelled'
    return
  fi

  JGIT_AMEND_TEMP=$(mktemp -d "$(git rev-parse --git-path jgit-amend.XXXXXX)") ||
    _jgit_die 'could not create amend workspace'
  trap '_jgit_amend_cleanup' EXIT
  trap '_jgit_amend_cleanup; exit 130' HUP INT TERM
  message=${JGIT_AMEND_TEMP}/message
  rewritten_message=${JGIT_AMEND_TEMP}/rewritten-message

  for ((index = 0; index < ${#AMEND_OLD_COMMITS[@]}; index++)); do
    commit=${AMEND_OLD_COMMITS[index]}
    tree=$(git show -s --format='%T' "${commit}")
    read -r -a parents <<< "$(git show -s --format='%P' "${commit}")"
    parent_args=()
    for parent in ${parents[@]+"${parents[@]}"}; do
      parent=$(_jgit_amend_map_parent "${parent}")
      parent_args+=(-p "${parent}")
    done
    git cat-file commit "${commit}" | sed '1,/^$/d' > "${message}"
    author_timezone=$(git show -s --format='%ai' "${commit}")
    author_timezone=${author_timezone##* }
    committer_timezone=$(git show -s --format='%ci' "${commit}")
    committer_timezone=${committer_timezone##* }
    if ((index == 0)); then
      author_timezone=$(_jgit_git_date "${AMEND_AUTHOR_EPOCHS[index]}")
      author_timezone=${author_timezone##* }
      committer_timezone=${author_timezone}
    fi
    new_commit=$(
      GIT_AUTHOR_NAME="$(git show -s --format='%an' "${commit}")" \
      GIT_AUTHOR_EMAIL="$(git show -s --format='%ae' "${commit}")" \
      GIT_AUTHOR_DATE="@${AMEND_AUTHOR_EPOCHS[index]} ${author_timezone}" \
      GIT_COMMITTER_NAME="$(git show -s --format='%cn' "${commit}")" \
      GIT_COMMITTER_EMAIL="$(git show -s --format='%ce' "${commit}")" \
      GIT_COMMITTER_DATE="@${AMEND_COMMITTER_EPOCHS[index]} ${committer_timezone}" \
        git commit-tree "${tree}" ${parent_args[@]+"${parent_args[@]}"} -F "${message}"
    ) || _jgit_die "could not rewrite ${commit:0:12}"
    [[ $(git show -s --format='%T' "${new_commit}") == "${tree}" ]] ||
      _jgit_die "tree changed while rewriting ${commit:0:12}"
    git cat-file commit "${new_commit}" | sed '1,/^$/d' > "${rewritten_message}"
    cmp -s "${message}" "${rewritten_message}" ||
      _jgit_die "message changed while rewriting ${commit:0:12}"
    AMEND_NEW_COMMITS+=("${new_commit}")
  done

  new_commit=${AMEND_NEW_COMMITS[${#AMEND_NEW_COMMITS[@]} - 1]}
  git update-ref -m "jgit amend ${target_ref} ${timestamp}" "${branch}" "${new_commit}" "${old_tip}" ||
    _jgit_die 'branch changed while rewriting; no ref was updated'
  _jgit_amend_cleanup
  trap - EXIT HUP INT TERM
  unset JGIT_AMEND_TEMP
  jsh::log_success "Moved ${#AMEND_OLD_COMMITS[@]} commit$([[ ${#AMEND_OLD_COMMITS[@]} == 1 ]] || printf s)"
  printf 'Rollback: git update-ref %q %q %q\n' "${branch}" "${old_tip}" "${new_commit}"
}

_jgit_rewrite_add_commit() {
  local commit=$1 existing
  for existing in "${REWRITE_COMMITS[@]}"; do
    [[ ${existing} == "${commit}" ]] && return
  done
  REWRITE_COMMITS+=("${commit}")
}

_jgit_rewrite_sort_commits() {
  local commit selected
  REWRITE_SORTED=()
  while IFS= read -r commit; do
    for selected in "${REWRITE_COMMITS[@]}"; do
      if [[ ${selected} == "${commit}" ]]; then
        REWRITE_SORTED+=("${commit}")
        break
      fi
    done
  done < <(git rev-list --reverse --topo-order HEAD)
  REWRITE_COMMITS=("${REWRITE_SORTED[@]}")
}

_jgit_rewrite_sequence() {
  local todo=${1:-} temporary line action candidate remainder selected full found=0 expected
  [[ ${JGIT_REWRITE_ACTIVE:-} == 1 ]] || _jgit_die 'rewrite callback called outside an active rewrite'
  [[ -n ${todo} && -f ${todo} ]] || _jgit_die 'rewrite sequence file not found'
  [[ -r ${JGIT_REWRITE_SELECTED:-} ]] || _jgit_die 'rewrite selection file not found'
  temporary=$(mktemp "${todo}.jgit.XXXXXX") || _jgit_die 'could not create rewrite sequence'

  while IFS= read -r line || [[ -n ${line} ]]; do
    printf '%s\n' "${line}"
    candidate=
    read -r action candidate remainder <<< "${line}"
    if [[ ${action} == merge && (${candidate} == -C || ${candidate} == -c) ]]; then
      candidate=${remainder%% *}
    fi
    case ${action} in
      pick | edit | reword | squash | fixup | drop | merge) ;;
      *) continue ;;
    esac

    selected=
    while IFS= read -r full; do
      if [[ ${full} == "${candidate}"* ]]; then
        selected=${full}
        break
      fi
    done < "${JGIT_REWRITE_SELECTED}"
    if [[ -n ${selected} ]]; then
      found=$((found + 1))
      printf 'exec echo %s > "$JGIT_REWRITE_MARKER"\n' "${selected}"
      printf 'break\n'
    else
      printf 'exec "$JGIT_REWRITE_LAUNCHER" __rewrite-restore %s\n' "${candidate}"
    fi
  done < "${todo}" > "${temporary}"
  expected=$(wc -l < "${JGIT_REWRITE_SELECTED}")
  if ((found != expected)); then
    rm -f "${temporary}"
    _jgit_die "rewrite plan found ${found} of ${expected} selected commits"
  fi
  mv "${temporary}" "${todo}"
}

_jgit_rewrite_restore() {
  local original=${1:-} author_date committer_date committer_name committer_email
  [[ ${JGIT_REWRITE_ACTIVE:-} == 1 ]] || _jgit_die 'rewrite callback called outside an active rewrite'
  [[ -d $(git rev-parse --git-path rebase-merge 2> /dev/null) ]] ||
    _jgit_die 'rewrite callback called outside a rebase'
  [[ -n ${original} ]] || _jgit_die 'rewrite restore requires a commit'
  author_date=$(git show -s --format='%aI' "${original}")
  committer_date=$(git show -s --format='%cI' "${original}")
  committer_name=$(git show -s --format='%cn' "${original}")
  committer_email=$(git show -s --format='%ce' "${original}")
  GIT_AUTHOR_DATE=${author_date} GIT_COMMITTER_DATE=${committer_date} \
    GIT_COMMITTER_NAME=${committer_name} GIT_COMMITTER_EMAIL=${committer_email} \
    git commit --amend --allow-empty --no-edit --no-verify --date="${author_date}" > /dev/null
}

_jgit_rewrite_abort() {
  local restore_status=0
  trap - EXIT HUP INT TERM
  git rebase --abort > /dev/null 2>&1 || true
  _jgit_rewrite_restore_worktree || restore_status=$?
  rm -f "${JGIT_REWRITE_SELECTED:-}" "${JGIT_REWRITE_MARKER:-}" \
    "${JGIT_REWRITE_LAUNCHER:-}"
  return "${restore_status}"
}

_jgit_rewrite() {
  local last='' ref commit count common base parent sequence_editor answer original timestamp
  local author_date committer_date committer_name committer_email epoch git_date edited=0
  REWRITE_COMMITS=()
  REWRITE_REFS=()

  while (($#)); do
    case $1 in
      --last | -n)
        (($# >= 2)) || _jgit_die "option $1 requires a count"
        [[ -z ${last} ]] || _jgit_die 'rewrite accepts --last only once'
        last=$2
        shift 2
        ;;
      --last=* | -n=*)
        [[ -z ${last} ]] || _jgit_die 'rewrite accepts --last only once'
        last=${1#*=}
        shift
        ;;
      -h | --help)
        printf '%s\n' \
          'Usage: jgit rewrite REF...' \
          '       jgit rewrite --last N' \
          '' \
          'Refs may be commit hashes, tags, branches, or relative refs such as HEAD~2.' \
          'Selected commits must be reachable from HEAD. Tags are not moved.' \
          'Local staged, unstaged, and untracked changes are stashed and restored.'
        return
        ;;
      --)
        shift
        while (($#)); do
          REWRITE_REFS+=("$1")
          shift
        done
        ;;
      -*) _jgit_die "unknown rewrite option: $1" ;;
      *)
        REWRITE_REFS+=("$1")
        shift
        ;;
    esac
  done

  git rev-parse --git-dir > /dev/null 2>&1 || _jgit_die 'not in a Git repository'
  git symbolic-ref --quiet HEAD > /dev/null || _jgit_die 'rewrite requires a branch checkout'
  [[ -z $(git diff --name-only --diff-filter=U) ]] || _jgit_die 'rewrite cannot stash unresolved conflicts'
  [[ ! -d $(git rev-parse --git-path rebase-merge) && ! -d $(git rev-parse --git-path rebase-apply) ]] ||
    _jgit_die 'another rebase is already in progress'
  [[ -z ${last} || ${#REWRITE_REFS[@]} == 0 ]] || _jgit_die 'use either refs or --last, not both'

  if [[ -n ${last} ]]; then
    [[ ${last} =~ ^[1-9][0-9]*$ ]] || _jgit_die '--last requires a positive integer'
    while IFS= read -r commit; do
      _jgit_rewrite_add_commit "${commit}"
    done < <(git rev-list --first-parent --max-count="${last}" HEAD)
    count=${#REWRITE_COMMITS[@]}
    ((count == last)) || _jgit_die "requested ${last} commits, but this branch has ${count}"
  else
    ((${#REWRITE_REFS[@]} > 0)) || _jgit_die 'rewrite requires one or more refs or --last N'
    for ref in "${REWRITE_REFS[@]}"; do
      commit=$(git rev-parse --verify "${ref}^{commit}" 2> /dev/null) || _jgit_die "invalid commit ref: ${ref}"
      git merge-base --is-ancestor "${commit}" HEAD || _jgit_die "commit is not reachable from HEAD: ${ref}"
      _jgit_rewrite_add_commit "${commit}"
    done
  fi

  _jgit_rewrite_sort_commits

  jsh::log_warn 'Rewriting published commits requires a force push.'
  printf 'Selected commits (edited oldest first):\n'
  for commit in "${REWRITE_COMMITS[@]}"; do
    git show -s --format='  %h  %s  (%ad)' --date=short "${commit}"
  done
  if ! jsh::confirm 'Continue?' --default no; then
    jsh::log_warn 'Rewrite cancelled'
    return
  fi

  JGIT_REWRITE_SELECTED=$(git rev-parse --path-format=absolute --git-path "jgit-rewrite-selected.$$")
  JGIT_REWRITE_MARKER=$(git rev-parse --path-format=absolute --git-path "jgit-rewrite-current.$$")
  JGIT_REWRITE_LAUNCHER=$(git rev-parse --path-format=absolute --git-path "jgit-rewrite-launcher.$$")
  export JSH_ROOT JGIT_REWRITE_SELECTED JGIT_REWRITE_MARKER JGIT_REWRITE_LAUNCHER
  trap '_jgit_rewrite_abort' EXIT
  trap '_jgit_rewrite_abort; exit 130' HUP INT TERM
  command cp "${jgit_launcher}" "${JGIT_REWRITE_LAUNCHER}" ||
    _jgit_die 'could not snapshot the rewrite launcher'
  chmod 700 "${JGIT_REWRITE_LAUNCHER}"
  _jgit_rewrite_stash_worktree

  printf '%s\n' "${REWRITE_COMMITS[@]}" > "${JGIT_REWRITE_SELECTED}"
  export JGIT_REWRITE_ACTIVE=1
  printf -v sequence_editor '%q __rewrite-sequence' "${JGIT_REWRITE_LAUNCHER}"

  if ((${#REWRITE_COMMITS[@]} == 1)); then
    common=${REWRITE_COMMITS[0]}
  else
    common=$(git merge-base --octopus "${REWRITE_COMMITS[@]}") || {
      _jgit_rewrite_abort
      _jgit_die 'selected commits have no common ancestor'
    }
  fi
  base=${common}
  for commit in "${REWRITE_COMMITS[@]}"; do
    if [[ ${commit} == "${common}" ]]; then
      parent=$(git rev-parse --verify "${common}^" 2> /dev/null || true)
      base=${parent}
      break
    fi
  done

  if [[ -n ${base} ]]; then
    GIT_SEQUENCE_EDITOR=${sequence_editor} git rebase --rebase-merges -i "${base}" || {
      _jgit_rewrite_abort
      _jgit_die 'rewrite aborted'
    }
  else
    GIT_SEQUENCE_EDITOR=${sequence_editor} git rebase --rebase-merges -i --root || {
      _jgit_rewrite_abort
      _jgit_die 'rewrite aborted'
    }
  fi

  while [[ -d $(git rev-parse --git-path rebase-merge) || -d $(git rev-parse --git-path rebase-apply) ]]; do
    [[ -s ${JGIT_REWRITE_MARKER} ]] || {
      _jgit_rewrite_abort
      _jgit_die 'rewrite stopped without a selected commit'
    }
    original=$(< "${JGIT_REWRITE_MARKER}")
    printf '\n'
    git show -s --format='%h  %s%nAuthor: %an <%ae>%nAuthor date: %aI%nCommit date: %cI' "${original}"
    if [[ ${JSH_INTERACTIVE:-0} == 1 ]]; then
      timestamp=$(jsh::input 'Timestamp' --placeholder keep) || {
        _jgit_rewrite_abort
        _jgit_die 'rewrite aborted'
      }
    else
      jsh_prompt 'Timestamp [keep]: '
      read -r timestamp || {
        _jgit_rewrite_abort
        _jgit_die 'rewrite aborted'
      }
    fi
    if [[ -n ${timestamp} ]]; then
      epoch=$(_jgit_resolve_timestamp_from "${timestamp}" "$(git show -s --format='%at' "${original}")") || {
        _jgit_rewrite_abort
        _jgit_die "invalid timestamp: ${timestamp}"
      }
      git_date=$(_jgit_git_date "${epoch}")
      author_date=${git_date}
      committer_date=${git_date}
    else
      author_date=$(git show -s --format='%aI' "${original}")
      committer_date=$(git show -s --format='%cI' "${original}")
    fi
    committer_name=$(git show -s --format='%cn' "${original}")
    committer_email=$(git show -s --format='%ce' "${original}")
    printf 'Opening commit message in %s\n' "$(git var GIT_EDITOR)"
    if ! GIT_AUTHOR_DATE=${author_date} GIT_COMMITTER_DATE=${committer_date} \
      GIT_COMMITTER_NAME=${committer_name} GIT_COMMITTER_EMAIL=${committer_email} \
      git commit --amend --allow-empty --date="${author_date}"; then
      _jgit_rewrite_abort
      _jgit_die 'rewrite aborted'
    fi
    edited=$((edited + 1))
    rm -f "${JGIT_REWRITE_MARKER}"
    git rebase --continue || {
      _jgit_rewrite_abort
      _jgit_die 'rewrite aborted'
    }
  done

  count=${#REWRITE_COMMITS[@]}
  rm -f "${JGIT_REWRITE_SELECTED}" "${JGIT_REWRITE_MARKER}" "${JGIT_REWRITE_LAUNCHER}"
  ((edited == count)) || _jgit_die "rewrote ${edited} of ${count} selected commits"
  trap - EXIT HUP INT TERM
  _jgit_rewrite_restore_worktree ||
    _jgit_die 'rewrite completed, but local changes could not be restored'
  unset JGIT_REWRITE_SELECTED JGIT_REWRITE_MARKER JGIT_REWRITE_LAUNCHER JGIT_REWRITE_ACTIVE
  jsh::log_success "Rewrote ${count} commit$([[ ${count} == 1 ]] || printf s)"
}

_jgit_update_restore_stash() {
  local repo=$1 stash_oid=$2 stash_ref
  stash_ref=$(git -C "${repo}" stash list --format='%gd %H' |
    awk -v wanted="${stash_oid}" '$2 == wanted { print $1; exit }') || {
    jsh::log_error "Could not inspect stashes in ${repo}"
    return 1
  }
  if [[ -z ${stash_ref} ]]; then
    jsh::log_error "Created stash not found for ${repo}: ${stash_oid}"
    return 1
  fi
  if ! git -C "${repo}" stash pop --index --quiet "${stash_ref}"; then
    jsh::log_error "Could not restore local changes in ${repo}; stash retained as ${stash_ref}"
    return 1
  fi
}

_jgit_rewrite_stash_worktree() {
  local status previous_stash
  JGIT_REWRITE_REPO=$(git rev-parse --show-toplevel)
  JGIT_REWRITE_STASH_OID=
  status=$(git status --porcelain) || _jgit_die 'could not inspect the working tree'
  [[ -n ${status} ]] || return

  previous_stash=$(git rev-parse --verify refs/stash 2> /dev/null || true)
  git stash push --include-untracked --quiet \
    --message "jgit rewrite $(date +%Y-%m-%dT%H:%M:%S)" ||
    _jgit_die 'could not stash local changes'
  JGIT_REWRITE_STASH_OID=$(git rev-parse --verify refs/stash 2> /dev/null || true)
  if [[ -z ${JGIT_REWRITE_STASH_OID} || ${JGIT_REWRITE_STASH_OID} == "${previous_stash}" ]]; then
    _jgit_die 'could not stash local changes'
  fi

  status=$(git status --porcelain) || {
    _jgit_update_restore_stash "${JGIT_REWRITE_REPO}" "${JGIT_REWRITE_STASH_OID}" || true
    _jgit_die 'could not inspect the working tree after stashing'
  }
  if [[ -n ${status} ]]; then
    _jgit_update_restore_stash "${JGIT_REWRITE_REPO}" "${JGIT_REWRITE_STASH_OID}" || true
    _jgit_die 'could not stash all local changes'
  fi
  jsh::log_info 'Temporarily stashed local changes'
}

_jgit_rewrite_restore_worktree() {
  [[ -n ${JGIT_REWRITE_STASH_OID:-} ]] || return
  _jgit_update_restore_stash "${JGIT_REWRITE_REPO}" "${JGIT_REWRITE_STASH_OID}" || return 1
  JGIT_REWRITE_STASH_OID=
  jsh::log_success 'Restored local changes'
}

_jgit_stash() {
  local argument parsing_options=1
  local -a arguments=()
  case ${1:-} in
    list | show | drop | pop | apply | branch | clear | create | store | export | import | save)
      exec git stash "$@"
      ;;
    push) shift ;;
  esac

  for argument in "$@"; do
    if ((parsing_options)) && [[ ${argument} == -- ]]; then
      parsing_options=0
      arguments+=("${argument}")
    elif ((parsing_options)) && [[ ${argument} == -a || ${argument} == --all ]]; then
      continue
    else
      arguments+=("${argument}")
    fi
  done
  exec git stash push --include-untracked "${arguments[@]}"
}

_jgit_update_repository() {
  local repo=$1 use_stash=$2 status previous_stash='' stash_oid='' pull_status=0
  if ! git -C "${repo}" symbolic-ref --quiet HEAD > /dev/null; then
    jsh::log_error "Detached HEAD, skipped ${repo}"
    return 1
  fi
  if ! git -C "${repo}" rev-parse --verify '@{upstream}' > /dev/null 2>&1; then
    jsh::log_error "No upstream configured, skipped ${repo}"
    return 1
  fi
  if [[ -n $(git -C "${repo}" diff --name-only --diff-filter=U) ]]; then
    jsh::log_error "Unresolved conflicts, skipped ${repo}"
    return 1
  fi

  status=$(git -C "${repo}" status --porcelain) || {
    jsh::log_error "Could not inspect working tree in ${repo}"
    return 1
  }
  if [[ -n ${status} && ${use_stash} == 0 ]]; then
    jsh::log_warn "Dirty worktree, skipped ${repo}; use --stash to update"
    return 1
  fi
  if [[ -n ${status} ]]; then
    previous_stash=$(git -C "${repo}" rev-parse --verify refs/stash 2> /dev/null || true)
    if ! git -C "${repo}" stash push --include-untracked --quiet \
      --message "jgit update $(date +%Y-%m-%dT%H:%M:%S)"; then
      jsh::log_error "Could not stash local changes in ${repo}"
      return 1
    fi
    stash_oid=$(git -C "${repo}" rev-parse --verify refs/stash 2> /dev/null || true)
    if [[ -z ${stash_oid} || ${stash_oid} == "${previous_stash}" ]]; then
      jsh::log_error "Could not stash all local changes in ${repo}"
      return 1
    fi
    status=$(git -C "${repo}" status --porcelain) || {
      _jgit_update_restore_stash "${repo}" "${stash_oid}" || true
      jsh::log_error "Could not inspect working tree in ${repo}"
      return 1
    }
    if [[ -n ${status} ]]; then
      _jgit_update_restore_stash "${repo}" "${stash_oid}" || return 1
      jsh::log_error "Could not stash all local changes in ${repo}"
      return 1
    fi
  fi

  git -C "${repo}" pull --ff-only --quiet || pull_status=$?
  if [[ -n ${stash_oid} ]] && ! _jgit_update_restore_stash "${repo}" "${stash_oid}"; then
    return 1
  fi
  if ((pull_status != 0)); then
    jsh::log_error "Update failed for ${repo}; local changes restored"
    return 1
  fi
  jsh::log_success "Updated ${repo}"
}

_jgit_find_update_repositories() {
  local base=$1 candidate candidate_root
  UPDATE_REPOSITORIES=()
  for candidate in "${base}" "${base}"/*; do
    [[ -d ${candidate} ]] || continue
    candidate_root=$(git -C "${candidate}" rev-parse --show-toplevel 2> /dev/null) || continue
    [[ ${candidate_root} == "${candidate}" ]] || continue
    UPDATE_REPOSITORIES+=("${candidate_root}")
  done
}

_jgit_update() {
  local update_all=0 use_stash=0 base='' repo updated=0 failed=0 noun=repositories
  while (($#)); do
    case $1 in
      --all) update_all=1 ;;
      --stash) use_stash=1 ;;
      -h | --help)
        printf '%s\n' \
          'Usage: jgit update [--stash]' \
          '       jgit update --all [DIR] [--stash]'
        return
        ;;
      -*) _jgit_die "unknown update option: $1" ;;
      *)
        [[ -z ${base} ]] || _jgit_die 'update accepts at most one directory'
        base=$1
        ;;
    esac
    shift
  done

  if ((update_all)); then
    base=${base:-${PWD}}
    [[ -d ${base} ]] || _jgit_die "directory not found: ${base}"
    base=$(CDPATH='' cd -P "${base}" && pwd -P)
    _jgit_find_update_repositories "${base}"
    ((${#UPDATE_REPOSITORIES[@]} > 0)) || _jgit_die "no repositories found in ${base}"
  else
    [[ -z ${base} ]] || _jgit_die 'a directory requires --all'
    UPDATE_REPOSITORIES=("$(git rev-parse --show-toplevel 2> /dev/null)") ||
      _jgit_die 'not in a Git repository'
  fi

  for repo in "${UPDATE_REPOSITORIES[@]}"; do
    if _jgit_update_repository "${repo}" "${use_stash}"; then
      updated=$((updated + 1))
    else
      failed=$((failed + 1))
    fi
  done
  if ((update_all)); then
    [[ ${updated} == 1 ]] && noun=repository
    printf 'Updated %d %s; %d failed\n' "${updated}" "${noun}" "${failed}"
  fi
  ((failed == 0))
}

_jgit_heal() {
  local apply=0 git_dir fsck_output fsck_status=0 ref oid backup index failed=0
  local -a heal_refs=() heal_oids=() protected_refs=()
  while (($#)); do
    case $1 in
      --yes) apply=1 ;;
      -h | --help)
        printf '%s\n' \
          'Usage: jgit heal [--yes]' \
          '' \
          'Find broken refs. Codex turn-diff refs can be backed up and removed;' \
          'branches, tags, and other refs are reported but never changed.'
        return
        ;;
      *) _jgit_die "unknown heal option: $1" ;;
    esac
    shift
  done

  git_dir=$(git rev-parse --absolute-git-dir 2> /dev/null) || _jgit_die 'not in a Git repository'
  fsck_output=$(LC_ALL=C git fsck --connectivity-only --no-dangling --no-reflogs 2>&1) || fsck_status=$?
  while IFS=$'\t' read -r ref oid; do
    [[ -n ${ref} ]] || continue
    case ${ref} in
      refs/codex/turn-diffs/*)
        heal_refs+=("${ref}")
        heal_oids+=("${oid}")
        ;;
      *) protected_refs+=("${ref}") ;;
    esac
  done < <(printf '%s\n' "${fsck_output}" | awk '
    /^error: refs\/.*: invalid sha1 pointer [0-9a-f]+$/ {
      line = $0
      sub(/^error: /, "", line)
      ref = line
      sub(/: invalid sha1 pointer .*/, "", ref)
      oid = line
      sub(/.* invalid sha1 pointer /, "", oid)
      print ref "\t" oid
    }
  ')

  for ref in "${protected_refs[@]}"; do
    jsh::log_error "Broken protected ref requires manual recovery: ${ref}"
  done

  if ((${#heal_refs[@]} == 0)); then
    ((${#protected_refs[@]} > 0)) && return 1
    ((fsck_status == 0)) || {
      if git for-each-ref > /dev/null 2>&1; then
        jsh::log_success 'No broken refs found'
        jsh::log_warn 'git fsck found separate object corruption; run git fsck --full for details.'
        return 1
      fi
      printf '%s\n' "${fsck_output}" >&2
      _jgit_die 'unrecognized ref corruption; no changes made'
    }
    jsh::log_success 'No broken refs found'
    return
  fi

  if ((apply == 0)); then
    for ref in "${heal_refs[@]}"; do
      jsh_warn_stdout "Would remove ${ref}"
    done
    jsh::log_warn 'Run jgit heal --yes to back up and remove these refs.'
    return 1
  fi

  backup="${git_dir}/jgit-heal-refs.$(date +%Y%m%dT%H%M%S).$$.txt"
  umask 077
  for ((index = 0; index < ${#heal_refs[@]}; index++)); do
    printf '%s %s\n' "${heal_oids[index]}" "${heal_refs[index]}" >> "${backup}"
  done
  jsh::log_success "Backed up broken refs to ${backup}"

  for ((index = 0; index < ${#heal_refs[@]}; index++)); do
    ref=${heal_refs[index]}
    oid=${heal_oids[index]}
    if git update-ref -d "${ref}" "${oid}"; then
      jsh::log_success "Removed ${ref}"
    else
      jsh::log_error "Could not remove ${ref}"
      failed=$((failed + 1))
    fi
  done
  ((failed == 0 && ${#protected_refs[@]} == 0))
}

case ${1:-} in
  '') _jgit_dashboard ;;
  -h | --help) _jgit_usage ;;
  --version) printf 'jgit %s\n' "${JGIT_VERSION}" ;;
  __complete)
    case ${2:-} in
      profile) _jgit_profile_names | awk '{ print $0 "\tGit identity" }' ;;
      git-command) _jgit_git_commands ;;
    esac
    ;;
  identity)
    shift
    _jgit_identity_command "$@"
    ;;
  identities)
    shift
    _jgit_profile_list "$@"
    ;;
  profile)
    shift
    _jgit_profile_command "$@"
    ;;
  profiles)
    shift
    _jgit_profile_list "$@"
    ;;
  create)
    shift
    _jgit_create "$@"
    ;;
  commit)
    shift
    _jgit_commit "$@"
    ;;
  amend)
    shift
    _jgit_amend "$@"
    ;;
  rewrite)
    shift
    _jgit_rewrite "$@"
    ;;
  stash)
    shift
    _jgit_stash "$@"
    ;;
  __rewrite-sequence)
    shift
    _jgit_rewrite_sequence "$@"
    ;;
  __rewrite-restore)
    shift
    _jgit_rewrite_restore "$@"
    ;;
  update)
    shift
    _jgit_update "$@"
    ;;
  heal)
    shift
    _jgit_heal "$@"
    ;;
  save | backup)
    shift
    # shellcheck source=/dev/null
    . "${JSH_ROOT}/lib/backup.sh"
    _jgit_backup_save "$@"
    ;;
  load | restore)
    shift
    # shellcheck source=/dev/null
    . "${JSH_ROOT}/lib/backup.sh"
    _jgit_backup_load "$@"
    ;;
  *) exec git "$@" ;;
esac
