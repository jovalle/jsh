#!/usr/bin/env bash
##% jadopt
## PATH... ## Move selected home files into Jsh dotfiles and link them back

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR
if [[ -n "${JSH_DIR:-}" ]]; then
  JSH_ROOT=$(cd -- "${JSH_DIR}" && pwd -P)
else
  JSH_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd -P)
fi
readonly JSH_ROOT
readonly DOTFILES_DIR=${JSH_ROOT}/dotfiles
readonly LINK_COMMAND=${JADOPT_LINK_COMMAND:-ln}

# shellcheck source=../lib/ui.sh
source "${JSH_ROOT}/lib/ui.sh"
# shellcheck source=../lib/files.sh
source "${JSH_ROOT}/lib/files.sh"
jsh::init

ASSUME_YES=${JSH_ASSUME_YES:-0}
DRY_RUN=0
APPLYING=0
BACKUP_DIR=
RELATIVE_PATHS=()
PLAN_PATHS=()
PLAN_ACTIONS=()
MOVED_FROM=()
MOVED_TO=()
CREATED_LINKS=()

shopt -s dotglob nullglob

usage() {
  cat <<'EOF'
Usage: jsh adopt [--dry-run] [--yes] PATH...

Move selected home files into Jsh's shared dotfiles package and replace each
one with a managed symlink. Directories are adopted file by file and remain
real directories in the home directory.

When the repository already holds a different copy, a diff is shown and you
choose to adopt the home copy, override it with the Jsh copy, or skip it.

Options:
  -n, --dry-run  Show the adoption plan without changing files
  -y, --yes      Apply the plan without prompting; differing files are skipped
  -h, --help     Show this help
EOF
}

die() {
  jsh::log_error "$*"
  exit 1
}

canonical_path() {
  local input=$1 parent name

  [[ ${input} == /* ]] || input=${PWD}/${input}
  while [[ ${input} != / && ${input} == */ ]]; do
    input=${input%/}
  done

  parent=${input%/*}
  name=${input##*/}
  [[ -n ${parent} ]] || parent=/
  parent=$(cd -P -- "${parent}" 2>/dev/null && pwd -P) ||
    die "Parent directory does not exist: ${input%/*}"
  if [[ ${parent} == / ]]; then
    printf '/%s\n' "${name}"
  else
    printf '%s/%s\n' "${parent}" "${name}"
  fi
}

relative_link_target() {
  local destination=$1 origin=$2 index=0 cursor part
  local -a destination_parts=() origin_parts=() result=()

  IFS='/' read -r -a destination_parts <<<"${destination#/}"
  IFS='/' read -r -a origin_parts <<<"${origin#/}"
  while ((index < ${#destination_parts[@]} && index < ${#origin_parts[@]})) &&
    [[ ${destination_parts[index]} == "${origin_parts[index]}" ]]; do
    ((index += 1))
  done
  for ((cursor = index; cursor < ${#origin_parts[@]}; cursor++)); do
    result+=(..)
  done
  for ((cursor = index; cursor < ${#destination_parts[@]}; cursor++)); do
    part=${destination_parts[cursor]}
    result+=("${part}")
  done

  local IFS=/
  printf '%s\n' "${result[*]}"
}

already_adopted() {
  local source=$1 destination=$2
  [[ -L ${source} && -e ${destination} && ${source} -ef ${destination} ]]
}

# Queue every regular file below a selected path; directories stay in place.
collect_files() {
  local relative_path=$1 source=${HOME_ABS}/$1 child selected_path

  already_adopted "${source}" "${DOTFILES_DIR}/${relative_path}" && return 0
  if [[ -L ${source} ]]; then
    jsh::log_note "Skipping symbolic link: ${source}"
    return 0
  fi
  if [[ -d ${source} ]]; then
    for child in "${source}"/*; do
      collect_files "${relative_path}/${child##*/}"
    done
    return 0
  fi
  if [[ ! -f ${source} ]]; then
    jsh::log_note "Skipping special file: ${source}"
    return 0
  fi
  for selected_path in "${RELATIVE_PATHS[@]}"; do
    [[ ${selected_path} != "${relative_path}" ]] || return 0
  done
  RELATIVE_PATHS+=("${relative_path}")
}

plan_file() {
  local relative_path=$1 source=${HOME_ABS}/$1 destination=${DOTFILES_DIR}/$1 action=move

  if [[ -e ${destination} || -L ${destination} ]]; then
    [[ -f ${destination} && ! -L ${destination} ]] ||
      die "Repository destination is not a regular file: ${destination}"
    if cmp -s -- "${source}" "${destination}"; then
      action=replace
    elif ((DRY_RUN)); then
      action=conflict
    elif [[ ${ASSUME_YES} == 1 ]]; then
      action=skip
    else
      action=$(jsh_choose_conflict "${source}" "${destination}")
    fi
  fi
  if [[ ${action} == skip ]]; then
    jsh::log_warn "Skipping ${source}: it differs from ${destination}"
    return 0
  fi
  PLAN_PATHS+=("${relative_path}")
  PLAN_ACTIONS+=("${action}")
}

move_path() {
  mkdir -p -- "${2%/*}"
  mv -- "$1" "$2"
  MOVED_FROM+=("$1")
  MOVED_TO+=("$2")
}

# Replaced copies are held aside so a failed run can restore them.
set_aside() {
  if [[ -z ${BACKUP_DIR} ]]; then
    mkdir -p -- "${JSH_ROOT}/tmp"
    BACKUP_DIR=$(mktemp -d "${JSH_ROOT}/tmp/jadopt.XXXXXX")
  fi
  move_path "$1" "${BACKUP_DIR}/$2"
}

rollback() {
  local exit_status=$? index source destination failed=0
  trap - EXIT INT TERM
  ((APPLYING)) || exit "${exit_status}"

  jsh::log_warn "Adoption failed; restoring moved paths."
  for ((index = ${#CREATED_LINKS[@]} - 1; index >= 0; index--)); do
    [[ ! -L ${CREATED_LINKS[index]} ]] || rm -- "${CREATED_LINKS[index]}" || failed=1
  done
  for ((index = ${#MOVED_FROM[@]} - 1; index >= 0; index--)); do
    source=${MOVED_FROM[index]}
    destination=${MOVED_TO[index]}
    if [[ -e ${source} || -L ${source} ]]; then
      jsh::log_error "Cannot restore ${source}: the path was recreated during adoption"
      failed=1
      continue
    fi
    mkdir -p -- "${source%/*}" && mv -- "${destination}" "${source}" || failed=1
    destination=${destination%/*}
    while [[ ${destination} == "${DOTFILES_DIR}"/* ]] && rmdir -- "${destination}" 2> /dev/null; do
      destination=${destination%/*}
    done
  done
  if ((failed)); then
    jsh::log_error "Adoption recovery is incomplete${BACKUP_DIR:+; replaced files remain in ${BACKUP_DIR}}"
  elif [[ -n ${BACKUP_DIR} ]]; then
    rm -rf -- "${BACKUP_DIR}"
  fi
  exit "${exit_status}"
}

arguments=()
while (($#)); do
  case $1 in
    -n | --dry-run) DRY_RUN=1 ;;
    -y | --yes) ASSUME_YES=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      arguments+=("$@")
      break
      ;;
    -*) die "Unknown option: $1" ;;
    *) arguments+=("$1") ;;
  esac
  shift
done

((${#arguments[@]} > 0)) || {
  usage >&2
  exit 2
}

[[ -d ${DOTFILES_DIR} ]] || die "Dotfiles directory not found: ${DOTFILES_DIR}"
command -v "${LINK_COMMAND}" >/dev/null 2>&1 || die "Link command is unavailable: ${LINK_COMMAND}"
HOME_ABS=$(cd -P -- "${HOME}" 2>/dev/null && pwd -P) || die "Home directory is unavailable: ${HOME}"

for argument in "${arguments[@]}"; do
  source_path=$(canonical_path "${argument}")
  [[ -e ${source_path} || -L ${source_path} ]] || die "Path does not exist: ${argument}"

  case ${source_path} in
    "${HOME_ABS}") die "The home directory itself cannot be adopted" ;;
    "${HOME_ABS}"/*) ;;
    *) die "Path must be inside the home directory: ${argument}" ;;
  esac
  case ${source_path} in
    "${JSH_ROOT}" | "${JSH_ROOT}"/*) die "The Jsh repository cannot adopt itself: ${argument}" ;;
  esac

  relative_path=${source_path#"${HOME_ABS}"/}
  destination_path=${DOTFILES_DIR}/${relative_path}

  if already_adopted "${source_path}" "${destination_path}"; then
    jsh::log_note "Already adopted: ${source_path}"
    continue
  fi
  [[ ! -L ${source_path} ]] || die "Symbolic links cannot be adopted: ${argument}"
  collect_files "${relative_path}"
done

((${#RELATIVE_PATHS[@]} > 0)) || {
  jsh::log_success "All selected paths are already adopted"
  exit 0
}

for relative_path in "${RELATIVE_PATHS[@]}"; do
  plan_file "${relative_path}"
done

((${#PLAN_PATHS[@]} > 0)) || {
  jsh::log_note "Nothing to adopt."
  exit 0
}

jsh::log_info "Adoption plan:"
for ((index = 0; index < ${#PLAN_PATHS[@]}; index++)); do
  source_path=${HOME_ABS}/${PLAN_PATHS[index]}
  destination_path=${DOTFILES_DIR}/${PLAN_PATHS[index]}
  case ${PLAN_ACTIONS[index]} in
    move) jsh::log_detail "  Move: ${source_path} -> ${destination_path}" ;;
    replace) jsh::log_detail "  Link: ${source_path} (identical to ${destination_path})" ;;
    adopt) jsh::log_detail "  Adopt: ${source_path} replaces ${destination_path}" ;;
    override) jsh::log_detail "  Override: ${source_path} with ${destination_path}" ;;
    conflict) jsh::log_detail "  Conflict: ${source_path} differs from ${destination_path}" ;;
  esac
done

if ((DRY_RUN)); then
  jsh::log_success "Dry run complete; no files changed"
  exit 0
fi

if [[ ${ASSUME_YES} != 1 ]] && ! jsh::confirm 'Adopt these paths?' --default no; then
  jsh::log_note "Adoption cancelled."
  exit 0
fi

APPLYING=1
trap rollback EXIT
trap 'exit 130' INT TERM

for ((index = 0; index < ${#PLAN_PATHS[@]}; index++)); do
  relative_path=${PLAN_PATHS[index]}
  source_path=${HOME_ABS}/${relative_path}
  destination_path=${DOTFILES_DIR}/${relative_path}
  case ${PLAN_ACTIONS[index]} in
    move) move_path "${source_path}" "${destination_path}" ;;
    replace | override) set_aside "${source_path}" "home/${relative_path}" ;;
    adopt)
      set_aside "${destination_path}" "dotfiles/${relative_path}"
      move_path "${source_path}" "${destination_path}"
      ;;
  esac
  CREATED_LINKS+=("${source_path}")
  "${LINK_COMMAND}" -s -- "$(relative_link_target "${destination_path}" "${source_path%/*}")" "${source_path}"
done

APPLYING=0
trap - EXIT INT TERM
[[ -z ${BACKUP_DIR} ]] || rm -rf -- "${BACKUP_DIR}"
for relative_path in "${PLAN_PATHS[@]}"; do
  jsh::log_success "Linked ~/${relative_path}"
done
