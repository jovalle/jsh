#!/usr/bin/env python3
"""Keep AI agent clients (agy, Codex, OpenCode) in parity with conf/agents.json.

Shared MCP servers and skills are declared once and applied to every agent. Anything an agent
has configured that the config neither shares nor keeps is an extra, which can be removed, kept
for that agent only, or adopted into the shared config.
"""

import argparse
import datetime
import fnmatch
import json
import os
import re
import shutil
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
KINDS = ("mcp", "plugins", "skills", "agents", "commands")
SECRET = re.compile(r"TOKEN|KEY|SECRET|PASS|AUTH|COOKIE|CREDENTIAL", re.IGNORECASE)
ENV_REF = re.compile(r"\$\{env:([A-Za-z_][A-Za-z0-9_]*)\}")
COMMAND_MARK = "<!-- jagents: generated -->"


class Failure(Exception):
    """A reconciliation step that could not be completed safely."""


def home():
    return Path(os.environ.get("HOME", str(Path.home())))


def expand(path):
    path = str(path)
    if path.startswith("~/"):
        return home() / path[2:]
    return Path(path) if os.path.isabs(path) else ROOT / path


def config_path():
    return Path(os.environ.get("JSH_AGENTS_CONFIG", ROOT / "conf/agents.json"))


def load_config():
    return json.loads(config_path().read_text(encoding="utf-8"))


def format_json(value, indent=0):
    """Pretty-print JSON, keeping short scalar arrays on one line like Prettier does."""
    pad = " " * indent
    inner = " " * (indent + 2)
    if isinstance(value, dict):
        if not value:
            return "{}"
        items = [
            f"{inner}{json.dumps(key)}: {format_json(item, indent + 2)}"
            for key, item in value.items()
        ]
        return "{\n" + ",\n".join(items) + f"\n{pad}}}"
    if isinstance(value, list):
        flat = json.dumps(value, ensure_ascii=False)
        scalar = all(not isinstance(item, (dict, list)) for item in value)
        if scalar and len(pad) + len(flat) <= 100:
            return flat
        items = [f"{inner}{format_json(item, indent + 2)}" for item in value]
        return "[\n" + ",\n".join(items) + f"\n{pad}]"
    return json.dumps(value, ensure_ascii=False)


def save_config(config):
    config_path().write_text(format_json(config) + "\n", encoding="utf-8")


def agent_enabled(agent):
    platform = {"darwin": "darwin", "linux": "linux"}.get(sys.platform, "other")
    return "inventory" in agent and platform in agent.get("os", [platform])


def matches(name, patterns):
    return any(fnmatch.fnmatchcase(name, pattern) for pattern in patterns)


def shared_for(config, agent_id):
    return {
        name: server
        for name, server in config.get("mcp", {}).items()
        if agent_id in server.get("agents", [agent_id])
    }


def shared_skills(config):
    source = config.get("skills", {}).get("source")
    if not source or not expand(source).is_dir():
        return {}
    skills = {}
    for entry in sorted(expand(source).iterdir()):
        manifest = entry / "SKILL.md"
        if manifest.is_file():
            skills[entry.name] = manifest
    return skills


def user_only(manifest):
    text = manifest.read_text(encoding="utf-8", errors="replace")
    match = re.match(r"---\n(.*?)\n---", text, re.DOTALL)
    return bool(
        match
        and re.search(r"^disable-model-invocation:\s*(true|yes|1)\s*$", match.group(1), re.M)
    )


# Native config formats --------------------------------------------------------------------


def read_json(path):
    if not path.exists():
        return {}
    text = path.read_text(encoding="utf-8")
    return json.loads(text) if text.strip() else {}


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def opencode_servers(data):
    mcp = data.get("mcp", {})
    if isinstance(mcp.get("servers"), dict):
        return mcp["servers"]
    return {key: value for key, value in mcp.items() if key not in ("servers", "timeout")}


def toml_key(key):
    return key if re.fullmatch(r"[A-Za-z0-9_-]+", key) else json.dumps(key)


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    if isinstance(value, dict):
        pairs = ", ".join(f"{toml_key(k)} = {toml_value(v)}" for k, v in value.items())
        return "{ " + pairs + " }" if pairs else "{}"
    raise Failure(f"cannot write {value!r} as TOML")


def header_path(line):
    """Return the dotted key path of a TOML table header line, or None."""
    match = re.match(r"\s*\[\[?\s*(.+?)\s*\]\]?\s*(#.*)?$", line)
    if not match:
        return None
    parts, current, quote = [], "", None
    for char in match.group(1):
        if quote:
            if char == quote:
                quote = None
            else:
                current += char
        elif char in "\"'":
            quote = char
        elif char == ".":
            parts.append(current.strip())
            current = ""
        else:
            current += char
    parts.append(current.strip())
    return parts


def codex_remove(path, table, name):
    """Delete [table.name] and its subtables, verifying nothing else changed."""
    text = path.read_text(encoding="utf-8")
    before = tomllib.loads(text)
    kept, skipping = [], False
    for line in text.splitlines(keepends=True):
        parts = header_path(line)
        if parts is not None:
            skipping = parts[:2] == [table, name]
        if not skipping:
            kept.append(line)
    updated = re.sub(r"\n{3,}", "\n\n", "".join(kept))
    after = tomllib.loads(updated)
    expected = json.loads(json.dumps(before))
    expected.get(table, {}).pop(name, None)
    if not expected.get(table) and table not in after:
        expected.pop(table, None)
    if json.loads(json.dumps(after)) != expected:
        raise Failure(f"{path}: could not remove {table}.{name} cleanly; edit it by hand")
    path.write_text(updated, encoding="utf-8")


def codex_add(path, name, entry):
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    lines = [f"[mcp_servers.{toml_key(name)}]"]
    lines += [f"{toml_key(k)} = {toml_value(v)}" for k, v in entry.items()]
    updated = text.rstrip("\n") + ("\n\n" if text.strip() else "") + "\n".join(lines) + "\n"
    if tomllib.loads(updated).get("mcp_servers", {}).get(name) != entry:
        raise Failure(f"{path}: could not add mcp_servers.{name} cleanly")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(updated, encoding="utf-8")


def env_name(value):
    match = ENV_REF.fullmatch(value) if isinstance(value, str) else None
    return match.group(1) if match else None


def resolve(value):
    def lookup(match):
        if match.group(1) not in os.environ:
            raise Failure(f"${{env:{match.group(1)}}} is not set")
        return os.environ[match.group(1)]

    return ENV_REF.sub(lookup, value)


def render_codex(server):
    env, headers = server.get("env", {}), server.get("headers", {})
    entry = {}
    if "url" in server:
        entry["url"] = server["url"]
        literal = {k: v for k, v in headers.items() if not ENV_REF.search(v)}
        for key, value in headers.items():
            bearer = re.fullmatch(r"Bearer \$\{env:(\w+)\}", value)
            if key.lower() == "authorization" and bearer:
                entry["bearer_token_env_var"] = bearer.group(1)
            elif env_name(value):
                entry.setdefault("env_http_headers", {})[key] = env_name(value)
            elif key not in literal:
                raise Failure(f"Codex cannot reference {key} = {value}")
        if literal:
            entry["http_headers"] = literal
    else:
        entry["command"] = server["command"][0]
        entry["args"] = server["command"][1:]
        forwarded = [k for k, v in env.items() if env_name(v) == k]
        literal = {k: v for k, v in env.items() if not ENV_REF.search(v)}
        if len(forwarded) + len(literal) != len(env):
            raise Failure("Codex forwards environment variables only under the same name")
        if forwarded:
            entry["env_vars"] = forwarded
        if literal:
            entry["env"] = literal
    if server.get("enabled") is False:
        entry["enabled"] = False
    return entry


def render_opencode(server):
    def convert(values):
        return {key: ENV_REF.sub(r"{env:\1}", value) for key, value in values.items()}

    if "url" in server:
        entry = {"type": "remote", "url": server["url"]}
        if server.get("headers"):
            entry["headers"] = convert(server["headers"])
    else:
        entry = {"type": "local", "command": list(server["command"])}
        if server.get("env"):
            entry["environment"] = convert(server["env"])
    entry["enabled"] = server.get("enabled", True)
    return entry


def render_agy(server):
    # Antigravity cannot reference variables, so values are resolved when they are written.
    if "url" in server:
        entry = {"serverUrl": server["url"]}
        if server.get("headers"):
            entry["headers"] = {k: resolve(v) for k, v in server["headers"].items()}
    else:
        entry = {"command": server["command"][0], "args": server["command"][1:]}
        if server.get("env"):
            entry["env"] = {k: resolve(v) for k, v in server["env"].items()}
    entry["disabled"] = server.get("enabled", True) is False
    return entry


def render(server, fmt):
    """Translate a shared server definition into one agent's native entry."""
    renderers = {"codex": render_codex, "opencode": render_opencode, "agy": render_agy}
    if fmt not in renderers:
        raise Failure(f"unknown MCP format {fmt}")
    return renderers[fmt](server)


def to_shared(entry, fmt):
    """Translate a native MCP entry into the shared format, swapping secrets for env references."""

    def protect(values):
        return {
            key: (f"${{env:{key}}}" if SECRET.search(key) and value else value)
            for key, value in values.items()
        }

    if fmt == "codex":
        server = {"url": entry["url"]} if "url" in entry else {}
        if not server:
            server["command"] = [entry["command"], *entry.get("args", [])]
            env = protect(entry.get("env", {}))
            env.update({name: f"${{env:{name}}}" for name in entry.get("env_vars", [])})
            if env:
                server["env"] = env
        headers = {
            "Authorization": "Bearer ${env:" + entry["bearer_token_env_var"] + "}"
        } if entry.get("bearer_token_env_var") else {}
        headers.update(
            {k: "${env:" + v + "}" for k, v in entry.get("env_http_headers", {}).items()}
        )
        headers.update(protect(entry.get("http_headers", {})))
        enabled = entry.get("enabled", True)
    elif fmt == "opencode":
        if entry.get("type") == "remote":
            server = {"url": entry["url"]}
        else:
            command = entry.get("command", [])
            server = {"command": command if isinstance(command, list) else [command]}
        env = {
            k: re.sub(r"\{env:(\w+)\}", r"${env:\1}", v)
            for k, v in protect(entry.get("environment", {})).items()
        }
        if env:
            server["env"] = env
        headers = {
            k: re.sub(r"\{env:(\w+)\}", r"${env:\1}", v)
            for k, v in protect(entry.get("headers", {})).items()
        }
        enabled = entry.get("enabled", True)
    else:
        url = entry.get("serverUrl") or entry.get("url") or entry.get("httpUrl")
        server = {"url": url} if url else {
            "command": [entry["command"], *entry.get("args", [])]
        }
        if entry.get("env"):
            server["env"] = protect(entry["env"])
        headers = protect(entry.get("headers", {}))
        enabled = not entry.get("disabled", False)
    if headers and "url" in server:
        server["headers"] = headers
    if not enabled:
        server["enabled"] = False
    return server


# Inventory --------------------------------------------------------------------------------


def native_mcp(source):
    path, fmt = expand(source["path"]), source["format"]
    if not path.exists():
        return {}
    if fmt == "codex":
        return tomllib.loads(path.read_text(encoding="utf-8")).get("mcp_servers", {})
    if fmt == "opencode":
        return opencode_servers(read_json(path))
    return read_json(path).get("mcpServers", {})


def native_plugins(source):
    if isinstance(source, str):
        return directory_items(source)
    path, fmt = expand(source["path"]), source["format"]
    if not path.exists():
        return {}
    if fmt == "codex":
        plugins = tomllib.loads(path.read_text(encoding="utf-8")).get("plugins", {})
        return {name: source for name in plugins}
    specs = read_json(path).get("plugin", [])
    return {(spec[0] if isinstance(spec, list) else spec): source for spec in specs}


def directory_items(directory):
    path = expand(directory)
    if not path.is_dir():
        return {}
    items = {}
    for entry in sorted(path.iterdir()):
        if entry.name.startswith(".") or entry.name in ("node_modules", "README.md"):
            continue
        items[entry.stem if entry.is_file() else entry.name] = str(entry)
    return items


def inventory(agent, kind):
    """Map each configured item name to where it lives."""
    sources = agent["inventory"].get(kind, [])
    sources = sources if isinstance(sources, list) else [sources]
    found = {}
    for source in sources:
        if kind == "mcp":
            found.update({name: source for name in native_mcp(source)})
        elif kind == "plugins":
            found.update(native_plugins(source))
        else:
            found.update(directory_items(source))
    return found


def declared(config, agent, kind):
    kept = agent.get("keep", {}).get(kind, [])
    if kind == "mcp":
        return set(shared_for(config, agent["id"])), kept
    if kind == "skills":
        # Every agent already reads the shared skill folder, so per-agent copies only shadow it.
        return set(), kept
    if kind == "commands" and agent["inventory"].get("skill_commands"):
        names = {name for name, manifest in shared_skills(config).items() if user_only(manifest)}
        return names, kept
    return set(), kept


def extras(config):
    found = []
    for agent in config["agents"]:
        if not agent_enabled(agent):
            continue
        for kind in KINDS:
            names, kept = declared(config, agent, kind)
            for name, location in inventory(agent, kind).items():
                if name not in names and not matches(name, kept):
                    found.append((f"{agent['id']}:{kind}:{name}", agent, kind, name, location))
    shared = config.get("skills", {})
    if shared.get("path"):
        names, kept = set(shared_skills(config)), shared.get("keep", [])
        for name, location in directory_items(shared["path"]).items():
            if name not in names and not matches(name, kept):
                found.append((f"shared:skills:{name}", None, "skills", name, location))
    return found


def find(config, item_id):
    for item in extras(config):
        if item[0] == item_id:
            return item
    raise Failure(f"{item_id} is not an extra; run `jagents extras` to list them")


# Actions ----------------------------------------------------------------------------------


def backup(location, agent_id, kind):
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    state = Path(os.environ.get("XDG_STATE_HOME") or home() / ".local/state")
    target = state / "jsh/agents" / stamp / agent_id / kind / Path(location).name
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(location, target)
    return target


def remove(config, item_id, dry_run):
    _, agent, kind, name, location = find(config, item_id)
    agent_id = agent["id"] if agent else "shared"
    if dry_run:
        return f"would remove {item_id}"
    if isinstance(location, dict):
        path, fmt = expand(location["path"]), location["format"]
        if fmt == "codex":
            codex_remove(path, "mcp_servers" if kind == "mcp" else "plugins", name)
        elif fmt == "opencode" and kind == "mcp":
            data = read_json(path)
            opencode_servers(data).pop(name, None)
            if name in data.get("mcp", {}):
                data["mcp"].pop(name)
            write_json(path, data)
        elif fmt == "opencode":
            data = read_json(path)
            data["plugin"] = [
                spec for spec in data.get("plugin", [])
                if (spec[0] if isinstance(spec, list) else spec) != name
            ]
            write_json(path, data)
        else:
            data = read_json(path)
            data.get("mcpServers", {}).pop(name, None)
            write_json(path, data)
        return f"removed {item_id} from {path}"
    path = Path(location)
    if path.is_symlink():
        target = os.readlink(path)
        path.unlink()
        return f"removed {item_id} (link to {target})"
    return f"moved {item_id} to {backup(path, agent_id, kind)}"


def keep_item(config, item_id, dry_run):
    _, agent, kind, name, _ = find(config, item_id)
    target = agent.setdefault("keep", {}) if agent else config.setdefault("skills", {})
    names = target.setdefault(kind, []) if agent else target.setdefault("keep", [])
    if name not in names:
        names.append(name)
        names.sort()
    if not dry_run:
        save_config(config)
    return f"{'would keep' if dry_run else 'kept'} {item_id} in conf/agents.json"


def adopt(config, item_id, dry_run):
    """Share an extra with every agent: MCP servers join `mcp`, skills join the skill source."""
    _, agent, kind, name, location = find(config, item_id)
    if kind == "mcp":
        server = to_shared(native_mcp(location)[name], location["format"])
        config.setdefault("mcp", {})[name] = server
        refs = sorted(set(ENV_REF.findall(json.dumps(server))))
        if not dry_run:
            save_config(config)
        note = f"; export {', '.join(refs)} for every agent" if refs else ""
        return f"{'would adopt' if dry_run else 'adopted'} {item_id} into shared mcp{note}"
    path = Path(location) if isinstance(location, str) else None
    if kind == "skills" and path and path.is_dir() and not path.is_symlink():
        target = expand(config["skills"]["source"]) / name
        if target.exists():
            raise Failure(f"{target} already exists")
        if dry_run:
            return f"would copy {path} to {target} and share it"
        shutil.copytree(path, target)
        backup(path, agent["id"] if agent else "shared", kind)
        return f"adopted {item_id} into {target}; run `make deploy` to link it for every agent"
    return keep_item(config, item_id, dry_run)


def add_server(source, name, entry):
    path, fmt = expand(source["path"]), source["format"]
    if fmt == "codex":
        codex_add(path, name, entry)
        return
    data = read_json(path)
    if fmt == "opencode":
        mcp = data.setdefault("mcp", {})
        (mcp["servers"] if isinstance(mcp.get("servers"), dict) else mcp)[name] = entry
    else:
        data.setdefault("mcpServers", {})[name] = entry
    write_json(path, data)


def apply_servers(config, agent, dry_run):
    messages = []
    for source in agent["inventory"].get("mcp", []):
        present = native_mcp(source)
        for name, server in shared_for(config, agent["id"]).items():
            if name in present:
                continue
            try:
                entry = render(server, source["format"])
            except Failure as error:
                messages.append(("issue", f"{agent['name']}: cannot add {name}: {error}"))
                continue
            if not dry_run:
                add_server(source, name, entry)
            verb = "would add" if dry_run else "added"
            messages.append(("fixed", f"{agent['name']}: {verb} MCP server {name}"))
    return messages


def apply_commands(config, agent, dry_run):
    """Expose user-only shared skills as slash commands where the agent hides them."""
    messages = []
    directory = agent["inventory"].get("skill_commands")
    if not directory:
        return messages
    for name, manifest in shared_skills(config).items():
        if not user_only(manifest):
            continue
        target = expand(directory) / f"{name}.md"
        body = (
            f"---\ndescription: Run the {name} skill\n---\n{COMMAND_MARK}\n"
            f"Read `{home() / '.agents/skills' / name / 'SKILL.md'}` and follow it.\n\n"
            "$ARGUMENTS\n"
        )
        current = target.read_text(encoding="utf-8") if target.exists() else None
        if current is not None and COMMAND_MARK not in current:
            messages.append(("issue", f"{agent['name']}: {target} is not managed"))
            continue
        if current == body:
            continue
        if not dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(body, encoding="utf-8")
        verb = "would add" if dry_run else "added"
        messages.append(("fixed", f"{agent['name']}: {verb} /{name} command"))
    return messages


def apply(config, dry_run):
    """Add missing shared MCP servers and commands for user-only shared skills."""
    messages = []
    for agent in config["agents"]:
        if agent_enabled(agent):
            messages += apply_servers(config, agent, dry_run)
            messages += apply_commands(config, agent, dry_run)
    return messages


# CLI --------------------------------------------------------------------------------------


def print_extras(config, tsv):
    rows = [
        (item_id, kind, where["path"] if isinstance(where, dict) else where)
        for item_id, _, kind, _, where in extras(config)
    ]
    if tsv:
        for row in rows:
            print("\t".join(row))
        return
    if not rows:
        print("Every configured agent item is declared in conf/agents.json.")
        return
    print("Configured but not declared in conf/agents.json:")
    for item_id, _, detail in rows:
        print(f"  {item_id:<48} {detail}")
    print("\nUse `jagents remove|keep|adopt ID...` or `make configure JSH_SCOPE=agents`.")


def reconcile(command, ids, dry_run):
    handler = {"remove": remove, "keep": keep_item, "adopt": adopt}[command]
    status = 0
    for item_id in ids:
        try:
            print(handler(load_config(), item_id, dry_run))
        except (Failure, OSError, KeyError) as error:
            print(f"jagents: {item_id}: {error}", file=sys.stderr)
            status = 1
    return status


def main(argv=None):
    parser = argparse.ArgumentParser(prog="jagents", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command")
    apply_parser = commands.add_parser("apply", help="add shared MCP servers and skill commands")
    apply_parser.add_argument("--dry-run", action="store_true")
    extras_parser = commands.add_parser("extras", help="list items not in conf/agents.json")
    extras_parser.add_argument("--tsv", action="store_true", help="print id, kind, and location")
    for name, help_text in (
        ("remove", "remove extras from their agent"),
        ("keep", "keep extras for their agent only"),
        ("adopt", "share extras with every agent"),
    ):
        action = commands.add_parser(name, help=help_text)
        action.add_argument("ids", nargs="+", metavar="ID")
        action.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)

    try:
        if args.command in ("remove", "keep", "adopt"):
            return reconcile(args.command, args.ids, args.dry_run)
        config = load_config()
        if args.command == "apply":
            for kind, message in apply(config, args.dry_run):
                print(f"{kind}\t{message}")
        else:
            print_extras(config, getattr(args, "tsv", False))
    except (Failure, OSError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"jagents: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
