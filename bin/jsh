#!/usr/bin/env bash

set -o pipefail

_jsh_resolve_script() {
  local source_path="${BASH_SOURCE[0]}" source_dir link_target
  while [[ -L "${source_path}" ]]; do
    source_dir=$(cd -P "$(dirname "${source_path}")" && pwd) || return 1
    link_target=$(readlink "${source_path}") || return 1
    case "${link_target}" in
      /*) source_path="${link_target}" ;;
      *) source_path="${source_dir}/${link_target}" ;;
    esac
  done
  REPLY=$(cd -P "$(dirname "${source_path}")" && pwd) || return 1
}

_jsh_resolve_script || exit 2
export JSH_DIR="${JSH_DIR:-$(cd "${REPLY}/.." && pwd -P)}"
JSH_STATE_DIR="${JSH_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/jsh}"
JSH_LINK_STATE="${JSH_LINK_STATE:-${JSH_STATE_DIR}/managed-links}"
JSH_MODE_FILE="${JSH_MODE_FILE:-${JSH_STATE_DIR}/mode}"

_jsh_ui_init() {
  local enabled=0
  if [[ "${JSH_PLAIN_OUTPUT:-0}" != 1 && "${TERM:-dumb}" != dumb && -z ${NO_COLOR+x} ]]; then
    case "${JSH_COLOR:-auto}" in
      always) enabled=1 ;;
      auto) [[ -t 1 ]] && enabled=1 ;;
    esac
  fi

  if [[ "${enabled}" == 1 ]]; then
    _JSH_UI_RICH=1
    _JSH_UI_RESET=$'\033[0m'
    _JSH_UI_BOLD=$'\033[1m'
    case "${COLORTERM:-}:${TERM:-}" in
      *truecolor* | *24bit* | *direct*)
        _JSH_UI_DIM=$'\033[38;2;139;148;158m'
        _JSH_UI_RED=$'\033[38;2;255;82;99m'
        _JSH_UI_GREEN=$'\033[38;2;0;208;132m'
        _JSH_UI_YELLOW=$'\033[38;2;255;233;0m'
        _JSH_UI_CYAN=$'\033[38;2;0;183;255m'
        _JSH_UI_ACCENT=$'\033[38;2;0;168;232m'
        _JSH_UI_GIT=$'\033[38;2;240;80;50m'
        ;;
      *256color*)
        _JSH_UI_DIM=$'\033[38;5;247m'
        _JSH_UI_RED=$'\033[38;5;203m'
        _JSH_UI_GREEN=$'\033[38;5;42m'
        _JSH_UI_YELLOW=$'\033[38;5;226m'
        _JSH_UI_CYAN=$'\033[38;5;39m'
        _JSH_UI_ACCENT=$'\033[38;5;38m'
        _JSH_UI_GIT=$'\033[38;5;202m'
        ;;
      *)
        _JSH_UI_DIM=$'\033[90m'
        _JSH_UI_RED=$'\033[31m'
        _JSH_UI_GREEN=$'\033[32m'
        _JSH_UI_YELLOW=$'\033[33m'
        _JSH_UI_CYAN=$'\033[34m'
        _JSH_UI_ACCENT=$'\033[36m'
        _JSH_UI_GIT=$'\033[31m'
        ;;
    esac
  else
    _JSH_UI_RICH=0
    _JSH_UI_RESET=''
    _JSH_UI_BOLD=''
    _JSH_UI_DIM=''
    _JSH_UI_RED=''
    _JSH_UI_GREEN=''
    _JSH_UI_YELLOW=''
    _JSH_UI_CYAN=''
    _JSH_UI_ACCENT=''
    _JSH_UI_GIT=''
  fi
}

_jsh_ui_status() {
  local status="$1"
  case "${status}" in
    current | linked | pruned | removed | success)
      REPLY_COLOR=${_JSH_UI_GREEN}
      [[ "${_JSH_UI_RICH}" == 1 ]] && REPLY_MARK='✔' || REPLY_MARK=ok
      ;;
    plan)
      REPLY_COLOR=${_JSH_UI_CYAN}
      [[ "${_JSH_UI_RICH}" == 1 ]] && REPLY_MARK='➜' || REPLY_MARK=plan
      ;;
    changed | retained | warning)
      REPLY_COLOR=${_JSH_UI_YELLOW}
      [[ "${_JSH_UI_RICH}" == 1 ]] && REPLY_MARK='▲' || REPLY_MARK=warn
      ;;
    note)
      REPLY_COLOR=${_JSH_UI_CYAN}
      [[ "${_JSH_UI_RICH}" == 1 ]] && REPLY_MARK='›' || REPLY_MARK=note
      ;;
    info)
      REPLY_COLOR=${_JSH_UI_DIM}
      [[ "${_JSH_UI_RICH}" == 1 ]] && REPLY_MARK='•' || REPLY_MARK=info
      ;;
    error | missing | failed)
      REPLY_COLOR=${_JSH_UI_RED}
      [[ "${_JSH_UI_RICH}" == 1 ]] && REPLY_MARK='✖' || REPLY_MARK=error
      ;;
    *)
      REPLY_COLOR=${_JSH_UI_DIM}
      REPLY_MARK=${status}
      ;;
  esac
}

_jsh_ui_text() {
  REPLY_TEXT="$1"
  [[ -z "${HOME:-}" ]] || REPLY_TEXT=${REPLY_TEXT//"${HOME}"/\~}
}

_jsh_ui_path() {
  _jsh_ui_text "$1"
  [[ "${REPLY_TEXT}" != *[[:space:]]* ]] || printf -v REPLY_TEXT '"%s"' "${REPLY_TEXT}"
}

_jsh_ui_heading() {
  local separator='\n'
  [[ "${2:-}" != after-banner ]] || separator=
  _jsh_ui_init
  printf '%b%s%s%s%s\n' "${separator}" "${_JSH_UI_BOLD}" "${_JSH_UI_CYAN}" "$1" "${_JSH_UI_RESET}"
}

_jsh_ui_row() {
  local status="$1" key="$2" value="${3:-}" value_style="${4:-}"
  local columns row_width value_reset=
  _jsh_ui_init
  _jsh_ui_status "${status}"
  _jsh_ui_text "${key}"
  key=${REPLY_TEXT}
  _jsh_ui_text "${value}"
  value=${REPLY_TEXT}
  [[ "${_JSH_UI_RICH}" == 1 ]] || REPLY_MARK="[${REPLY_MARK}]"
  if [[ "${value_style}" == muted && "${_JSH_UI_RICH}" == 1 ]]; then
    value_style=${_JSH_UI_DIM}
    value_reset=${_JSH_UI_RESET}
  else
    value_style=
  fi

  if [[ -z "${value}" ]]; then
    printf '%s%s%s %s\n' "${REPLY_COLOR}" "${REPLY_MARK}" "${_JSH_UI_RESET}" "${key}"
    return
  fi

  columns=${COLUMNS:-80}
  [[ "${columns}" =~ ^[0-9]+$ ]] || columns=80
  row_width=$((${#REPLY_MARK} + ${#key} + ${#value} + 2))
  if ((columns >= 30 && row_width > columns)); then
    printf '%s%s%s %s\n' "${REPLY_COLOR}" "${REPLY_MARK}" "${_JSH_UI_RESET}" "${key}"
    printf '  %s%s%s\n' "${value_style}" "${value}" "${value_reset}"
  else
    printf '%s%s%s %s %s%s%s\n' \
      "${REPLY_COLOR}" "${REPLY_MARK}" "${_JSH_UI_RESET}" "${key}" \
      "${value_style}" "${value}" "${value_reset}"
  fi
}

_jsh_message() {
  _jsh_ui_row "$1" "$2"
}

_jsh_error() {
  local message="$1"
  _jsh_ui_init
  _jsh_ui_status error
  _jsh_ui_text "${message}"
  message=${REPLY_TEXT}
  if [[ "${_JSH_UI_RICH}" == 1 ]]; then
    printf '%s%s%s jsh: %s\n' "${REPLY_COLOR}" "${REPLY_MARK}" "${_JSH_UI_RESET}" "${message}" >&2
  else
    printf '[%s] jsh: %s\n' "${REPLY_MARK}" "${message}" >&2
  fi
}

_jsh_runtime_shell() {
  if command -v zsh >/dev/null 2>&1; then
    printf 'zsh\n'
  else
    command -v bash >/dev/null 2>&1 || {
      _jsh_error 'Bash or Zsh is required for runtime mode'
      return 1
    }
    printf 'bash\n'
  fi
}

_jsh_prepare_runtime_environment() {
  local git_config include_path shellcheck_config

  if [[ -z ${JSH_RUNTIME_CONFIG_DIR+x} ]]; then
    export JSH_RUNTIME_CONFIG_DIR="${JSH_DIR}/local/runtime"
  fi
  if [[ -z ${RIPGREP_CONFIG_PATH+x} ]]; then
    export RIPGREP_CONFIG_PATH="${JSH_DIR}/dotfiles/.ripgreprc"
  fi
  if [[ -z ${INPUTRC+x} ]]; then
    export INPUTRC="${JSH_DIR}/dotfiles/.inputrc"
  fi
  if [[ -z ${VIMINIT+x} ]]; then
    export VIMINIT='execute "source " . fnameescape($JSH_DIR . "/dotfiles/.vimrc")'
  fi

  if [[ -n ${JSH_RUNTIME_CONFIG_DIR} ]] \
    && mkdir -p "${JSH_RUNTIME_CONFIG_DIR}" 2>/dev/null; then
    shellcheck_config="${JSH_RUNTIME_CONFIG_DIR}/shellcheckrc"
    if [[ ! -e ${shellcheck_config} && ! -L ${shellcheck_config} ]]; then
      ln -s "${JSH_DIR}/dotfiles/.shellcheckrc" \
        "${shellcheck_config}" 2>/dev/null || true
    fi
  fi

  [[ -z ${GIT_CONFIG_GLOBAL+x} && -n ${JSH_RUNTIME_CONFIG_DIR} ]] || return 0
  command -v git >/dev/null 2>&1 || return 0
  [[ -d ${JSH_RUNTIME_CONFIG_DIR} ]] || return 0

  git_config="${JSH_RUNTIME_CONFIG_DIR}/gitconfig"
  if [[ ! -s ${git_config} && ! -L ${git_config} ]]; then
    git config --file "${git_config}" include.path \
      "${JSH_DIR}/dotfiles/.gitconfig" >/dev/null 2>&1 || return 0
  fi
  while IFS= read -r include_path; do
    if [[ ${include_path} == "${JSH_DIR}/dotfiles/.gitconfig" ]]; then
      export GIT_CONFIG_GLOBAL="${git_config}"
      return 0
    fi
  done < <(git config --file "${git_config}" --get-all include.path 2>/dev/null)
}

_jsh_launch_runtime() {
  local login=0 runtime_shell
  [[ "${1:-}" != -l ]] || {
    login=1
    shift
  }
  (($# == 0)) || {
    _jsh_error 'Usage: jsh shell [-l]'
    return 2
  }
  [[ "${JSH_RUNTIME_ACTIVE:-0}" != 1 ]] || {
    usage
    return 0
  }
  _jsh_prepare_runtime_environment
  runtime_shell=$(_jsh_runtime_shell) || return 1
  if [[ "${runtime_shell}" == zsh && "${login}" == 1 ]]; then
    exec env JSH_RUNTIME_ACTIVE=1 JSH_MODE=runtime JSH_DIR="${JSH_DIR}" \
      JSH_SHELL=zsh ZDOTDIR="${JSH_DIR}/dotfiles" zsh -d -l -i
  elif [[ "${runtime_shell}" == zsh ]]; then
    exec env JSH_RUNTIME_ACTIVE=1 JSH_MODE=runtime JSH_DIR="${JSH_DIR}" \
      JSH_SHELL=zsh ZDOTDIR="${JSH_DIR}/dotfiles" zsh -d -i
  fi
  exec env JSH_RUNTIME_ACTIVE=1 JSH_MODE=runtime JSH_DIR="${JSH_DIR}" \
    JSH_SHELL=bash bash --rcfile "${JSH_DIR}/dotfiles/.bashrc" -i
}

_jsh_run_command() {
  local command_text="${1:-}" runtime_shell
  [[ -n "${command_text}" ]] || {
    _jsh_error 'Usage: jsh -c <command> [args...]'
    return 2
  }
  shift
  _jsh_prepare_runtime_environment
  runtime_shell=$(_jsh_runtime_shell) || return 1
  if [[ "${runtime_shell}" == zsh ]]; then
    exec env JSH_RUNTIME_ACTIVE=1 JSH_MODE=runtime JSH_DIR="${JSH_DIR}" \
      JSH_SHELL=zsh ZDOTDIR="${JSH_DIR}/dotfiles" zsh -d -i -c "${command_text}" jsh "$@"
  fi
  exec env JSH_RUNTIME_ACTIVE=1 JSH_MODE=runtime JSH_DIR="${JSH_DIR}" \
    JSH_SHELL=bash bash --rcfile "${JSH_DIR}/dotfiles/.bashrc" -i -c "${command_text}" jsh "$@"
}

_jsh_vscode_user_dir() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) printf '%s\n' "${HOME}/Library/Application Support/Code/User" ;;
    *) printf '%s\n' "${XDG_CONFIG_HOME:-${HOME}/.config}/Code/User" ;;
  esac
}

_jsh_install_entries() {
  local relative source child destination
  for relative in .zshrc .bashrc .bash_profile .gitconfig .inputrc .tmux.conf \
    .vimrc .editorconfig .shellcheckrc .markdownlint.jsonc .prettierrc.json \
    .czrc .ripgreprc; do
    source="${JSH_DIR}/dotfiles/${relative}"
    [[ -e "${source}" ]] && printf '%s|%s\n' "${source}" "${HOME}/${relative}"
  done

  source="${JSH_DIR}/dotfiles/.config"
  if [[ -d "${source}" ]]; then
    for child in "${source}"/*; do
      [[ -e "${child}" ]] || continue
      printf '%s|%s\n' "${child}" "${XDG_CONFIG_HOME:-${HOME}/.config}/${child##*/}"
    done
  fi

  source="${JSH_DIR}/dotfiles/.vscode/user"
  destination=$(_jsh_vscode_user_dir)
  if [[ -d "${source}" ]]; then
    for child in "${source}"/*; do
      [[ -e "${child}" ]] || continue
      [[ "${child##*/}" != prompts ]] || continue
      printf '%s|%s\n' "${child}" "${destination}/${child##*/}"
    done
  fi

  source="${JSH_DIR}/dotfiles/.agents/agents"
  if [[ -d "${source}" ]]; then
    printf '%s|%s\n' "${source}" "${HOME}/.agents/agents"
    printf '%s|%s\n' "${source}" "${HOME}/.copilot/agents"
    printf '%s|%s\n' "${source}" "${HOME}/.codex/agents"
  fi

  source="${JSH_DIR}/dotfiles/.codex/AGENTS.md"
  [[ -e "${source}" ]] && printf '%s|%s\n' "${source}" "${HOME}/.codex/AGENTS.md"

  source="${JSH_DIR}/dotfiles/.copilot/copilot-instructions.md"
  [[ -e "${source}" ]] && printf '%s|%s\n' "${source}" "${HOME}/.copilot/copilot-instructions.md"
}

_jsh_resolve_path() {
  local path="$1" parent
  parent=$(cd "$(dirname "${path}")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "${parent}" "$(basename "${path}")"
}

_jsh_link_target() {
  local link="$1" target
  target=$(readlink "${link}") || return 1
  case "${target}" in
    /*) _jsh_resolve_path "${target}" ;;
    *) _jsh_resolve_path "$(dirname "${link}")/${target}" ;;
  esac
}

_jsh_link_points_to() {
  local source="$1" destination="$2" source_path target_path
  [[ -L "${destination}" ]] || return 1
  source_path=$(_jsh_resolve_path "${source}") || return 1
  target_path=$(_jsh_link_target "${destination}") || return 1
  [[ "${source_path}" == "${target_path}" ]]
}

_jsh_state_has_destination() {
  local wanted="$1" source destination backup
  [[ -r "${JSH_LINK_STATE}" ]] || return 1
  while IFS='|' read -r source destination backup || [[ -n "${source}${destination}${backup}" ]]; do
    [[ "${destination}" == "${wanted}" ]] && return 0
  done <"${JSH_LINK_STATE}"
  return 1
}

_jsh_state_add() {
  local source="$1" destination="$2" backup="$3"
  _jsh_state_has_destination "${destination}" && return 0
  mkdir -p "${JSH_STATE_DIR}"
  printf '%s|%s|%s\n' "${source}" "${destination}" "${backup}" >>"${JSH_LINK_STATE}"
}

_jsh_migrate_vscode_prompts() {
  local dry_run="$1" source destination line managed_source managed_destination backup
  local legacy_backup="" found=0 child target recovery_backup temporary
  source="${JSH_DIR}/dotfiles/.vscode/user/prompts"
  destination="$(_jsh_vscode_user_dir)/prompts"
  [[ -r "${JSH_LINK_STATE}" ]] || return 0

  while IFS= read -r line || [[ -n "${line}" ]]; do
    IFS='|' read -r managed_source managed_destination backup <<<"${line}"
    if [[ "${managed_source}" == "${source}" && "${managed_destination}" == "${destination}" ]]; then
      legacy_backup="${backup}"
      found=1
      break
    fi
  done <"${JSH_LINK_STATE}"
  ((found == 1)) || return 0

  if [[ "${dry_run}" == 1 ]]; then
    _jsh_message plan "migrate ${destination} to individual managed links"
    return 0
  fi
  if [[ -e "${destination}" || -L "${destination}" ]]; then
    if ! _jsh_link_points_to "${source}" "${destination}" \
      && [[ ! -L "${destination}" || "$(readlink "${destination}")" != "${source}" ]]; then
      _jsh_message error "cannot migrate changed legacy link: ${destination}"
      return 1
    fi
  fi
  if [[ -n "${legacy_backup}" && ! -e "${legacy_backup}" && ! -L "${legacy_backup}" ]]; then
    _jsh_message error "missing backup: ${legacy_backup}"
    return 1
  fi

  for child in "${source}"/*.agent.md; do
    [[ -L "${child}" ]] || continue
    target=$(readlink "${child}" 2>/dev/null) || continue
    [[ "${target}" == "${child}" ]] || continue
    recovery_backup=""
    while IFS='|' read -r managed_source managed_destination backup \
      || [[ -n "${managed_source}${managed_destination}${backup}" ]]; do
      if [[ "${managed_source}" == "${child}" &&
        "${managed_destination}" == "${destination}/${child##*/}" ]]; then
        recovery_backup="${backup}"
        break
      fi
    done <"${JSH_LINK_STATE}"
    if [[ -z "${recovery_backup}" || ! -e "${recovery_backup}" ]]; then
      _jsh_message error "cannot recover managed source: ${child}"
      return 1
    fi
  done

  for child in "${source}"/*.agent.md; do
    [[ -L "${child}" ]] || continue
    target=$(readlink "${child}" 2>/dev/null) || continue
    [[ "${target}" == "${child}" ]] || continue
    while IFS='|' read -r managed_source managed_destination backup \
      || [[ -n "${managed_source}${managed_destination}${backup}" ]]; do
      if [[ "${managed_source}" == "${child}" &&
        "${managed_destination}" == "${destination}/${child##*/}" ]]; then
        rm "${child}" && mv "${backup}" "${child}" || return 1
        break
      fi
    done <"${JSH_LINK_STATE}"
  done

  [[ ! -L "${destination}" ]] || rm "${destination}" || return 1
  if [[ -n "${legacy_backup}" ]]; then
    mkdir -p "$(dirname "${destination}")" && mv "${legacy_backup}" "${destination}" || return 1
  else
    mkdir -p "${destination}" || return 1
  fi

  temporary="${JSH_LINK_STATE}.prompts.$$"
  : >"${temporary}" || return 1
  while IFS= read -r line || [[ -n "${line}" ]]; do
    IFS='|' read -r managed_source managed_destination backup <<<"${line}"
    if [[ "${managed_destination}" == "${destination}" ||
      "${managed_destination}" == "${destination}/"* ]]; then
      continue
    fi
    printf '%s\n' "${line}" >>"${temporary}" || {
      rm -f "${temporary}"
      return 1
    }
  done <"${JSH_LINK_STATE}"
  mv "${temporary}" "${JSH_LINK_STATE}"
}

_jsh_retire_legacy_agent_links() {
  local dry_run="$1" source_dir vscode_destination_dir line source destination backup temporary
  local source_dir_path source_path expected_source_path failures=0
  source_dir="${JSH_DIR}/dotfiles/.vscode/user/prompts"
  source_dir_path=$(_jsh_resolve_path "${source_dir}") || return 1
  vscode_destination_dir="$(_jsh_vscode_user_dir)/prompts"
  [[ -r "${JSH_LINK_STATE}" ]] || return 0
  temporary="${JSH_LINK_STATE}.agents.$$"
  [[ "${dry_run}" == 1 ]] || : >"${temporary}" || return 1

  while IFS= read -r line || [[ -n "${line}" ]]; do
    IFS='|' read -r source destination backup <<<"${line}"
    source_path=$(_jsh_resolve_path "${source}" 2>/dev/null || printf '%s\n' "${source}")
    expected_source_path="${source_dir_path}/${source##*/}"
    if [[ "${source}" != *.agent.md || "${source_path}" != "${expected_source_path}" ||
      ("${destination}" != "${vscode_destination_dir}/${source##*/}" &&
      "${destination}" != "${HOME}/.copilot/agents/${source##*/}") ]]; then
      [[ "${dry_run}" == 1 ]] || printf '%s\n' "${line}" >>"${temporary}" || return 1
      continue
    fi
    if ! _jsh_link_points_to "${source}" "${destination}" \
      && [[ -e "${destination}" || -L "${destination}" ]]; then
      _jsh_message changed "retained ${destination}"
      failures=$((failures + 1))
      [[ "${dry_run}" == 1 ]] || printf '%s\n' "${line}" >>"${temporary}" || return 1
      continue
    fi
    if [[ -n "${backup}" && ! -e "${backup}" && ! -L "${backup}" ]]; then
      _jsh_message error "missing backup: ${backup}"
      failures=$((failures + 1))
      [[ "${dry_run}" == 1 ]] || printf '%s\n' "${line}" >>"${temporary}" || return 1
      continue
    fi
    if [[ "${dry_run}" == 1 ]]; then
      _jsh_message plan "remove ${destination}${backup:+ and restore backup}"
      continue
    fi
    [[ ! -L "${destination}" ]] || rm "${destination}" || return 1
    if [[ -n "${backup}" ]]; then
      mkdir -p "$(dirname "${destination}")" && mv "${backup}" "${destination}" || return 1
    fi
    _jsh_message removed "${destination}"
  done <"${JSH_LINK_STATE}"

  [[ "${dry_run}" == 1 ]] || mv "${temporary}" "${JSH_LINK_STATE}"
  return "${failures}"
}

_jsh_backup_path() {
  local backup_root="$1" destination="$2" relative
  case "${destination}" in
    "${HOME}"/*) relative="${destination#"${HOME}"/}" ;;
    *) relative="external/${destination#/}" ;;
  esac
  printf '%s/%s\n' "${backup_root}" "${relative}"
}

_jsh_manage_link() {
  local source="$1" destination="$2" backup_root="$3" dry_run="$4" backup=""
  if _jsh_link_points_to "${source}" "${destination}"; then
    [[ "${dry_run}" == 1 ]] || _jsh_state_add "${source}" "${destination}" ""
    _jsh_message current "${destination}"
    return 0
  fi

  if [[ -e "${destination}" || -L "${destination}" ]]; then
    backup=$(_jsh_backup_path "${backup_root}" "${destination}")
    if [[ -e "${backup}" || -L "${backup}" ]]; then
      _jsh_message error "backup already exists: ${backup}"
      return 1
    fi
    if [[ "${dry_run}" == 1 ]]; then
      _jsh_message plan "backup ${destination} -> ${backup}"
    else
      mkdir -p "$(dirname "${backup}")" || return 1
      mv "${destination}" "${backup}" || return 1
    fi
  fi

  if [[ "${dry_run}" == 1 ]]; then
    _jsh_message plan "link ${destination} -> ${source}"
    return 0
  fi
  mkdir -p "$(dirname "${destination}")" || return 1
  if ! ln -s "${source}" "${destination}"; then
    [[ -z "${backup}" ]] || mv "${backup}" "${destination}" 2>/dev/null || true
    return 1
  fi
  _jsh_state_add "${source}" "${destination}" "${backup}"
  _jsh_message linked "${destination}"
}

_jsh_install_launcher() {
  local dry_run="$1" timestamp="$2" backup_root destination directory
  backup_root="${JSH_STATE_DIR}/backups/${timestamp}"

  if [[ -n "${JSH_LAUNCHER_DESTINATION:-}" ]]; then
    [[ "${JSH_LAUNCHER_DESTINATION}" == /* ]] || {
      _jsh_message error 'JSH_LAUNCHER_DESTINATION must be an absolute path'
      return 1
    }
    directory="${JSH_LAUNCHER_DESTINATION%/*}"
    if [[ ! -e "${JSH_LAUNCHER_DESTINATION}" && ! -L "${JSH_LAUNCHER_DESTINATION}" &&
      ! -w "${directory}" ]] \
      && command -v sudo >/dev/null 2>&1 \
      && sudo -n true 2>/dev/null; then
      if [[ "${dry_run}" == 1 ]]; then
        _jsh_message plan "link ${JSH_LAUNCHER_DESTINATION} -> ${JSH_DIR}/bin/jsh"
        return 0
      fi
      if sudo mkdir -p "${directory}" \
        && sudo ln -s "${JSH_DIR}/bin/jsh" "${JSH_LAUNCHER_DESTINATION}"; then
        if _jsh_state_add "${JSH_DIR}/bin/jsh" "${JSH_LAUNCHER_DESTINATION}" ""; then
          _jsh_message linked "${JSH_LAUNCHER_DESTINATION}"
          return 0
        fi
        sudo rm -f "${JSH_LAUNCHER_DESTINATION}" || true
      fi
      return 1
    fi
    _jsh_manage_link "${JSH_DIR}/bin/jsh" "${JSH_LAUNCHER_DESTINATION}" "${backup_root}" "${dry_run}"
    return
  fi

  if [[ -n "${JSH_BIN_DIR:-}" ]]; then
    [[ "${JSH_BIN_DIR}" == /* ]] || {
      _jsh_message error 'JSH_BIN_DIR must be an absolute path'
      return 1
    }
    JSH_LAUNCHER_DESTINATION="${JSH_BIN_DIR%/}/jsh"
    _jsh_manage_link "${JSH_DIR}/bin/jsh" "${JSH_LAUNCHER_DESTINATION}" "${backup_root}" "${dry_run}"
    return
  fi

  destination=/usr/local/bin/jsh
  directory=${destination%/*}
  if _jsh_link_points_to "${JSH_DIR}/bin/jsh" "${destination}" \
    || { [[ ! -e "${destination}" && ! -L "${destination}" && -w "${directory}" ]]; }; then
    JSH_LAUNCHER_DESTINATION=${destination}
    _jsh_manage_link "${JSH_DIR}/bin/jsh" "${destination}" "${backup_root}" "${dry_run}" && return
  fi
  if [[ ! -e "${destination}" && ! -L "${destination}" ]] \
    && command -v sudo >/dev/null 2>&1 \
    && { sudo -n true 2>/dev/null || { [[ "${dry_run}" == 0 && -r /dev/tty && -w /dev/tty ]] && sudo -v; }; }; then
    JSH_LAUNCHER_DESTINATION=${destination}
    if [[ "${dry_run}" == 1 ]]; then
      _jsh_message plan "link ${destination} -> ${JSH_DIR}/bin/jsh"
      return
    elif sudo mkdir -p "${directory}" && sudo ln -s "${JSH_DIR}/bin/jsh" "${destination}"; then
      if _jsh_state_add "${JSH_DIR}/bin/jsh" "${destination}" ""; then
        _jsh_message linked "${destination}"
        return
      fi
      sudo rm -f "${destination}" || true
    fi
  fi

  JSH_LAUNCHER_DESTINATION="${HOME}/.local/bin/jsh"
  if _jsh_manage_link "${JSH_DIR}/bin/jsh" "${JSH_LAUNCHER_DESTINATION}" "${backup_root}" "${dry_run}"; then
    return
  fi

  [[ -r /dev/tty && -w /dev/tty ]] || {
    _jsh_message error 'could not install the launcher; set JSH_BIN_DIR to a writable directory'
    return 1
  }
  while :; do
    printf 'Launcher directory: ' >/dev/tty
    IFS= read -r directory </dev/tty || return 1
    [[ "${directory}" == /* ]] || {
      _jsh_message error 'enter an absolute directory path'
      continue
    }
    JSH_LAUNCHER_DESTINATION="${directory%/}/jsh"
    _jsh_manage_link "${JSH_DIR}/bin/jsh" "${JSH_LAUNCHER_DESTINATION}" "${backup_root}" "${dry_run}" && return
  done
}

_jsh_apply_links() {
  local mode=runtime mode_label=Runtime dry_run=0 source destination failures=0
  local apply_launcher=1 apply_config=0 quiet=0
  local timestamp backup_root current_mode=""
  while (($# > 0)); do
    case "$1" in
      --mode)
        [[ $# -ge 2 ]] || return 2
        mode="$2"
        shift 2
        ;;
      --mode=*)
        mode="${1#*=}"
        shift
        ;;
      --dry-run | -n)
        dry_run=1
        shift
        ;;
      *)
        _jsh_error "unknown install option: $1"
        return 2
        ;;
    esac
  done
  case "${mode}" in runtime | install) ;; *)
    _jsh_error 'mode must be runtime or install'
    return 2
    ;;
  esac
  [[ "${mode}" != install ]] || mode_label=Install
  if [[ -n "${JSH_INSTALL_COMPONENTS:-}" ]]; then
    apply_launcher=0
    apply_config=0
    case ",${JSH_INSTALL_COMPONENTS}," in
      *,launcher,*) apply_launcher=1 ;;
    esac
    case ",${JSH_INSTALL_COMPONENTS}," in
      *,config,*) apply_config=1 ;;
    esac
  else
    [[ "${mode}" == install ]] && apply_config=1
  fi
  [[ "${JSH_INSTALL_QUIET:-0}" == 1 ]] && quiet=1
  [[ ! -r "${JSH_MODE_FILE}" ]] || IFS= read -r current_mode <"${JSH_MODE_FILE}"
  if [[ "${current_mode}" == install && "${mode}" == runtime ]]; then
    _jsh_error 'uninstall managed dotfiles before switching to runtime mode'
    return 1
  fi

  if [[ "${quiet}" == 0 ]]; then
    _jsh_banner "Configuring ${mode_label}"
  fi
  timestamp=$(date +%Y%m%d-%H%M%S)
  backup_root="${JSH_STATE_DIR}/backups/${timestamp}"
  if [[ "${apply_launcher}" == 1 ]]; then
    if [[ "${quiet}" == 1 ]]; then
      _jsh_install_launcher "${dry_run}" "${timestamp}" >/dev/null 2>&1 \
        || failures=$((failures + 1))
    else
      _jsh_install_launcher "${dry_run}" "${timestamp}" || failures=$((failures + 1))
    fi
  fi
  if [[ "${apply_config}" == 1 ]]; then
    if ! _jsh_migrate_vscode_prompts "${dry_run}" \
      || ! _jsh_retire_legacy_agent_links "${dry_run}"; then
      failures=$((failures + 1))
    else
      while IFS='|' read -r source destination; do
        if [[ "${quiet}" == 1 ]]; then
          _jsh_manage_link "${source}" "${destination}" "${backup_root}" "${dry_run}" \
            >/dev/null 2>&1 || failures=$((failures + 1))
        else
          _jsh_manage_link "${source}" "${destination}" "${backup_root}" "${dry_run}" \
            || failures=$((failures + 1))
        fi
      done < <(_jsh_install_entries)
    fi
  fi
  if [[ "${dry_run}" == 0 && "${failures}" == 0 ]]; then
    mkdir -p "${JSH_STATE_DIR}" && printf '%s\n' "${mode}" >"${JSH_MODE_FILE}"
  fi
  if [[ "${quiet}" == 0 && -n "${JSH_LAUNCHER_DESTINATION:-}" &&
    ":${PATH}:" != *":${JSH_LAUNCHER_DESTINATION%/*}:"* ]]; then
    _jsh_message note "add ${JSH_LAUNCHER_DESTINATION%/*} to PATH"
  fi
  [[ "${failures}" == 0 ]]
}

_jsh_status_emit() {
  local component="$1" state="$2" name="$3" detail="$4"
  name=${name//$'\t'/ }
  name=${name//$'\n'/ }
  detail=${detail//$'\t'/ }
  detail=${detail//$'\n'/ }
  printf '%s\t%s\t%s\t%s\n' "${component}" "${state}" "${name}" "${detail}" >>"${JSH_STATUS_RECORDS}"
}

_jsh_install_entry_exists() {
  local wanted_source="$1" wanted_destination="$2" source destination
  while IFS='|' read -r source destination; do
    [[ "${source}" == "${wanted_source}" && "${destination}" == "${wanted_destination}" ]] && return 0
  done < <(_jsh_install_entries)
  return 1
}

_jsh_managed_entry_is_stale() {
  local mode="$1" source="$2" destination="$3"
  [[ "${source}" != "${JSH_DIR}/bin/jsh" ]] || return 1
  [[ "${mode}" == install ]] || return 0
  ! _jsh_install_entry_exists "${source}" "${destination}"
}

_jsh_status_shell() {
  local mode=unconfigured line source destination backup state detail seen_launcher=0
  [[ ! -r "${JSH_MODE_FILE}" ]] || IFS= read -r mode <"${JSH_MODE_FILE}"
  case "${mode}" in
    runtime | install) _jsh_status_emit shell current mode "${mode}" ;;
    unconfigured) _jsh_status_emit shell missing mode 'jsh has not been configured' ;;
    *) _jsh_status_emit shell changed mode "unknown mode: ${mode}" ;;
  esac

  if [[ -r "${JSH_LINK_STATE}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
      if [[ "${line}" != *'|'* ]]; then
        [[ -z "${line}" ]] || _jsh_status_emit shell error "${line}" 'malformed managed-link state'
        continue
      fi
      IFS='|' read -r source destination backup <<<"${line}"
      if [[ -z "${source}" || -z "${destination}" ]]; then
        _jsh_status_emit shell error "${destination:-${source:-record}}" 'malformed managed-link state'
        continue
      fi
      if [[ "${source}" == "${JSH_DIR}/bin/jsh" ]]; then
        seen_launcher=1
        detail=${destination}
      else
        detail=${source}
      fi

      if _jsh_managed_entry_is_stale "${mode}" "${source}" "${destination}"; then
        state=changed
        detail="stale managed link: ${source}"
      elif [[ ! -e "${source}" && ! -L "${source}" ]]; then
        state=changed
        detail="managed source is missing: ${source}"
      elif _jsh_link_points_to "${source}" "${destination}"; then
        state=current
      elif [[ -e "${destination}" || -L "${destination}" ]]; then
        state=changed
        detail="wrong target; expected ${source}"
      else
        state=missing
        detail="expected link to ${source}"
      fi

      if [[ "${source}" == "${JSH_DIR}/bin/jsh" ]]; then
        _jsh_status_emit launcher "${state}" launcher "${detail}"
      else
        _jsh_status_emit configuration "${state}" "${destination}" "${detail}"
      fi
    done <"${JSH_LINK_STATE}"
  fi
  [[ "${seen_launcher}" == 1 ]] || _jsh_status_emit launcher missing launcher 'managed launcher is not recorded'

  if [[ "${mode}" == install ]]; then
    while IFS='|' read -r source destination; do
      _jsh_state_has_destination "${destination}" \
        || _jsh_status_emit configuration missing "${destination}" "not linked from ${source}"
    done < <(_jsh_install_entries)
  fi
}

_jsh_status_git_operation() {
  local git_dir current='' total=''
  REPLY=
  git_dir=$(git -C "${JSH_DIR}" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  if [[ -d "${git_dir}/rebase-merge" ]]; then
    REPLY=REBASE
    IFS= read -r current <"${git_dir}/rebase-merge/msgnum" 2>/dev/null || true
    IFS= read -r total <"${git_dir}/rebase-merge/end" 2>/dev/null || true
  elif [[ -d "${git_dir}/rebase-apply" ]]; then
    [[ -f "${git_dir}/rebase-apply/applying" ]] && REPLY=AM || REPLY=REBASE
    IFS= read -r current <"${git_dir}/rebase-apply/next" 2>/dev/null || true
    IFS= read -r total <"${git_dir}/rebase-apply/last" 2>/dev/null || true
  elif [[ -f "${git_dir}/MERGE_HEAD" ]]; then
    REPLY=MERGE
  elif [[ -f "${git_dir}/CHERRY_PICK_HEAD" ]]; then
    REPLY=CHERRY-PICK
  elif [[ -f "${git_dir}/REVERT_HEAD" ]]; then
    REPLY=REVERT
  elif [[ -f "${git_dir}/BISECT_LOG" ]]; then
    REPLY=BISECT
  fi
  if [[ -n "${REPLY}" && "${current}" =~ ^[0-9]+$ && "${total}" =~ ^[0-9]+$ ]]; then
    REPLY+=" ${current}/${total}"
  fi
}

_jsh_status_repository() {
  local output line xy state=current
  JSH_STATUS_GIT_BRANCH=unknown
  JSH_STATUS_GIT_HEAD=
  JSH_STATUS_GIT_CHANGES=0
  JSH_STATUS_GIT_STAGED=0
  JSH_STATUS_GIT_UNSTAGED=0
  JSH_STATUS_GIT_UNTRACKED=0
  JSH_STATUS_GIT_CONFLICTS=0
  JSH_STATUS_GIT_AHEAD=0
  JSH_STATUS_GIT_BEHIND=0
  JSH_STATUS_GIT_STASH=0
  JSH_STATUS_GIT_OPERATION=

  output=$(GIT_OPTIONAL_LOCKS=0 git -C "${JSH_DIR}" status \
    --porcelain=v2 --branch --show-stash --untracked-files=normal -- . \
    ':(exclude,glob)tmp/jsh-status.*/**' 2>/dev/null) || {
    _jsh_status_emit repository error Repository 'jsh is not a readable Git checkout'
    return
  }
  while IFS= read -r line; do
    case "${line}" in
      '# branch.oid '*) JSH_STATUS_GIT_HEAD=${line#\# branch.oid } ;;
      '# branch.head '*) JSH_STATUS_GIT_BRANCH=${line#\# branch.head } ;;
      '# branch.ab '*)
        line=${line#\# branch.ab }
        JSH_STATUS_GIT_AHEAD=${line%% *}
        JSH_STATUS_GIT_BEHIND=${line##* }
        JSH_STATUS_GIT_AHEAD=${JSH_STATUS_GIT_AHEAD#+}
        JSH_STATUS_GIT_BEHIND=${JSH_STATUS_GIT_BEHIND#-}
        ;;
      '# stash '*) JSH_STATUS_GIT_STASH=${line#\# stash } ;;
      '1 '* | '2 '*)
        xy=${line:2:2}
        JSH_STATUS_GIT_CHANGES=$((JSH_STATUS_GIT_CHANGES + 1))
        [[ ${xy:0:1} == . ]] || JSH_STATUS_GIT_STAGED=$((JSH_STATUS_GIT_STAGED + 1))
        [[ ${xy:1:1} == . ]] || JSH_STATUS_GIT_UNSTAGED=$((JSH_STATUS_GIT_UNSTAGED + 1))
        ;;
      'u '*)
        JSH_STATUS_GIT_CHANGES=$((JSH_STATUS_GIT_CHANGES + 1))
        JSH_STATUS_GIT_CONFLICTS=$((JSH_STATUS_GIT_CONFLICTS + 1))
        ;;
      '? '*)
        JSH_STATUS_GIT_CHANGES=$((JSH_STATUS_GIT_CHANGES + 1))
        JSH_STATUS_GIT_UNTRACKED=$((JSH_STATUS_GIT_UNTRACKED + 1))
        ;;
    esac
  done <<<"${output}"
  JSH_STATUS_GIT_HEAD=${JSH_STATUS_GIT_HEAD:0:7}
  _jsh_status_git_operation
  JSH_STATUS_GIT_OPERATION=${REPLY}

  if ((JSH_STATUS_GIT_CONFLICTS > 0)) || [[ -n "${JSH_STATUS_GIT_OPERATION}" ]]; then
    state=error
  elif ((JSH_STATUS_GIT_CHANGES > 0 || JSH_STATUS_GIT_BEHIND > 0)); then
    state=warning
  fi
  _jsh_status_emit repository "${state}" Repository \
    "${JSH_STATUS_GIT_BRANCH} @ ${JSH_STATUS_GIT_HEAD}, ${JSH_STATUS_GIT_CHANGES} changes - ${JSH_STATUS_GIT_STAGED} staged, ${JSH_STATUS_GIT_UNSTAGED} unstaged, ${JSH_STATUS_GIT_UNTRACKED} untracked"
}

_jsh_status_submodules() {
  local module_path module_status module_state module_detail state=current
  local commit_id commit_tag commit_date commit_detail
  local initialized=0 total=0 dirty=0 missing=0 drifted=0
  if [[ ! -r "${JSH_DIR}/.gitmodules" ]]; then
    _jsh_status_emit submodules error Submodules '.gitmodules is missing'
    return
  fi
  while IFS= read -r module_path; do
    [[ -n "${module_path}" ]] || continue
    total=$((total + 1))
    module_status=$(git -C "${JSH_DIR}" submodule status -- "${module_path}" 2>/dev/null || true)
    module_state=current
    module_detail=initialized
    case "${module_status}" in
      '')
        missing=$((missing + 1))
        module_state=error
        module_detail='not initialized'
        state=error
        ;;
      -*)
        missing=$((missing + 1))
        module_state=error
        module_detail='not initialized'
        state=error
        ;;
      +*)
        initialized=$((initialized + 1))
        drifted=$((drifted + 1))
        module_state=warning
        module_detail='checked out at a different commit'
        [[ "${state}" == error ]] || state=warning
        ;;
      U*)
        initialized=$((initialized + 1))
        module_state=error
        module_detail='merge conflict'
        state=error
        ;;
      *) initialized=$((initialized + 1)) ;;
    esac
    if [[ "${module_state}" != error && -d "${JSH_DIR}/${module_path}" ]] \
      && git -C "${JSH_DIR}/${module_path}" rev-parse --git-dir >/dev/null 2>&1 \
      && [[ -n $(git -C "${JSH_DIR}/${module_path}" status --porcelain --untracked-files=all 2>/dev/null) ]]; then
      dirty=$((dirty + 1))
      module_state=warning
      module_detail='local changes'
      [[ "${state}" == error ]] || state=warning
    fi
    if [[ "${module_state}" != error ]] \
      && commit_id=$(git -C "${JSH_DIR}/${module_path}" rev-parse --short=7 HEAD 2>/dev/null) \
      && commit_date=$(git -C "${JSH_DIR}/${module_path}" show -s --format=%cs HEAD 2>/dev/null); then
      commit_tag=$(git -C "${JSH_DIR}/${module_path}" describe --tags --exact-match HEAD 2>/dev/null || true)
      commit_detail="${commit_id}${commit_tag:+ (${commit_tag})}, ${commit_date}"
      if [[ "${module_detail}" == initialized ]]; then
        module_detail=${commit_detail}
      else
        module_detail="${commit_detail}, ${module_detail}"
      fi
    fi
    _jsh_status_emit submodule-item "${module_state}" "${module_path}" "${module_detail}"
  done < <(git -C "${JSH_DIR}" config --file .gitmodules --get-regexp '\.path$' 2>/dev/null | sed 's/^[^ ]* //')
  JSH_STATUS_SUBMODULE_TOTAL=${total}
  JSH_STATUS_SUBMODULE_INITIALIZED=${initialized}
  JSH_STATUS_SUBMODULE_DIRTY=${dirty}
  JSH_STATUS_SUBMODULE_MISSING=${missing}
  JSH_STATUS_SUBMODULE_DRIFTED=${drifted}
  _jsh_status_emit submodules "${state}" Submodules \
    "${initialized}/${total} initialized, ${dirty} dirty, ${drifted} drifted"
}

_jsh_status_package_manifests() {
  local host manifest platform_manifest=
  host=${JSH_STATUS_HOSTNAME:-$(hostname -s 2>/dev/null || true)}
  host=${host,,}
  case $(uname -s 2>/dev/null) in
    Darwin) platform_manifest="${JSH_DIR}/config/homebrew/Brewfile.macos" ;;
    Linux) platform_manifest="${JSH_DIR}/config/homebrew/Brewfile.linux" ;;
  esac
  for manifest in \
    "${JSH_DIR}/config/homebrew/Brewfile.core" \
    "${JSH_DIR}/config/homebrew/Brewfile" \
    "${platform_manifest}" \
    "${JSH_DIR}/config/homebrew/Brewfile.${host}"; do
    [[ -n "${manifest}" && -r "${manifest}" ]] && printf '%s\n' "${manifest}"
  done
}

_jsh_status_declared_packages() {
  local manifest kind name
  while IFS= read -r manifest; do
    while IFS=$'\t' read -r kind name; do
      [[ "${kind}" != formula ]] || name=${name##*/}
      printf '%s\t%s\n' "${kind}" "${name}"
    done < <(sed -n \
      -e 's/^[[:space:]]*brew[[:space:]]*"\([^"]*\)".*/formula\	\1/p' \
      -e 's/^[[:space:]]*cask[[:space:]]*"\([^"]*\)".*/cask\	\1/p' \
      "${manifest}")
  done < <(_jsh_status_package_manifests) | sort -u
}

_jsh_status_packages() {
  local declared installed_formulae='' installed_casks='' kind name state=current item_state
  local outdated_json='' current_version latest_version update_label item_detail
  local brew_available=0
  JSH_STATUS_PACKAGE_TOTAL=0
  JSH_STATUS_PACKAGE_INSTALLED=0
  JSH_STATUS_PACKAGE_MISSING=0
  JSH_STATUS_PACKAGE_UPDATES=0
  : >"${JSH_STATUS_UPDATE_RECORDS}"
  declared=$(_jsh_status_declared_packages)

  if command -v brew >/dev/null 2>&1; then
    brew_available=1
    installed_formulae=$(brew list --formula -1 2>/dev/null || true)
    installed_casks=$(brew list --cask -1 2>/dev/null || true)
  else
    state=warning
  fi

  while IFS=$'\t' read -r kind name; do
    [[ -n "${kind}" && -n "${name}" ]] || continue
    JSH_STATUS_PACKAGE_TOTAL=$((JSH_STATUS_PACKAGE_TOTAL + 1))
    item_state=warning
    item_detail="${kind}, missing"
    if [[ "${kind}" == formula ]] \
      && { grep -Fqx "${name}" <<<"${installed_formulae}" \
        || { ((brew_available)) && brew list --formula "${name}" >/dev/null 2>&1; }; }; then
      item_state=current
      item_detail=${kind}
    elif [[ "${kind}" == cask ]] && grep -Fqx "${name}" <<<"${installed_casks}"; then
      item_state=current
      item_detail=${kind}
    fi
    if [[ "${item_state}" == current ]]; then
      JSH_STATUS_PACKAGE_INSTALLED=$((JSH_STATUS_PACKAGE_INSTALLED + 1))
    else
      JSH_STATUS_PACKAGE_MISSING=$((JSH_STATUS_PACKAGE_MISSING + 1))
      if [[ "${kind}" == formula ]] \
        && sed -n 's/^[[:space:]]*brew[[:space:]]*"\([^"]*\)".*/\1/p' \
          "${JSH_DIR}/config/homebrew/Brewfile.core" 2>/dev/null \
        | sed 's|.*/||' | grep -Fqx "${name}"; then
        item_state=error
        state=error
      elif [[ "${state}" != error ]]; then
        state=warning
      fi
    fi
    _jsh_status_emit package-item "${item_state}" "${name}" "${item_detail}"
  done <<<"${declared}"

  if command -v brew >/dev/null 2>&1 && [[ "${JSH_STATUS_CHECK_UPDATES:-auto}" != never ]]; then
    outdated_json=$(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --json=v2 2>/dev/null || true)
    if [[ -n "${outdated_json}" ]] && command -v jq >/dev/null 2>&1; then
      while IFS=$'\t' read -r name current_version latest_version; do
        [[ -n "${name}" ]] || continue
        printf '%s\t%s\t%s\n' "${name}" "${current_version}" "${latest_version}" \
          >>"${JSH_STATUS_UPDATE_RECORDS}"
        _jsh_status_emit package-update warning "${name}" "${current_version} -> ${latest_version}"
        JSH_STATUS_PACKAGE_UPDATES=$((JSH_STATUS_PACKAGE_UPDATES + 1))
      done < <(jq -r '
        ((.formulae // [])[] | [.name, ((.installed_versions // []) | join(",")), .current_version]),
        ((.casks // [])[] | [.name, ((.installed_versions // []) | join(",")), .current_version])
        | @tsv' <<<"${outdated_json}" 2>/dev/null)
    fi
  fi
  if ((JSH_STATUS_PACKAGE_UPDATES > 0)) && [[ "${state}" != error ]]; then
    state=warning
  fi
  [[ "${JSH_STATUS_PACKAGE_UPDATES}" == 1 ]] && update_label=update || update_label=updates
  _jsh_status_emit packages "${state}" Packages \
    "${JSH_STATUS_PACKAGE_TOTAL} defined, ${JSH_STATUS_PACKAGE_INSTALLED} installed, ${JSH_STATUS_PACKAGE_UPDATES} ${update_label}"
}

_jsh_status_project_find() {
  local search_dir=${PWD}
  REPLY=
  while [[ -n "${search_dir}" ]]; do
    if [[ -r "${search_dir}/.jshenv" ]]; then
      REPLY="${search_dir}/.jshenv"
      return 0
    fi
    if [[ -r "${search_dir}/.jshrc" ]]; then
      REPLY="${search_dir}/.jshrc"
      return 0
    fi
    [[ "${search_dir}" == / ]] && break
    search_dir=${search_dir%/*}
    [[ -n "${search_dir}" ]] || search_dir=/
  done
  return 1
}

_jsh_status_project_trusted() {
  local file="$1" hash='' trusted_file trusted_hash
  if command -v shasum >/dev/null 2>&1; then
    hash=$(shasum -a 256 "${file}" 2>/dev/null)
    hash=${hash%% *}
  elif command -v sha256sum >/dev/null 2>&1; then
    hash=$(sha256sum "${file}" 2>/dev/null)
    hash=${hash%% *}
  fi
  [[ -n "${hash}" && -r "${JSH_PROJECT_TRUST_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/jsh/trusted-projects}" ]] || return 1
  while IFS='|' read -r trusted_file trusted_hash; do
    [[ "${trusted_file}" == "${file}" && "${trusted_hash}" == "${hash}" ]] && return 0
  done <"${JSH_PROJECT_TRUST_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/jsh/trusted-projects}"
  return 1
}

_jsh_status_environment() {
  local selected_nvim project_file
  selected_nvim=$(command -v nvim 2>/dev/null || true)
  if [[ "${selected_nvim}" == "${JSH_DIR}/bin/nvim" ]]; then
    _jsh_status_emit editors current Neovim "jsh wrapper active, runtime stored under ${JSH_LOCAL_DIR:-${JSH_DIR}/local}"
    _jsh_status_emit path current PATH "${JSH_DIR}/bin takes precedence"
  else
    _jsh_status_emit editors warning Neovim "jsh wrapper is not selected by PATH"
    _jsh_status_emit path warning PATH "add ${JSH_DIR}/bin before other executable directories"
  fi

  if _jsh_status_project_find; then
    project_file=${REPLY}
    if [[ "${project_file}" == *.jshrc ]] && ! _jsh_status_project_trusted "${project_file}"; then
      _jsh_status_emit project warning 'Project shell config' "${project_file}, trust required"
    else
      _jsh_status_emit project current 'Project shell config' "${project_file}, ready"
    fi
  else
    _jsh_status_emit project current 'Project shell config' 'none discovered'
  fi

  if [[ -r "${JSH_DIR}/dotfiles/.gitconfig" ]]; then
    _jsh_status_emit runtime-git current 'Runtime Git' 'isolated writable overlay'
  else
    _jsh_status_emit runtime-git error 'Runtime Git' 'managed Git baseline is missing'
  fi
}

_jsh_status_component_state() {
  local wanted="$1" component state _name _detail rank=0 current_rank
  REPLY_STATE=current
  while IFS=$'\t' read -r component state _name _detail; do
    [[ "${component}" == "${wanted}" ]] || continue
    case "${state}" in
      error | missing | failed) current_rank=2 ;;
      changed | retained | warning) current_rank=1 ;;
      *) current_rank=0 ;;
    esac
    if ((current_rank > rank)); then
      rank=${current_rank}
      ((rank == 2)) && REPLY_STATE=error || REPLY_STATE=warning
    fi
  done <"${JSH_STATUS_RECORDS}"
}

_jsh_status_component_counts() {
  local wanted="$1" component state _name _detail
  REPLY_TOTAL=0
  REPLY_CURRENT=0
  while IFS=$'\t' read -r component state _name _detail; do
    [[ "${component}" == "${wanted}" ]] || continue
    REPLY_TOTAL=$((REPLY_TOTAL + 1))
    case "${state}" in current | linked | success) REPLY_CURRENT=$((REPLY_CURRENT + 1)) ;; esac
  done <"${JSH_STATUS_RECORDS}"
}

_jsh_status_doctor_counts() {
  local components="$1" component classification _name _detail
  REPLY_TOTAL=0
  REPLY_CURRENT=0
  REPLY_STATE=current
  while IFS=$'\t' read -r component classification _name _detail; do
    case " ${components} " in *" ${component} "*) ;; *) continue ;; esac
    [[ "${classification}" != network-only ]] || continue
    REPLY_TOTAL=$((REPLY_TOTAL + 1))
    case "${classification}:${_detail}" in
      available:* | required:available) REPLY_CURRENT=$((REPLY_CURRENT + 1)) ;;
      required:missing) REPLY_STATE=error ;;
      optional-missing:*) [[ "${REPLY_STATE}" == error ]] || REPLY_STATE=warning ;;
    esac
  done <"${JSH_DOCTOR_RECORDS}"
}

_jsh_status_worst_state() {
  local candidate state=current
  for candidate in "$@"; do
    case "${candidate}" in
      error | missing | failed)
        state=error
        break
        ;;
      warning | changed | retained) [[ "${state}" == error ]] || state=warning ;;
    esac
  done
  REPLY_STATE=${state}
}

_jsh_status_doctor_summaries() {
  _jsh_status_doctor_counts 'installer commands'
  _jsh_status_emit commands "${REPLY_STATE}" Commands "${REPLY_CURRENT}/${REPLY_TOTAL} available"
  _jsh_status_doctor_counts editors
  _jsh_status_emit editor-tools "${REPLY_STATE}" Editors "${REPLY_CURRENT}/${REPLY_TOTAL} available"
}

_jsh_status_summary_width() {
  local label component state name detail
  JSH_STATUS_LABEL_WIDTH=0
  JSH_STATUS_DETAIL_WIDTH=18
  for label in Shell Repository Submodules Packages Launcher Configuration Commands Editors PATH 'Runtime Git' 'Project shell config'; do
    ((${#label} > JSH_STATUS_LABEL_WIDTH)) && JSH_STATUS_LABEL_WIDTH=${#label}
  done
  while IFS=$'\t' read -r component state name detail; do
    ((${#name} > JSH_STATUS_DETAIL_WIDTH)) && JSH_STATUS_DETAIL_WIDTH=${#name}
  done <"${JSH_STATUS_RECORDS}"
  while IFS=$'\t' read -r component state name detail; do
    ((${#name} > JSH_STATUS_DETAIL_WIDTH)) && JSH_STATUS_DETAIL_WIDTH=${#name}
  done <"${JSH_DOCTOR_RECORDS}"
  ((JSH_STATUS_DETAIL_WIDTH <= 30)) || JSH_STATUS_DETAIL_WIDTH=30
  JSH_STATUS_LABEL_WIDTH=$((JSH_STATUS_DETAIL_WIDTH + 2))
}

_jsh_status_detail_row() {
  local state="$1" name="$2" detail="${3:-}" prefix
  _jsh_ui_init
  _jsh_ui_status "${state}"
  _jsh_ui_text "${name}"
  name=${REPLY_TEXT}
  _jsh_ui_text "${detail}"
  detail=${REPLY_TEXT}
  if [[ "${_JSH_UI_RICH}" == 1 ]]; then
    prefix="${REPLY_COLOR}${REPLY_MARK}${_JSH_UI_RESET}"
  else
    printf -v prefix '%-7s' "[${REPLY_MARK}]"
  fi
  printf '  %s %s%-*s%s  %s%s%s\n' "${prefix}" "${_JSH_UI_BOLD}" \
    "${JSH_STATUS_DETAIL_WIDTH}" "${name}" "${_JSH_UI_RESET}" \
    "${_JSH_UI_DIM}" "${detail}" "${_JSH_UI_RESET}"
}

_jsh_status_relationship_row() {
  local state="$1" destination="$2" source="$3" prefix
  _jsh_ui_init
  _jsh_ui_status "${state}"
  _jsh_ui_path "${destination}"
  destination=${REPLY_TEXT}
  _jsh_ui_path "${source}"
  source=${REPLY_TEXT}
  if [[ "${_JSH_UI_RICH}" == 1 ]]; then
    prefix="${REPLY_COLOR}${REPLY_MARK}${_JSH_UI_RESET}"
  else
    printf -v prefix '%-7s' "[${REPLY_MARK}]"
  fi
  printf '  %s %s%s%s\n' "${prefix}" "${_JSH_UI_BOLD}" "${destination}" "${_JSH_UI_RESET}"
  printf '    %s→%s %s%s%s\n' "${_JSH_UI_CYAN}" "${_JSH_UI_RESET}" \
    "${_JSH_UI_DIM}" "${source}" "${_JSH_UI_RESET}"
}

_jsh_status_verbose_records() {
  local wanted="$1" component state name detail
  while IFS=$'\t' read -r component state name detail; do
    [[ "${component}" == "${wanted}" ]] || continue
    _jsh_status_detail_row "${state}" "${name}" "${detail}"
  done <"${JSH_STATUS_RECORDS}"
}

_jsh_status_verbose_relationships() {
  local wanted="$1" component state name detail source
  while IFS=$'\t' read -r component state name detail; do
    [[ "${component}" == "${wanted}" ]] || continue
    if [[ "${state}" == current || "${state}" == linked ]]; then
      _jsh_status_relationship_row "${state}" "${name}" "${detail}"
    else
      _jsh_ui_path "${name}"
      name=${REPLY_TEXT}
      case "${detail}" in
        'not linked from '* | 'stale managed link: '*)
          source=${detail#* from }
          [[ "${detail}" == 'not linked from '* ]] || source=${detail#*: }
          _jsh_ui_path "${source}"
          detail="${detail%"${source}"}${REPLY_TEXT}"
          ;;
      esac
      _jsh_status_detail_row "${state}" "${name}" "${detail}"
    fi
  done <"${JSH_STATUS_RECORDS}"
}

_jsh_status_verbose_doctor() {
  local components="$1" component classification name detail state
  while IFS=$'\t' read -r component classification name detail; do
    case " ${components} " in *" ${component} "*) ;; *) continue ;; esac
    case "${classification}:${detail}" in
      required:missing) state=error ;;
      optional-missing:*) state=warning ;;
      network-only:*)
        _jsh_status_detail_row info "${name}" "${detail}"
        continue
        ;;
      *) state=current ;;
    esac
    _jsh_status_detail_row "${state}" "${name}" "${detail}"
  done <"${JSH_DOCTOR_RECORDS}"
}

_jsh_status_verbose_repository() {
  _jsh_status_detail_row current Branch "${JSH_STATUS_GIT_BRANCH}"
  _jsh_status_detail_row current Commit "${JSH_STATUS_GIT_HEAD}"
  _jsh_status_detail_row "$([[ ${JSH_STATUS_GIT_CHANGES} == 0 ]] && printf current || printf warning)" \
    'Working tree' "${JSH_STATUS_GIT_STAGED} staged, ${JSH_STATUS_GIT_UNSTAGED} unstaged, ${JSH_STATUS_GIT_UNTRACKED} untracked"
  ((JSH_STATUS_GIT_CONFLICTS == 0)) \
    || _jsh_status_detail_row error Conflicts "${JSH_STATUS_GIT_CONFLICTS}"
  ((JSH_STATUS_GIT_AHEAD == 0 && JSH_STATUS_GIT_BEHIND == 0)) \
    || _jsh_status_detail_row "$([[ ${JSH_STATUS_GIT_BEHIND} == 0 ]] && printf current || printf warning)" \
      Upstream "${JSH_STATUS_GIT_AHEAD} ahead, ${JSH_STATUS_GIT_BEHIND} behind"
  ((JSH_STATUS_GIT_STASH == 0)) \
    || _jsh_status_detail_row current Stash "${JSH_STATUS_GIT_STASH} entries"
  [[ -z "${JSH_STATUS_GIT_OPERATION}" ]] \
    || _jsh_status_detail_row error Operation "${JSH_STATUS_GIT_OPERATION}"
}

_jsh_status_verbose_updates() {
  local name current_version latest_version
  while IFS=$'\t' read -r name current_version latest_version; do
    [[ -n "${name}" ]] || continue
    _jsh_ui_init
    _jsh_ui_status warning
    if [[ "${_JSH_UI_RICH}" == 1 ]]; then
      printf '  %s%s%s %s%s%s  %s%s%s %s->%s %s%s%s\n' \
        "${REPLY_COLOR}" "${REPLY_MARK}" "${_JSH_UI_RESET}" \
        "${_JSH_UI_BOLD}" "${name}" "${_JSH_UI_RESET}" \
        "${_JSH_UI_YELLOW}" "${current_version}" "${_JSH_UI_RESET}" \
        "${_JSH_UI_DIM}" "${_JSH_UI_RESET}" \
        "${_JSH_UI_GREEN}" "${latest_version}" "${_JSH_UI_RESET}"
    else
      printf '  [warn] %s  %s -> %s\n' "${name}" "${current_version}" "${latest_version}"
    fi
  done <"${JSH_STATUS_UPDATE_RECORDS}"
  ((JSH_STATUS_PACKAGE_UPDATES == 0)) && return 0
  printf '    %sRun %s%sjsh update%s\n' "${_JSH_UI_DIM}" \
    "${_JSH_UI_BOLD}" "${_JSH_UI_CYAN}" "${_JSH_UI_RESET}"
}

_jsh_status_summary_row() {
  local state="$1" label="$2" plain_value="$3" formatted_value="${4:-$3}"
  local prefix prefix_width columns row_width
  _jsh_ui_init
  _jsh_ui_status "${state}"
  if [[ "${_JSH_UI_RICH}" == 1 ]]; then
    prefix="${REPLY_COLOR}${REPLY_MARK}${_JSH_UI_RESET} "
    prefix_width=2
  else
    printf -v prefix '%-8s' "[${REPLY_MARK}]"
    prefix_width=8
  fi
  columns=${COLUMNS:-80}
  [[ "${columns}" =~ ^[0-9]+$ ]] || columns=80
  row_width=$((prefix_width + JSH_STATUS_LABEL_WIDTH + 2 + ${#plain_value}))
  if ((columns >= 30 && row_width > columns)); then
    printf '%s%s%s%s\n' "${prefix}" "${_JSH_UI_BOLD}" "${label}" "${_JSH_UI_RESET}"
    printf '  %s\n' "${formatted_value}"
  else
    printf '%s%s%-*s%s  %s\n' "${prefix}" "${_JSH_UI_BOLD}" \
      "${JSH_STATUS_LABEL_WIDTH}" "${label}" "${_JSH_UI_RESET}" "${formatted_value}"
  fi
}

_jsh_status_repository_values() {
  local plain suffix='' formatted_changes=''
  plain="${JSH_STATUS_GIT_BRANCH} @ ${JSH_STATUS_GIT_HEAD}, ${JSH_STATUS_GIT_CHANGES} changes"
  REPLY_FORMATTED="${_JSH_UI_GIT}${JSH_STATUS_GIT_BRANCH}${_JSH_UI_RESET} ${_JSH_UI_DIM}@ ${JSH_STATUS_GIT_HEAD}${_JSH_UI_RESET}, ${JSH_STATUS_GIT_CHANGES} changes"
  if ((JSH_STATUS_GIT_CHANGES > 0)); then
    if ((JSH_STATUS_GIT_STAGED > 0)); then
      suffix="${JSH_STATUS_GIT_STAGED} staged"
      formatted_changes="${_JSH_UI_GREEN}${JSH_STATUS_GIT_STAGED} staged${_JSH_UI_RESET}"
    fi
    if ((JSH_STATUS_GIT_UNSTAGED > 0)); then
      suffix+="${suffix:+, }${JSH_STATUS_GIT_UNSTAGED} unstaged"
      formatted_changes+="${formatted_changes:+, }${_JSH_UI_YELLOW}${JSH_STATUS_GIT_UNSTAGED} unstaged${_JSH_UI_RESET}"
    fi
    if ((JSH_STATUS_GIT_UNTRACKED > 0)); then
      suffix+="${suffix:+, }${JSH_STATUS_GIT_UNTRACKED} untracked"
      formatted_changes+="${formatted_changes:+, }${_JSH_UI_CYAN}${JSH_STATUS_GIT_UNTRACKED} untracked${_JSH_UI_RESET}"
    fi
    plain+=" - ${suffix}"
    REPLY_FORMATTED+=" - ${formatted_changes}"
  fi
  suffix=
  ((JSH_STATUS_GIT_BEHIND > 0)) && suffix="${JSH_STATUS_GIT_BEHIND} behind"
  ((JSH_STATUS_GIT_AHEAD > 0)) && suffix="${suffix}${suffix:+, }${JSH_STATUS_GIT_AHEAD} ahead"
  if [[ -n "${suffix}" ]]; then
    plain+=", ${suffix}"
    REPLY_FORMATTED+=", ${_JSH_UI_GREEN}${suffix}${_JSH_UI_RESET}"
  fi
  if ((JSH_STATUS_GIT_STASH > 0)); then
    plain+=", ${JSH_STATUS_GIT_STASH} stashed"
    REPLY_FORMATTED+=", ${_JSH_UI_ACCENT}${JSH_STATUS_GIT_STASH} stashed${_JSH_UI_RESET}"
  fi
  if [[ -n "${JSH_STATUS_GIT_OPERATION}" ]]; then
    plain+=", ${JSH_STATUS_GIT_OPERATION}"
    REPLY_FORMATTED+=", ${_JSH_UI_RED}${JSH_STATUS_GIT_OPERATION}${_JSH_UI_RESET}"
  fi
  REPLY_PLAIN=${plain}
}

_jsh_status_colors() {
  _jsh_ui_init
  _JSH_STATUS_RESET=${_JSH_UI_RESET}
  _JSH_STATUS_BOLD=${_JSH_UI_BOLD}
  _JSH_STATUS_DIM=${_JSH_UI_DIM}
  _JSH_STATUS_RED=${_JSH_UI_RED}
  _JSH_STATUS_GREEN=${_JSH_UI_GREEN}
  _JSH_STATUS_YELLOW=${_JSH_UI_YELLOW}
  _JSH_STATUS_CYAN=${_JSH_UI_CYAN}
}

_jsh_banner() {
  local header="${1:-}" gap_width=26 header_width left_width right_width
  [[ "${JSH_BANNER_SHOWN:-0}" != 1 ]] || return 0
  JSH_BANNER_SHOWN=1
  if ((${#header} > gap_width - 2)); then
    header="${header:0:gap_width-5}..."
  fi
  header_width=${#header}
  left_width=$(((gap_width - header_width) / 2))
  right_width=$((gap_width - header_width - left_width))
  _jsh_status_colors
  printf '\n%s%s' "${_JSH_STATUS_BOLD}" "${_JSH_STATUS_CYAN}"
  cat <<'BANNER'
   :%@@@@@@@@@#*#@%-              +-:##
  :#    -#%%+=#:@#                :@@%:
   %@@     +@++@@-            *-   @@%:
          *@%:%@@:    :%@@@@*%+  *@@@%::*@@#
     -###%@@+:%@@:  :%@#:--=%:    -@@@#: #@@=
       :#@@@+:%@@:  :%@#  -#-     -@@%   *@@=
      *#:#@@+:%@@:  :%@@@@@@@@*   -@@%   *@@=
       -#@@@+:%@%:     *%  -@@*   -@@%   *@@=
         :@@+:%@*     -*   -@@*   -@@%   *@@=
          +@+:%*     *@@@@@%@%-   #@@@+  *@@-
   :==--::*#:#-     -:   -*:        +   =@@=
 :@@@@@@@@#@-                         +@#:
BANNER
  printf ' =   :-=-:%*s%s%*s-:\n' \
    "${left_width}" '' "${header}" "${right_width}" ''
  printf '%s\n' "${_JSH_STATUS_RESET}"
}

_jsh_status_render() {
  local verbose="$1" state secondary_state mode mode_state shell_name shell_value value formatted
  local total_problems=0 component record_state name detail
  _jsh_banner Status

  _jsh_status_summary_width
  mode=$(awk -F '\t' '$1 == "shell" && $3 == "mode" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  mode_state=$(awk -F '\t' '$1 == "shell" && $3 == "mode" { print $2; exit }' "${JSH_STATUS_RECORDS}")
  case "${mode}" in install) mode=full ;; runtime) mode=lite ;; esac
  [[ "${mode_state}" == current ]] || mode=unconfigured
  shell_name=${JSH_SHELL:-${SHELL##*/}}
  shell_name=${shell_name:-bash}
  shell_value="${mode}, ${shell_name}, ${JSH_RUNTIME_PROFILE:-standard} profile"
  _jsh_status_doctor_counts 'base runtime'
  _jsh_status_worst_state "${mode_state}" "${REPLY_STATE}"
  _jsh_status_summary_row "${REPLY_STATE}" Shell "${shell_value}"
  [[ "${verbose}" != 1 ]] || _jsh_status_verbose_doctor 'base runtime'

  _jsh_status_component_state repository
  state=${REPLY_STATE}
  _jsh_status_repository_values
  _jsh_status_summary_row "${state}" Repository "${REPLY_PLAIN}" "${REPLY_FORMATTED}"
  [[ "${verbose}" != 1 ]] || _jsh_status_verbose_repository

  _jsh_status_component_state submodules
  state=${REPLY_STATE}
  _jsh_status_doctor_counts vendor
  secondary_state=${REPLY_STATE}
  value="${JSH_STATUS_SUBMODULE_INITIALIZED:-0}/${JSH_STATUS_SUBMODULE_TOTAL:-0} initialized, ${REPLY_CURRENT}/${REPLY_TOTAL} assets"
  ((JSH_STATUS_SUBMODULE_DIRTY == 0)) || value+=", ${JSH_STATUS_SUBMODULE_DIRTY} dirty"
  ((JSH_STATUS_SUBMODULE_DRIFTED == 0)) || value+=", ${JSH_STATUS_SUBMODULE_DRIFTED} drifted"
  _jsh_status_worst_state "${state}" "${secondary_state}"
  _jsh_status_summary_row "${REPLY_STATE}" Submodules "${value}"
  if [[ "${verbose}" == 1 ]]; then
    _jsh_status_verbose_records submodule-item
    _jsh_status_verbose_doctor vendor
  fi

  state=$(awk -F '\t' '$1 == "packages" { print $2; exit }' "${JSH_STATUS_RECORDS}")
  value=$(awk -F '\t' '$1 == "packages" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  _jsh_status_summary_row "${state}" Packages "${value}"
  if [[ "${verbose}" == 1 ]]; then
    _jsh_status_verbose_records package-item
    _jsh_status_verbose_updates
  fi

  _jsh_status_component_state launcher
  state=${REPLY_STATE}
  value=$(awk -F '\t' '$1 == "launcher" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  _jsh_ui_text "${value}"
  value=${REPLY_TEXT}
  formatted="${_JSH_UI_CYAN}${value}${_JSH_UI_RESET}"
  _jsh_status_summary_row "${state}" Launcher "${value}" "${formatted}"
  if [[ "${verbose}" == 1 ]]; then
    if [[ "${state}" == current ]]; then
      _jsh_status_relationship_row "${state}" "${value}" "${JSH_DIR}/bin/jsh"
    else
      _jsh_status_verbose_records launcher
    fi
  fi

  _jsh_status_component_state configuration
  state=${REPLY_STATE}
  _jsh_status_component_counts configuration
  _jsh_status_summary_row "${state}" Configuration "${REPLY_CURRENT}/${REPLY_TOTAL} linked"
  [[ "${verbose}" != 1 ]] || _jsh_status_verbose_relationships configuration

  printf '\n'
  state=$(awk -F '\t' '$1 == "commands" { print $2; exit }' "${JSH_STATUS_RECORDS}")
  value=$(awk -F '\t' '$1 == "commands" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  _jsh_status_summary_row "${state}" Commands "${value}"
  if [[ "${verbose}" == 1 ]]; then
    _jsh_status_verbose_doctor 'installer commands'
    _jsh_status_verbose_doctor network
  fi

  state=$(awk -F '\t' '$1 == "editor-tools" { print $2; exit }' "${JSH_STATUS_RECORDS}")
  value=$(awk -F '\t' '$1 == "editor-tools" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  _jsh_status_component_state editors
  _jsh_status_worst_state "${state}" "${REPLY_STATE}"
  value+=", jsh wrapper $([[ $(awk -F '\t' '$1 == "editors" { print $2; exit }' "${JSH_STATUS_RECORDS}") == current ]] && printf active || printf inactive)"
  _jsh_status_summary_row "${REPLY_STATE}" Editors "${value}"
  if [[ "${verbose}" == 1 ]]; then
    _jsh_status_verbose_doctor editors
    _jsh_status_verbose_records editors
  fi

  state=$(awk -F '\t' '$1 == "path" { print $2; exit }' "${JSH_STATUS_RECORDS}")
  value=$(awk -F '\t' '$1 == "path" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  _jsh_ui_text "${value}"
  value=${REPLY_TEXT}
  _jsh_status_summary_row "${state}" PATH "${value}" "${_JSH_UI_CYAN}${value}${_JSH_UI_RESET}"

  state=$(awk -F '\t' '$1 == "runtime-git" { print $2; exit }' "${JSH_STATUS_RECORDS}")
  value=$(awk -F '\t' '$1 == "runtime-git" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  _jsh_status_summary_row "${state}" 'Runtime Git' "${value}"

  state=$(awk -F '\t' '$1 == "project" { print $2; exit }' "${JSH_STATUS_RECORDS}")
  value=$(awk -F '\t' '$1 == "project" { print $4; exit }' "${JSH_STATUS_RECORDS}")
  if [[ "${value}" == *,\ * ]]; then
    formatted=${value%, *}
    _jsh_ui_path "${formatted}"
    formatted="${REPLY_TEXT}, ${value##*, }"
  else
    formatted=${value}
  fi
  _jsh_status_summary_row "${state}" 'Project shell config' "${value}" "${formatted}"

  if awk -F '\t' '$1 == "configuration" && (($2 == "changed" && $4 ~ /^stale managed link:/) || ($2 == "error" && $4 == "malformed managed-link state")) { found=1 } END { exit !found }' \
    "${JSH_STATUS_RECORDS}"; then
    printf '\n%sRun jsh repair --dry-run to preview stale managed-link cleanup.%s\n' \
      "${_JSH_UI_DIM}" "${_JSH_UI_RESET}"
  fi
  while IFS=$'\t' read -r component state name detail; do
    case "${state}" in error | missing | changed | warning | retained) total_problems=$((total_problems + 1)) ;; esac
  done <"${JSH_STATUS_RECORDS}"
  ((total_problems == 0))
}

_jsh_status() {
  local porcelain=0 verbose=0 work_dir result=0
  while (($# > 0)); do
    case "$1" in
      --porcelain) porcelain=1 ;;
      --verbose | -v) verbose=1 ;;
      *)
        _jsh_error "unknown status option: $1"
        return 2
        ;;
    esac
    shift
  done

  mkdir -p "${JSH_DIR}/tmp" || return 1
  work_dir=$(mktemp -d "${JSH_DIR}/tmp/jsh-status.XXXXXX") || return 1
  JSH_STATUS_RECORDS="${work_dir}/records"
  JSH_STATUS_UPDATE_RECORDS="${work_dir}/updates"
  JSH_DOCTOR_RECORDS="${work_dir}/doctor"
  : >"${JSH_STATUS_RECORDS}"
  : >"${JSH_STATUS_UPDATE_RECORDS}"
  : >"${JSH_DOCTOR_RECORDS}"
  if [[ "${porcelain}" == 0 ]]; then
    _jsh_banner Status
    jsh_spinner_start 'Loading...'
  fi
  _jsh_status_shell
  _jsh_status_repository
  _jsh_status_submodules
  _jsh_status_packages
  _jsh_doctor_collect
  _jsh_status_doctor_summaries
  _jsh_status_environment
  [[ "${porcelain}" == 1 ]] || jsh_spinner_hide

  if [[ "${porcelain}" == 1 ]]; then
    printf 'jsh-status\t1\tcomponent\tstate\tname\tdetail\n'
    cat "${JSH_STATUS_RECORDS}"
    if grep -Eq $'^[^\t]+\t(missing|changed|warning|error|failed)\t' "${JSH_STATUS_RECORDS}"; then result=1; fi
  else
    _jsh_status_render "${verbose}" || result=$?
  fi
  if [[ "${JSH_STATUS_RESULT_POLICY:-status}" == doctor ]]; then
    result=0
    if awk -F '\t' '$2 == "required" && $4 == "missing" { found=1 } END { exit !found }' \
      "${JSH_DOCTOR_RECORDS}"; then
      result=1
    elif [[ "${JSH_STATUS_DOCTOR_STRICT:-0}" == 1 ]] \
      && grep -Eq $'\t(optional-missing|unsupported)\t' "${JSH_DOCTOR_RECORDS}"; then
      result=1
    fi
  fi
  rm -rf "${work_dir}"
  return "${result}"
}

_jsh_audit_contains() {
  local needle="$1" item
  while IFS= read -r item; do
    [[ "${item}" != "${needle}" ]] || return 0
  done <<<"$2"
  return 1
}

_jsh_audit_manifests() {
  local host platform_manifest manifest
  host=${JSH_AUDIT_HOSTNAME:-$(hostname -s 2>/dev/null || true)}
  host=$(printf '%s' "${host}" | tr '[:upper:]' '[:lower:]')
  case "$(uname -s 2>/dev/null)" in
    Darwin) platform_manifest="${JSH_DIR}/config/homebrew/Brewfile.macos" ;;
    Linux) platform_manifest="${JSH_DIR}/config/homebrew/Brewfile.linux" ;;
    *) platform_manifest= ;;
  esac
  for manifest in \
    "${JSH_DIR}/config/homebrew/Brewfile" \
    "${JSH_DIR}/config/homebrew/Brewfile.core" \
    "${JSH_DIR}/config/homebrew/Brewfile.contrib" \
    "${platform_manifest}" \
    "${JSH_DIR}/config/homebrew/Brewfile.${host}"; do
    [[ -n "${manifest}" && -r "${manifest}" ]] && printf '%s\n' "${manifest}"
  done
}

_jsh_audit_declared() {
  local kind="$1" manifest value
  while IFS= read -r manifest; do
    while IFS= read -r value; do
      [[ "${kind}" != brew ]] || value=${value##*/}
      printf '%s\n' "${value}"
    done < <(sed -n "s/^[[:space:]]*${kind}[[:space:]]*\"\([^\"]*\)\".*/\1/p" "${manifest}")
  done < <(_jsh_audit_manifests)
}

_jsh_audit_collect() {
  local records="$1" declared_formulae declared_casks formula cask

  jsh_brew_path_for_component
  command -v brew >/dev/null 2>&1 || {
    _jsh_error 'Homebrew or Linuxbrew is required for jsh audit'
    return 1
  }

  declared_formulae=$(_jsh_audit_declared brew)
  declared_casks=$(_jsh_audit_declared cask)

  while IFS= read -r formula; do
    [[ -n "${formula}" ]] || continue
    _jsh_audit_contains "${formula##*/}" "${declared_formulae}" \
      || printf 'formula\t%s\n' "${formula}" >>"${records}"
  done < <(brew leaves 2>/dev/null)

  while IFS= read -r cask; do
    [[ -n "${cask}" ]] || continue
    _jsh_audit_contains "${cask}" "${declared_casks}" \
      || printf 'cask\t%s\n' "${cask}" >>"${records}"
  done < <(brew list --cask -1 2>/dev/null)
}

_jsh_audit_render_group() {
  local category="$1" heading="$2" empty="$3" names columns
  names="${JSH_AUDIT_WORK_DIR}/${category}"
  awk -F '\t' -v category="${category}" '$1 == category { print $2 }' \
    "${JSH_AUDIT_RECORDS}" >"${names}"
  _jsh_ui_heading "${heading}"
  if [[ ! -s "${names}" ]]; then
    _jsh_ui_row current "${empty}"
    return
  fi
  columns=${COLUMNS:-}
  if [[ ! "${columns}" =~ ^[0-9]+$ || "${columns}" -lt 20 ]]; then
    columns=$(tput cols 2>/dev/null || printf 80)
  fi
  awk -v width="${columns}" '
    { item[NR] = $0 }
    END {
      for (candidate = NR; candidate >= 1; candidate--) {
        rows = int((NR + candidate - 1) / candidate)
        total = (candidate - 1) * 2
        for (column = 0; column < candidate; column++) {
          column_width[column] = 0
          for (row = 1; row <= rows; row++) {
            item_index = row + column * rows
            if (item_index <= NR && length(item[item_index]) > column_width[column])
              column_width[column] = length(item[item_index])
          }
          total += column_width[column]
        }
        if (total <= width) break
      }
      for (row = 1; row <= rows; row++) {
        for (column = 0; column < candidate; column++) {
          item_index = row + column * rows
          if (item_index > NR) continue
          next_item = row + (column + 1) * rows
          if (next_item <= NR)
            printf "%-*s  ", column_width[column], item[item_index]
          else
            print item[item_index]
        }
      }
    }
  ' "${names}"
}

_jsh_audit_remove() {
  local category name failures=0 total
  local -a formulae=() casks=()
  while IFS=$'\t' read -r category name; do
    case "${category}" in
      formula) formulae+=("${name}") ;;
      cask) casks+=("${name}") ;;
    esac
  done <"${JSH_AUDIT_RECORDS}"
  total=$((${#formulae[@]} + ${#casks[@]}))
  ((total > 0)) || return 0

  [[ -t 1 && -r /dev/tty && -w /dev/tty ]] || {
    _jsh_ui_row note 'Run jsh audit in a terminal to remove unmanaged items'
    return 0
  }

  _jsh_ui_heading Remove
  jsh_read_key "Uninstall all ${total} unmanaged Homebrew items? [y/N] " || return 130
  case "${JSH_KEY}" in y | Y) ;; *) return 0 ;; esac
  if ((${#formulae[@]})) && ! brew uninstall "${formulae[@]}"; then
    failures=$((failures + 1))
  fi
  if ((${#casks[@]})) && ! brew uninstall --cask "${casks[@]}"; then
    failures=$((failures + 1))
  fi
  ((failures > 0)) || _jsh_ui_row removed "${total} Homebrew items"
  ((failures == 0))
}

_jsh_audit() {
  local work_dir result=0
  (($# == 0)) || {
    _jsh_error "unknown audit option: $1"
    return 2
  }
  case "$(uname -s 2>/dev/null)" in Darwin | Linux) ;; *)
    _jsh_error 'jsh audit supports macOS and Linux only'
    return 2
    ;;
  esac

  mkdir -p "${JSH_DIR}/tmp" || return 1
  work_dir=$(mktemp -d "${JSH_DIR}/tmp/jsh-audit.XXXXXX") || return 1
  JSH_AUDIT_WORK_DIR=${work_dir}
  JSH_AUDIT_RECORDS="${work_dir}/records"
  : >"${JSH_AUDIT_RECORDS}"
  _jsh_banner Audit
  jsh_spinner_start 'Loading...'
  _jsh_audit_collect "${JSH_AUDIT_RECORDS}" || result=$?
  jsh_spinner_hide
  if ((result == 0)); then
    _jsh_banner Audit
    _jsh_audit_render_group formula Formulae 'No unmanaged formulae'
    _jsh_audit_render_group cask Casks 'No unmanaged casks'
    _jsh_audit_remove || result=$?
  fi
  rm -rf "${work_dir}"
  return "${result}"
}

_jsh_repair() {
  local dry_run=0 mode=unconfigured line source destination backup temporary
  local pruned=0 retained=0 suffix
  while (($# > 0)); do
    case "$1" in
      --dry-run | -n) dry_run=1 ;;
      *)
        _jsh_error "unknown repair option: $1"
        return 2
        ;;
    esac
    shift
  done

  _jsh_ui_heading Repair

  if [[ ! -r "${JSH_LINK_STATE}" ]]; then
    _jsh_message current 'nothing to repair'
    return 0
  fi
  [[ ! -r "${JSH_MODE_FILE}" ]] || IFS= read -r mode <"${JSH_MODE_FILE}"
  temporary="${JSH_LINK_STATE}.repair.$$"
  [[ "${dry_run}" == 1 ]] || : >"${temporary}" || return 1

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" != *'|'* ]]; then
      [[ -z "${line}" ]] || pruned=$((pruned + 1))
      continue
    fi
    IFS='|' read -r source destination backup <<<"${line}"
    if [[ -z "${source}" || -z "${destination}" ]]; then
      pruned=$((pruned + 1))
      continue
    fi
    if _jsh_managed_entry_is_stale "${mode}" "${source}" "${destination}"; then
      if [[ ! -e "${destination}" && ! -L "${destination}" ]] \
        && { [[ -z "${backup}" ]] || { [[ ! -e "${backup}" && ! -L "${backup}" ]]; }; }; then
        pruned=$((pruned + 1))
        continue
      fi
      retained=$((retained + 1))
    fi
    [[ "${dry_run}" == 1 ]] || printf '%s\n' "${line}" >>"${temporary}" || {
      rm -f "${temporary}"
      return 1
    }
  done <"${JSH_LINK_STATE}"

  if [[ "${dry_run}" != 1 ]]; then
    if ((pruned > 0)); then
      mv "${temporary}" "${JSH_LINK_STATE}" || return 1
    else rm -f "${temporary}"; fi
  fi
  [[ "${pruned}" == 1 ]] && suffix= || suffix=s
  if [[ "${dry_run}" == 1 ]]; then
    _jsh_message plan "would prune ${pruned} stale managed-link record${suffix}"
  else
    _jsh_message pruned "${pruned} stale managed-link record${suffix}"
  fi
  if ((retained > 0)); then
    [[ "${retained}" == 1 ]] && suffix= || suffix=s
    _jsh_message retained "${retained} stale record${suffix} with a live destination or backup"
    return 1
  fi
}

_jsh_doctor_record() {
  local component="$1" classification="$2" name="$3" detail="$4"
  printf '%s\t%s\t%s\t%s\n' "${component}" "${classification}" "${name}" "${detail}" >>"${JSH_DOCTOR_RECORDS}"
}

_jsh_doctor_command() {
  local component="$1" name="$2" command_name="$3" detail="$4"
  if command -v "${command_name}" >/dev/null 2>&1; then
    _jsh_doctor_record "${component}" available "${name}" "${detail}"
  else
    _jsh_doctor_record "${component}" optional-missing "${name}" "${detail}"
  fi
}

_jsh_doctor_path() {
  local component="$1" name="$2" path="$3" detail="$4"
  if [[ -e "${path}" ]]; then
    _jsh_doctor_record "${component}" available "${name}" "${detail}"
  else
    _jsh_doctor_record "${component}" optional-missing "${name}" "${detail}"
  fi
}

_jsh_doctor_yq() {
  if command -v yq >/dev/null 2>&1 && yq --version 2>/dev/null | grep -Eq 'version v?4([.]|$)'; then
    _jsh_doctor_record commands available yq 'Mike Farah yq v4'
  else
    _jsh_doctor_record commands optional-missing yq 'Mike Farah yq v4 is required by kubedectl and metadata tasks'
  fi
}

_jsh_doctor_zsh() {
  local zsh_path brew_prefix='' version variant=system _name
  zsh_path=$(command -v zsh 2>/dev/null) || {
    _jsh_doctor_record runtime optional-missing zsh 'enhanced interactive shell'
    return
  }
  version=$("${zsh_path}" --version 2>/dev/null || true)
  read -r _name version _ <<<"${version}"
  if command -v brew >/dev/null 2>&1; then
    brew_prefix=$(brew --prefix 2>/dev/null || true)
    [[ -z "${brew_prefix}" || "${zsh_path}" != "${brew_prefix}/"* ]] || variant=Homebrew
  fi
  _jsh_doctor_record runtime available zsh "${variant} zsh ${version:-unknown}"
}

_jsh_doctor_label() {
  case "$1" in
    base) printf 'Core' ;;
    runtime) printf 'Runtime' ;;
    vendor) printf 'Vendored assets' ;;
    installer) printf 'Installer' ;;
    commands) printf 'Commands' ;;
    editors) printf 'Editors' ;;
    network) printf 'Network operations' ;;
    *) printf '%s' "$1" ;;
  esac
}

_jsh_doctor_render() {
  local component classification name detail status label total=0

  for component in base runtime vendor installer commands editors network; do
    total=0
    while IFS=$'\t' read -r classification name detail; do
      total=$((total + 1))
    done < <(awk -F '\t' -v component="${component}" '$1 == component { print $2 "\t" $3 "\t" $4 }' "${JSH_DOCTOR_RECORDS}")
    ((total > 0)) || continue

    label=$(_jsh_doctor_label "${component}")
    _jsh_ui_heading "${label}"
    while IFS=$'\t' read -r classification name detail; do
      case "${classification}:${detail}" in
        required:missing) status=error ;;
        optional-missing:*) status=warning ;;
        network-only:*) status=note ;;
        *) status=current ;;
      esac
      _jsh_ui_row "${status}" "${name}" "${detail}" muted
    done < <(awk -F '\t' -v component="${component}" '$1 == component { print $2 "\t" $3 "\t" $4 }' "${JSH_DOCTOR_RECORDS}")
  done
}

_jsh_doctor_collect() {
  local name
  if command -v bash >/dev/null 2>&1; then
    _jsh_doctor_record base required bash available
  else
    _jsh_doctor_record base required bash missing
  fi
  for name in bin/jsh dotfiles/.bashrc dotfiles/.zshrc; do
    if [[ -f "${JSH_DIR}/${name}" ]]; then
      _jsh_doctor_record base required "${name}" available
    else
      _jsh_doctor_record base required "${name}" missing
    fi
  done

  _jsh_doctor_zsh
  _jsh_doctor_path vendor fzf-tab "${JSH_DIR}/vendor/fzf-tab/fzf-tab.plugin.zsh" 'Zsh completion plugin source'
  _jsh_doctor_path vendor zsh-completions "${JSH_DIR}/vendor/zsh-completions/src" 'additional Zsh completion source'
  _jsh_doctor_path vendor zsh-plugins "${JSH_DIR}/vendor/zsh-plugins/zsh-autosuggestions.zsh" 'tracked Zsh plugin source'
  _jsh_doctor_path vendor vim-plug "${JSH_DIR}/vendor/vim-config/autoload/plug.vim" 'Vim plugin manager source'
  _jsh_doctor_command installer git git 'clone and update network operation'
  _jsh_doctor_command installer curl curl 'web installer download'
  _jsh_doctor_command commands gitx git 'Git operations; Bash 4+ also required'
  if ((BASH_VERSINFO[0] >= 4)); then
    _jsh_doctor_record commands available bash4 'gitx interpreter'
  else
    _jsh_doctor_record commands optional-missing bash4 'gitx requires Bash 4 or newer'
  fi
  _jsh_doctor_command commands jssh ssh 'SSH transport'
  _jsh_doctor_command commands archive tar 'JSSH capsule archive support'
  _jsh_doctor_command commands python3 python3 'httpstat interpreter'
  _jsh_doctor_command commands curl curl 'httpstat and proxy probes'
  _jsh_doctor_command commands docker docker 'dockerctl'
  _jsh_doctor_command commands kubectl kubectl 'kubectx, kubens, and nukem'
  _jsh_doctor_yq
  _jsh_doctor_command editors Vim vim 'core Vim editor'
  _jsh_doctor_command editors Neovim nvim 'managed wrapper; plugins require explicit network bootstrap'
  _jsh_doctor_record network network-only j.sh 'clones or updates the repository'
  _jsh_doctor_record network network-only editor-plugins 'Vim and Neovim plugin installation'
}

_jsh_doctor() {
  local strict=0 porcelain=0 work_dir component classification name detail result=0
  while (($# > 0)); do
    case "$1" in
      --strict) strict=1 ;;
      --porcelain) porcelain=1 ;;
      *)
        _jsh_error "unknown doctor option: $1"
        return 2
        ;;
    esac
    shift
  done

  if [[ "${porcelain}" == 0 ]]; then
    JSH_STATUS_RESULT_POLICY=doctor JSH_STATUS_DOCTOR_STRICT=${strict} _jsh_status --verbose
    return
  fi

  mkdir -p "${JSH_DIR}/tmp" || return 1
  work_dir=$(mktemp -d "${JSH_DIR}/tmp/jsh-doctor.XXXXXX") || return 1
  JSH_DOCTOR_RECORDS="${work_dir}/records"
  : >"${JSH_DOCTOR_RECORDS}"

  if command -v bash >/dev/null 2>&1; then
    _jsh_doctor_record base required bash 'available'
  else
    _jsh_doctor_record base required bash 'missing'
    result=1
  fi
  for name in bin/jsh dotfiles/.bashrc dotfiles/.zshrc; do
    if [[ -f "${JSH_DIR}/${name}" ]]; then
      _jsh_doctor_record base required "${name}" available
    else
      _jsh_doctor_record base required "${name}" missing
      result=1
    fi
  done

  _jsh_doctor_zsh
  _jsh_doctor_path vendor fzf-tab "${JSH_DIR}/vendor/fzf-tab/fzf-tab.plugin.zsh" 'Zsh completion plugin source'
  _jsh_doctor_path vendor zsh-completions "${JSH_DIR}/vendor/zsh-completions/src" 'additional Zsh completion source'
  _jsh_doctor_path vendor zsh-plugins "${JSH_DIR}/vendor/zsh-plugins/zsh-autosuggestions.zsh" 'tracked Zsh plugin source'
  _jsh_doctor_path vendor vim-plug "${JSH_DIR}/vendor/vim-config/autoload/plug.vim" 'Vim plugin manager source'

  _jsh_doctor_command installer git git 'clone and update network operation'
  _jsh_doctor_command installer curl curl 'web installer download'

  _jsh_doctor_command commands gitx git 'Git operations; Bash 4+ also required'
  if ((BASH_VERSINFO[0] >= 4)); then
    _jsh_doctor_record commands available bash4 'gitx interpreter'
  else
    _jsh_doctor_record commands optional-missing bash4 'gitx requires Bash 4 or newer'
  fi
  _jsh_doctor_command commands jssh ssh 'SSH transport'
  _jsh_doctor_command commands archive tar 'JSSH capsule archive support'
  _jsh_doctor_command commands python3 python3 'httpstat interpreter'
  _jsh_doctor_command commands curl curl 'httpstat and proxy probes'
  _jsh_doctor_command commands docker docker 'dockerctl'
  _jsh_doctor_command commands kubectl kubectl 'kubectx, kubens, and nukem'
  _jsh_doctor_yq
  _jsh_doctor_command editors Vim vim 'core Vim editor'
  _jsh_doctor_command editors Neovim nvim 'managed wrapper; plugins require explicit network bootstrap'
  _jsh_doctor_record network network-only j.sh 'clones or updates the repository'
  _jsh_doctor_record network network-only editor-plugins 'Vim and Neovim plugin installation'

  if [[ "${porcelain}" == 1 ]]; then
    printf 'jsh-doctor\t1\tcomponent\tclassification\tname\tdetail\n'
    cat "${JSH_DOCTOR_RECORDS}"
  else
    _jsh_doctor_render
  fi
  if [[ "${strict}" == 1 ]] && grep -Eq $'\t(optional-missing|unsupported)\t' "${JSH_DOCTOR_RECORDS}"; then
    result=1
  fi
  rm -rf "${work_dir}"
  return "${result}"
}

_jsh_uninstall() {
  local dry_run=0 source destination backup temporary failures=0
  while (($# > 0)); do
    case "$1" in --dry-run | -n) dry_run=1 ;; *) return 2 ;; esac
    shift
  done
  _jsh_ui_heading Uninstall
  [[ -r "${JSH_LINK_STATE}" ]] || {
    [[ "${dry_run}" == 1 ]] || rm -f "${JSH_MODE_FILE}"
    _jsh_message current 'nothing to uninstall'
    return 0
  }
  if [[ ! -s "${JSH_LINK_STATE}" ]]; then
    [[ "${dry_run}" == 1 ]] || rm -f "${JSH_LINK_STATE}" "${JSH_MODE_FILE}"
    _jsh_message current 'nothing to uninstall'
    return 0
  fi
  temporary="${JSH_LINK_STATE}.tmp.$$"
  [[ "${dry_run}" == 1 ]] || : >"${temporary}"
  while IFS='|' read -r source destination backup || [[ -n "${source}${destination}${backup}" ]]; do
    if ! _jsh_link_points_to "${source}" "${destination}" && [[ -e "${destination}" || -L "${destination}" ]]; then
      _jsh_message changed "retained ${destination}"
      failures=$((failures + 1))
      [[ "${dry_run}" == 1 ]] || printf '%s|%s|%s\n' "${source}" "${destination}" "${backup}" >>"${temporary}"
      continue
    fi
    if [[ -n "${backup}" && ! -e "${backup}" && ! -L "${backup}" ]]; then
      _jsh_message error "missing backup: ${backup}"
      failures=$((failures + 1))
      [[ "${dry_run}" == 1 ]] || printf '%s|%s|%s\n' "${source}" "${destination}" "${backup}" >>"${temporary}"
      continue
    fi
    if [[ "${dry_run}" == 1 ]]; then
      _jsh_message plan "remove ${destination}${backup:+ and restore backup}"
      continue
    fi
    if [[ -L "${destination}" ]]; then
      if [[ "${destination}" == /usr/local/bin/jsh && ! -w /usr/local/bin ]]; then
        if ! command -v sudo >/dev/null 2>&1 || ! sudo rm "${destination}"; then
          failures=$((failures + 1))
          printf '%s|%s|%s\n' "${source}" "${destination}" "${backup}" >>"${temporary}"
          continue
        fi
      else
        rm "${destination}" || {
          failures=$((failures + 1))
          continue
        }
      fi
    fi
    if [[ -n "${backup}" ]]; then
      mkdir -p "$(dirname "${destination}")" && mv "${backup}" "${destination}" || {
        failures=$((failures + 1))
        printf '%s|%s|%s\n' "${source}" "${destination}" "${backup}" >>"${temporary}"
        continue
      }
    fi
    _jsh_message removed "${destination}"
  done <"${JSH_LINK_STATE}"
  if [[ "${dry_run}" == 0 ]]; then
    if [[ -s "${temporary}" ]]; then
      mv "${temporary}" "${JSH_LINK_STATE}"
    else rm -f "${temporary}" "${JSH_LINK_STATE}" "${JSH_MODE_FILE}"; fi
  fi
  [[ "${failures}" == 0 ]]
}

# Canonical component reconciliation used by the public `jsh install` command.

# The curl bootstrap acquires a checkout and then hands control to this flow.

jsh_ui_init() {
  JSH_UI_RICH=0
  if [ "${JSH_PLAIN_OUTPUT:-0}" != 1 ] && [ "${TERM:-dumb}" != dumb ] && [ -z "${NO_COLOR+x}" ]; then
    case "${JSH_COLOR:-auto}" in
      always) JSH_UI_RICH=1 ;;
      auto) [ -t 1 ] && JSH_UI_RICH=1 ;;
    esac
  fi
  if [ "${JSH_UI_RICH}" = 1 ]; then
    JSH_UI_RESET=$(printf '\033[0m')
    JSH_UI_BOLD=$(printf '\033[1m')
    JSH_UI_DIM=$(printf '\033[2m')
    JSH_UI_RED=$(printf '\033[31m')
    JSH_UI_GREEN=$(printf '\033[32m')
    JSH_UI_YELLOW=$(printf '\033[33m')
    JSH_UI_CYAN=$(printf '\033[36m')
  else
    JSH_UI_RESET=''
    JSH_UI_BOLD=''
    JSH_UI_DIM=''
    JSH_UI_RED=''
    JSH_UI_GREEN=''
    JSH_UI_YELLOW=''
    JSH_UI_CYAN=''
  fi
}

jsh_ui_status() {
  case "$1" in
    current | success)
      JSH_UI_COLOR=${JSH_UI_GREEN}
      [ "${JSH_UI_RICH}" = 1 ] && JSH_UI_MARK='✔' || JSH_UI_MARK=ok
      ;;
    plan | planned | missing | changed)
      JSH_UI_COLOR=${JSH_UI_CYAN}
      [ "${JSH_UI_RICH}" = 1 ] && JSH_UI_MARK='➜' || JSH_UI_MARK=plan
      ;;
    warning)
      JSH_UI_COLOR=${JSH_UI_YELLOW}
      [ "${JSH_UI_RICH}" = 1 ] && JSH_UI_MARK='▲' || JSH_UI_MARK=warn
      ;;
    note)
      JSH_UI_COLOR=${JSH_UI_CYAN}
      [ "${JSH_UI_RICH}" = 1 ] && JSH_UI_MARK='›' || JSH_UI_MARK=note
      ;;
    info)
      JSH_UI_COLOR=${JSH_UI_DIM}
      [ "${JSH_UI_RICH}" = 1 ] && JSH_UI_MARK='•' || JSH_UI_MARK=info
      ;;
    skipped)
      JSH_UI_COLOR=${JSH_UI_DIM}
      [ "${JSH_UI_RICH}" = 1 ] && JSH_UI_MARK='–' || JSH_UI_MARK=skip
      ;;
    error)
      JSH_UI_COLOR=${JSH_UI_RED}
      [ "${JSH_UI_RICH}" = 1 ] && JSH_UI_MARK='✖' || JSH_UI_MARK=error
      ;;
    *)
      JSH_UI_COLOR=${JSH_UI_DIM}
      JSH_UI_MARK=$1
      ;;
  esac
}

jsh_ui_row() {
  status=$1
  message=$2
  stream=${3:-stdout}
  jsh_ui_init
  jsh_ui_status "${status}"
  [ "${JSH_UI_RICH}" = 1 ] || JSH_UI_MARK="[${JSH_UI_MARK}]"
  if [ "${stream}" = stderr ]; then
    printf '%s%s%s %s\n' "${JSH_UI_COLOR}" "${JSH_UI_MARK}" "${JSH_UI_RESET}" "${message}" >&2
  else
    printf '%s%s%s %s\n' "${JSH_UI_COLOR}" "${JSH_UI_MARK}" "${JSH_UI_RESET}" "${message}"
  fi
}

jsh_display_path() {
  case "$1" in
    "${HOME}") printf '~\n' ;;
    "${HOME}"/*) printf '%s/%s\n' '~' "${1#"${HOME}"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

jsh_display_repo() {
  case "$1" in
    [Hh][Tt][Tt][Pp]://* | [Hh][Tt][Tt][Pp][Ss]://*)
      printf '%s\n' "$1" | sed 's#^\([^:]*://\)[^/@]*@#\1#'
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

jsh_ui_text() {
  REPLY_TEXT=$1
  case "${REPLY_TEXT}" in
    "${HOME}") REPLY_TEXT='~' ;;
    "${HOME}"/*) REPLY_TEXT=$(printf '%s/%s' '~' "${REPLY_TEXT#"${HOME}"/}") ;;
  esac
}

jsh_ui_heading() {
  JSH_UI_HEADING_SEPARATOR='\n'
  [ "${2:-}" != after-banner ] || JSH_UI_HEADING_SEPARATOR=
  jsh_ui_init
  printf '%b%s%s%s%s\n' "${JSH_UI_HEADING_SEPARATOR}" \
    "${JSH_UI_BOLD}" "${JSH_UI_CYAN}" "$1" "${JSH_UI_RESET}"
}

jsh_banner() {
  jsh_ui_init
  printf '\n%s%s' "${JSH_UI_BOLD}" "${JSH_UI_CYAN}"
  cat <<'BANNER'
   :%@@@@@@@@@#*#@%-              +-:##
  :#    -#%%+=#:@#                :@@%:
   %@@     +@++@@-            *-   @@%:
          *@%:%@@:    :%@@@@*%+  *@@@%::*@@#
     -###%@@+:%@@:  :%@#:--=%:    -@@@#: #@@=
       :#@@@+:%@@:  :%@#  -#-     -@@%   *@@=
      *#:#@@+:%@@:  :%@@@@@@@@*   -@@%   *@@=
       -#@@@+:%@%:     *%  -@@*   -@@%   *@@=
         :@@+:%@*     -*   -@@*   -@@%   *@@=
          +@+:%*     *@@@@@%@%-   #@@@+  *@@-
   :==--::*#:#-     -:   -*:        +   =@@=
 :@@@@@@@@#@-                         +@#:
 =   :-=-:                          -:
BANNER
  printf '%s\n' "${JSH_UI_RESET}"
}

jsh_spinner_start() {
  JSH_SPINNER_LABEL=$1
  JSH_SPINNER_STARTED=$(date +%s 2>/dev/null || printf 0)
  JSH_SPINNER_PID=
  jsh_ui_init
  case "${JSH_SPINNER:-auto}" in
    never) return 0 ;;
    always) ;;
    *) [ -t 2 ] || return 0 ;;
  esac

  (
    visible=0
    trap '[ "${visible}" = 0 ] || printf "\033[?25h\r\033[K" >&2' 0
    trap 'exit 0' 1 2 15
    sleep "${JSH_SPINNER_DELAY:-0.15}"
    visible=1
    frame=0
    printf '\033[?25l' >&2
    while :; do
      case "${frame}" in
        0) glyph='⠋' ;; 1) glyph='⠙' ;; 2) glyph='⠹' ;; 3) glyph='⠸' ;; 4) glyph='⠼' ;;
        5) glyph='⠴' ;; 6) glyph='⠦' ;; 7) glyph='⠧' ;; 8) glyph='⠇' ;; *) glyph='⠏' ;;
      esac
      printf '\r\033[K%s %s' "${glyph}" "${JSH_SPINNER_LABEL}" >&2
      frame=$(((frame + 1) % 10))
      sleep 0.1
    done
  ) &
  JSH_SPINNER_PID=$!
}

jsh_spinner_cleanup() {
  if [ -n "${JSH_SPINNER_PID:-}" ]; then
    kill "${JSH_SPINNER_PID}" 2>/dev/null || true
    wait "${JSH_SPINNER_PID}" 2>/dev/null || true
    JSH_SPINNER_PID=
  fi
}

jsh_spinner_hide() {
  jsh_spinner_cleanup
}

jsh_spinner_exec() {
  spinner_output=$1
  shift
  if [ -n "${JSH_SPINNER_PID:-}" ]; then
    "$@" >"${spinner_output}" 2>&1
  else
    "$@"
  fi
}

jsh_spinner_stop() {
  spinner_status=$1
  spinner_label=$2
  jsh_spinner_cleanup
  spinner_finished=$(date +%s 2>/dev/null || printf 0)
  spinner_elapsed=$((spinner_finished - JSH_SPINNER_STARTED))
  [ "${spinner_elapsed}" -ge 0 ] || spinner_elapsed=0
  if [ "${spinner_elapsed}" -ge 5 ]; then
    spinner_label="${spinner_label} (${spinner_elapsed}s)"
  fi
  if [ "${spinner_status}" = error ]; then
    jsh_ui_row error "${spinner_label}" stderr
  else
    jsh_ui_row "${spinner_status}" "${spinner_label}"
  fi
}

fail() {
  jsh_ui_init
  jsh_ui_status error
  if [ "${JSH_UI_RICH}" = 1 ]; then
    printf '%s%s%s jsh: %s\n' "${JSH_UI_COLOR}" "${JSH_UI_MARK}" "${JSH_UI_RESET}" "$*" >&2
  else
    printf '[%s] jsh: %s\n' "${JSH_UI_MARK}" "$*" >&2
  fi
  exit 1
}

JSH_TTY_STATE=

jsh_tty_restore() {
  if [ -n "${JSH_TTY_STATE}" ]; then
    stty "${JSH_TTY_STATE}" </dev/tty 2>/dev/null || true
    JSH_TTY_STATE=
  fi
}

jsh_read_key() {
  prompt=$1
  JSH_KEY=
  printf '%s' "${prompt}" >/dev/tty
  if command -v stty >/dev/null 2>&1 && command -v dd >/dev/null 2>&1 \
    && JSH_TTY_STATE=$(stty -g </dev/tty 2>/dev/null); then
    stty -icanon -echo min 1 time 0 </dev/tty
    JSH_KEY=$(dd bs=1 count=1 </dev/tty 2>/dev/null || true)
    jsh_tty_restore
  else
    IFS= read -r JSH_KEY </dev/tty || return 1
  fi
  printf '\n' >/dev/tty
}

jsh_interrupted() {
  trap - 1 2 15
  jsh_spinner_cleanup
  jsh_tty_restore
  jsh_ui_row error 'Interrupted' stderr
  exit 130
}

choose_mode() {
  if [ -n "${JSH_MODE:-}" ]; then
    case "${JSH_MODE}" in lite | full) return 0 ;; *) fail 'JSH_MODE must be lite or full' ;; esac
  fi

  if [ -t 1 ] && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    jsh_ui_init
    printf '%s%sChoose a setup mode%s\n' "${JSH_UI_BOLD}" "${JSH_UI_CYAN}" "${JSH_UI_RESET}" >/dev/tty
    case "${COLUMNS:-}" in
      '' | *[!0-9]*) narrow=0 ;;
      *) [ "${COLUMNS}" -lt 72 ] && narrow=1 || narrow=0 ;;
    esac
    if [ "${narrow}" = 1 ]; then
      printf '  %sL%s  Lite\n      Isolated shell without HOME config links\n' \
        "${JSH_UI_CYAN}" "${JSH_UI_RESET}" >/dev/tty
      printf '  %sF%s  Full\n      Reversible HOME, XDG, and VS Code config links\n' \
        "${JSH_UI_CYAN}" "${JSH_UI_RESET}" >/dev/tty
    else
      printf '  %sL%s  Lite  Isolated shell without HOME config links\n' \
        "${JSH_UI_CYAN}" "${JSH_UI_RESET}" >/dev/tty
      printf '  %sF%s  Full  Reversible HOME, XDG, and VS Code config links\n' \
        "${JSH_UI_CYAN}" "${JSH_UI_RESET}" >/dev/tty
    fi
    jsh_read_key 'Mode [L]: ' || exit 130
    case "${JSH_KEY}" in
      '' | l | L) JSH_MODE=lite ;;
      f | F) JSH_MODE=full ;;
      *) fail 'Selection must be L or F' ;;
    esac
    export JSH_MODE
    return 0
  fi

  fail 'Noninteractive installation requires JSH_MODE=lite or JSH_MODE=full'
}

jsh_parse_options() {
  JSH_ASSUME_YES=0
  JSH_DRY_RUN=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --mode)
        [ "$#" -ge 2 ] || fail 'Missing value for --mode'
        case "$2" in
          lite | runtime) JSH_MODE=lite ;;
          full | install) JSH_MODE=full ;;
          *) fail 'Mode must be lite or full' ;;
        esac
        shift
        ;;
      --mode=*)
        case "${1#*=}" in
          lite | runtime) JSH_MODE=lite ;;
          full | install) JSH_MODE=full ;;
          *) fail 'Mode must be lite or full' ;;
        esac
        ;;
      --yes | -y) JSH_ASSUME_YES=1 ;;
      --dry-run | -n) JSH_DRY_RUN=1 ;;
      *)
        jsh_ui_row error "Unknown installer option '$1'" stderr
        printf 'Usage: jsh install [--mode lite|full] [-n|--dry-run] [-y|--yes]\n' >&2
        jsh_ui_row note 'Run jsh install --dry-run to preview installation' stderr
        exit 2
        ;;
    esac
    shift
  done
}

# The setup flow is deliberately data-driven.  Checks only describe the
# state of a component; apply functions are called later, after the complete
# plan has been rendered and the user has approved the applicable actions.
jsh_component_registry() {
  cat <<'JSH_COMPONENT_REGISTRY'
host|Host prerequisites||jsh_component_check_host|verify host prerequisites|jsh_component_apply_host|both
checkout|Git checkout|host|jsh_component_check_checkout|clone or fast-forward the checkout|jsh_component_apply_checkout|both
xcode|Apple Command Line Tools|host|jsh_component_check_xcode|install Apple Command Line Tools when missing|jsh_component_apply_xcode|full
brew|Homebrew / Linuxbrew|host xcode|jsh_component_check_brew|install Homebrew / Linuxbrew when missing|jsh_component_apply_brew|full
core|Core dependencies|host checkout xcode brew|jsh_component_check_core|install formulas from Brewfile.core|jsh_component_apply_core|full
vendor|Submodules and vendored assets|host checkout|jsh_component_check_vendor|initialize submodules and restore vendored assets|jsh_component_apply_vendor|full
launcher|Launcher|host checkout|jsh_component_check_launcher|link the jsh launcher safely|jsh_component_apply_launcher|both
config|Managed configuration|host checkout vendor launcher|jsh_component_check_config|link HOME, XDG, and VS Code configuration safely|jsh_component_apply_config|full
JSH_COMPONENT_REGISTRY
}

jsh_component_mode_allowed() {
  case "$1" in
    both) return 0 ;;
    full) [ "${JSH_MODE}" = full ] ;;
    *) return 1 ;;
  esac
}

jsh_component_set() {
  component_name=$1
  component_state=$2
  component_detail=$3
  component_action=${4:-}
  case "${component_name}" in
    host)
      JSH_STATE_host=${component_state}
      JSH_DETAIL_host=${component_detail}
      JSH_ACTION_host=${component_action}
      ;;
    checkout)
      JSH_STATE_checkout=${component_state}
      JSH_DETAIL_checkout=${component_detail}
      JSH_ACTION_checkout=${component_action}
      ;;
    xcode)
      JSH_STATE_xcode=${component_state}
      JSH_DETAIL_xcode=${component_detail}
      JSH_ACTION_xcode=${component_action}
      ;;
    brew)
      JSH_STATE_brew=${component_state}
      JSH_DETAIL_brew=${component_detail}
      JSH_ACTION_brew=${component_action}
      ;;
    core)
      JSH_STATE_core=${component_state}
      JSH_DETAIL_core=${component_detail}
      JSH_ACTION_core=${component_action}
      ;;
    vendor)
      JSH_STATE_vendor=${component_state}
      JSH_DETAIL_vendor=${component_detail}
      JSH_ACTION_vendor=${component_action}
      ;;
    launcher)
      JSH_STATE_launcher=${component_state}
      JSH_DETAIL_launcher=${component_detail}
      JSH_ACTION_launcher=${component_action}
      ;;
    config)
      JSH_STATE_config=${component_state}
      JSH_DETAIL_config=${component_detail}
      JSH_ACTION_config=${component_action}
      ;;
  esac
}

jsh_component_state() {
  case "$1" in
    host) printf '%s\n' "${JSH_STATE_host:-skipped}" ;;
    checkout) printf '%s\n' "${JSH_STATE_checkout:-skipped}" ;;
    xcode) printf '%s\n' "${JSH_STATE_xcode:-skipped}" ;;
    brew) printf '%s\n' "${JSH_STATE_brew:-skipped}" ;;
    core) printf '%s\n' "${JSH_STATE_core:-skipped}" ;;
    vendor) printf '%s\n' "${JSH_STATE_vendor:-skipped}" ;;
    launcher) printf '%s\n' "${JSH_STATE_launcher:-skipped}" ;;
    config) printf '%s\n' "${JSH_STATE_config:-skipped}" ;;
  esac
}

jsh_component_detail() {
  case "$1" in
    host) printf '%s\n' "${JSH_DETAIL_host:-}" ;;
    checkout) printf '%s\n' "${JSH_DETAIL_checkout:-}" ;;
    xcode) printf '%s\n' "${JSH_DETAIL_xcode:-}" ;;
    brew) printf '%s\n' "${JSH_DETAIL_brew:-}" ;;
    core) printf '%s\n' "${JSH_DETAIL_core:-}" ;;
    vendor) printf '%s\n' "${JSH_DETAIL_vendor:-}" ;;
    launcher) printf '%s\n' "${JSH_DETAIL_launcher:-}" ;;
    config) printf '%s\n' "${JSH_DETAIL_config:-}" ;;
  esac
}

jsh_component_action() {
  case "$1" in
    host) printf '%s\n' "${JSH_ACTION_host:-}" ;;
    checkout) printf '%s\n' "${JSH_ACTION_checkout:-}" ;;
    xcode) printf '%s\n' "${JSH_ACTION_xcode:-}" ;;
    brew) printf '%s\n' "${JSH_ACTION_brew:-}" ;;
    core) printf '%s\n' "${JSH_ACTION_core:-}" ;;
    vendor) printf '%s\n' "${JSH_ACTION_vendor:-}" ;;
    launcher) printf '%s\n' "${JSH_ACTION_launcher:-}" ;;
    config) printf '%s\n' "${JSH_ACTION_config:-}" ;;
  esac
}

jsh_component_set_approved() {
  case "$1" in
    host) JSH_APPROVED_host=$2 ;;
    checkout) JSH_APPROVED_checkout=$2 ;;
    xcode) JSH_APPROVED_xcode=$2 ;;
    brew) JSH_APPROVED_brew=$2 ;;
    core) JSH_APPROVED_core=$2 ;;
    vendor) JSH_APPROVED_vendor=$2 ;;
    launcher) JSH_APPROVED_launcher=$2 ;;
    config) JSH_APPROVED_config=$2 ;;
  esac
}

jsh_component_approved() {
  case "$1" in
    host) [ "${JSH_APPROVED_host:-0}" = 1 ] ;;
    checkout) [ "${JSH_APPROVED_checkout:-0}" = 1 ] ;;
    xcode) [ "${JSH_APPROVED_xcode:-0}" = 1 ] ;;
    brew) [ "${JSH_APPROVED_brew:-0}" = 1 ] ;;
    core) [ "${JSH_APPROVED_core:-0}" = 1 ] ;;
    vendor) [ "${JSH_APPROVED_vendor:-0}" = 1 ] ;;
    launcher) [ "${JSH_APPROVED_launcher:-0}" = 1 ] ;;
    config) [ "${JSH_APPROVED_config:-0}" = 1 ] ;;
    *) return 1 ;;
  esac
}

jsh_component_set_succeeded() {
  case "$1" in
    host) JSH_SUCCEEDED_host=$2 ;;
    checkout) JSH_SUCCEEDED_checkout=$2 ;;
    xcode) JSH_SUCCEEDED_xcode=$2 ;;
    brew) JSH_SUCCEEDED_brew=$2 ;;
    core) JSH_SUCCEEDED_core=$2 ;;
    vendor) JSH_SUCCEEDED_vendor=$2 ;;
    launcher) JSH_SUCCEEDED_launcher=$2 ;;
    config) JSH_SUCCEEDED_config=$2 ;;
  esac
}

jsh_component_succeeded() {
  case "$1" in
    host) [ "${JSH_SUCCEEDED_host:-0}" = 1 ] ;;
    checkout) [ "${JSH_SUCCEEDED_checkout:-0}" = 1 ] ;;
    xcode) [ "${JSH_SUCCEEDED_xcode:-0}" = 1 ] ;;
    brew) [ "${JSH_SUCCEEDED_brew:-0}" = 1 ] ;;
    core) [ "${JSH_SUCCEEDED_core:-0}" = 1 ] ;;
    vendor) [ "${JSH_SUCCEEDED_vendor:-0}" = 1 ] ;;
    launcher) [ "${JSH_SUCCEEDED_launcher:-0}" = 1 ] ;;
    config) [ "${JSH_SUCCEEDED_config:-0}" = 1 ] ;;
    *) return 1 ;;
  esac
}

jsh_component_is_actionable() {
  case "$1" in
    missing | changed | planned) return 0 ;;
    *) return 1 ;;
  esac
}

jsh_component_dependencies_allowed() {
  JSH_DEPENDENCY_REASON=
  for dependency_name in $1; do
    dependency_state=$(jsh_component_state "${dependency_name}")
    case "${dependency_state}" in
      error | skipped)
        JSH_DEPENDENCY_REASON="${dependency_name} is ${dependency_state}"
        return 1
        ;;
    esac
  done
  return 0
}

jsh_component_dependencies_checkable() {
  JSH_DEPENDENCY_REASON=
  for dependency_name in $1; do
    dependency_state=$(jsh_component_state "${dependency_name}")
    case "${dependency_state}" in
      skipped)
        JSH_DEPENDENCY_REASON="${dependency_name} was skipped"
        return 1
        ;;
      error)
        case "${dependency_name}" in
          host)
            JSH_DEPENDENCY_REASON="${dependency_name} is ${dependency_state}"
            return 1
            ;;
          *) ;;
        esac
        ;;
    esac
  done
  return 0
}

jsh_component_dependencies_ready_to_apply() {
  JSH_DEPENDENCY_REASON=
  for dependency_name in $1; do
    if ! jsh_component_approved "${dependency_name}" || ! jsh_component_succeeded "${dependency_name}"; then
      JSH_DEPENDENCY_REASON="${dependency_name} was not completed"
      return 1
    fi
  done
  return 0
}

jsh_component_initialize() {
  for component_name in host checkout xcode brew core vendor launcher config; do
    jsh_component_set "${component_name}" skipped 'not evaluated' ''
    jsh_component_set_approved "${component_name}" 0
    jsh_component_set_succeeded "${component_name}" 0
  done
}

jsh_component_seed_current() {
  while IFS='|' read -r component_name component_display component_dependencies component_check _component_plan component_apply component_modes; do
    jsh_component_mode_allowed "${component_modes}" || continue
    component_state=$(jsh_component_state "${component_name}")
    case "${component_state}" in
      current | warning)
        jsh_component_set_approved "${component_name}" 1
        jsh_component_set_succeeded "${component_name}" 1
        ;;
    esac
  done <<JSH_COMPONENTS
$(jsh_component_registry)
JSH_COMPONENTS
}

jsh_component_core_formulas() {
  core_file="${JSH_SOURCE_ROOT}/config/homebrew/Brewfile.core"
  JSH_CORE_FORMULAS=
  if [ -r "${core_file}" ]; then
    JSH_CORE_FORMULAS=$(sed -n 's/^[[:space:]]*brew[[:space:]]*"\([^"]*\)".*/\1/p' "${core_file}")
  fi
  [ -n "${JSH_CORE_FORMULAS}" ] || JSH_CORE_FORMULAS='go-task jq just'
  core_has_zsh=0
  for formula_name in ${JSH_CORE_FORMULAS}; do
    [ "${formula_name}" = zsh ] && core_has_zsh=1
  done
  [ "${core_has_zsh}" = 1 ] || JSH_CORE_FORMULAS="${JSH_CORE_FORMULAS} zsh"
  JSH_CORE_MISSING_FORMULAS=
  for formula_name in ${JSH_CORE_FORMULAS}; do
    case "${formula_name}" in
      go-task) core_command_name=task ;;
      *) core_command_name=${formula_name} ;;
    esac
    if ! command -v "${core_command_name}" >/dev/null 2>&1; then
      JSH_CORE_MISSING_FORMULAS="${JSH_CORE_MISSING_FORMULAS}${JSH_CORE_MISSING_FORMULAS:+ }${formula_name}"
    fi
  done
}

jsh_component_vendor_needs_network() {
  [ "${JSH_MODE}" = full ] || return 1
  [ -d "${install_dir}" ] || return 0
  [ -r "${install_dir}/.gitmodules" ] || return 0
  submodule_paths=$(git -C "${install_dir}" config --file .gitmodules --get-regexp '\.path$' 2>/dev/null | sed 's/^[^ ]* //') || true
  for submodule_path in ${submodule_paths}; do
    submodule_status=$(git -C "${install_dir}" submodule status -- "${submodule_path}" 2>/dev/null || true)
    case "${submodule_status}" in
      -* | +* | U*) return 0 ;;
    esac
    [ -d "${install_dir}/${submodule_path}" ] || return 0
  done
  for vendored_asset in \
    vendor/fzf/install \
    vendor/fzf/bin/fzf \
    vendor/fzf-tab/fzf-tab.plugin.zsh \
    vendor/zsh-completions/src \
    vendor/zsh-plugins/zsh-autosuggestions.zsh \
    vendor/vim-config/autoload/plug.vim; do
    [ -e "${install_dir}/${vendored_asset}" ] || return 0
  done
  return 1
}

jsh_component_local_upstream() {
  JSH_CHECKOUT_REMOTE=
  JSH_CHECKOUT_REF=
  checkout_branch=$(git -C "${install_dir}" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  [ -n "${checkout_branch}" ] || return 1
  checkout_remote=$(git -C "${install_dir}" config --get \
    "branch.${checkout_branch}.remote" 2>/dev/null || true)
  checkout_merge_ref=$(git -C "${install_dir}" config --get \
    "branch.${checkout_branch}.merge" 2>/dev/null || true)
  [ -n "${checkout_remote}" ] || checkout_remote=origin
  [ "${checkout_remote}" != . ] || return 1
  git -C "${install_dir}" remote get-url "${checkout_remote}" >/dev/null 2>&1 || return 1
  if [ -n "${checkout_merge_ref}" ]; then
    checkout_ref=${checkout_merge_ref#refs/heads/}
  else
    checkout_ref=${checkout_branch}
  fi
  [ -n "${checkout_ref}" ] || return 1
  JSH_CHECKOUT_REMOTE=${checkout_remote}
  JSH_CHECKOUT_REF=${checkout_ref}
  return 0
}

jsh_component_network_needed() {
  JSH_NETWORK_NEEDED=0
  if [ "${JSH_NETWORK_CHECK:-auto}" = always ]; then
    JSH_NETWORK_NEEDED=1
  elif [ "${JSH_NETWORK_CHECK:-auto}" = never ]; then
    JSH_NETWORK_NEEDED=0
  elif [ -z "${local_checkout}" ]; then
    case "${install_repo}" in
      /* | ./* | ../* | file:*) ;;
      *) JSH_NETWORK_NEEDED=1 ;;
    esac
    if [ "${JSH_MODE}" = full ] \
      && { [ -n "${JSH_CORE_MISSING_FORMULAS}" ] || [ ! -d "${install_dir}" ]; }; then
      JSH_NETWORK_NEEDED=1
    fi
  elif [ -n "${local_checkout}" ]; then
    local_checkout_dirty=$(git -C "${install_dir}" status --porcelain \
      --untracked-files=all --ignore-submodules=none 2>/dev/null || true)
    if [ -z "${local_checkout_dirty}" ] && jsh_component_local_upstream; then
      JSH_NETWORK_NEEDED=1
    fi
    if [ "${JSH_MODE}" = full ]; then
      if [ -n "${JSH_CORE_MISSING_FORMULAS}" ]; then
        JSH_NETWORK_NEEDED=1
      fi
      if jsh_component_vendor_needs_network; then
        JSH_NETWORK_NEEDED=1
      fi
    fi
  elif [ "${JSH_MODE}" = full ]; then
    if [ -n "${JSH_CORE_MISSING_FORMULAS}" ]; then
      JSH_NETWORK_NEEDED=1
    fi
    if jsh_component_vendor_needs_network; then
      JSH_NETWORK_NEEDED=1
    fi
  fi
  return 0
}

jsh_component_add_host_error() {
  JSH_HOST_ERRORS="${JSH_HOST_ERRORS}${JSH_HOST_ERRORS:+; }$1"
}

jsh_component_install_dir_safe() {
  if [ -n "${local_checkout}" ] && [ "${install_dir}" = "${local_checkout}" ]; then
    return 0
  fi
  case "${install_dir}" in
    '' | / | "${HOME}") return 1 ;;
    "${HOME}"/*) return 0 ;;
    *) return 1 ;;
  esac
}

jsh_component_parent_writable() {
  write_path=$(dirname "$1")
  while [ ! -d "${write_path}" ]; do
    [ "${write_path}" != / ] || return 1
    next_write_path=$(dirname "${write_path}")
    [ "${next_write_path}" != "${write_path}" ] || return 1
    write_path=${next_write_path}
  done
  [ -w "${write_path}" ]
}

jsh_component_check_host() {
  JSH_HOST_ERRORS=
  [ -n "${HOME:-}" ] || jsh_component_add_host_error 'HOME is not set'
  for required_command in bash git curl uname id; do
    command -v "${required_command}" >/dev/null 2>&1 \
      || jsh_component_add_host_error "${required_command} is unavailable"
  done

  host_platform=$(uname -s 2>/dev/null || printf unknown)
  case "${host_platform}" in
    Darwin | Linux) ;;
    *) jsh_component_add_host_error "unsupported platform: ${host_platform}" ;;
  esac
  if command -v id >/dev/null 2>&1 && [ "$(id -u)" -eq 0 ]; then
    jsh_component_add_host_error 'do not run the installer as root'
  fi
  jsh_component_install_dir_safe || jsh_component_add_host_error "unsafe install directory: ${install_dir}"
  [ -d "${HOME:-}" ] && [ -w "${HOME}" ] \
    || jsh_component_add_host_error 'HOME is not writable'
  if [ ! -e "${install_dir}" ] && [ ! -L "${install_dir}" ]; then
    jsh_component_parent_writable "${install_dir}" \
      || jsh_component_add_host_error "install parent is not writable: $(dirname "${install_dir}")"
  fi

  if [ "${JSH_NETWORK_NEEDED}" = 1 ] && [ "${JSH_NETWORK_CHECK:-auto}" != never ] \
    && command -v curl >/dev/null 2>&1; then
    jsh_spinner_start 'Checking network access'
    if curl -fsSL --max-time "${JSH_NETWORK_TIMEOUT:-5}" \
      "${JSH_NETWORK_URL:-https://github.com}" >/dev/null 2>&1; then
      jsh_spinner_stop success 'Network access is available'
    else
      jsh_spinner_stop error 'Network access is unavailable'
      jsh_component_add_host_error 'network access is unavailable'
    fi
  fi

  if [ -n "${JSH_HOST_ERRORS}" ]; then
    jsh_component_set host error "${JSH_HOST_ERRORS}" ''
  elif [ "${JSH_NETWORK_NEEDED}" = 1 ]; then
    jsh_component_set host current 'bash, git, curl, platform, permissions, and network are ready' ''
  else
    jsh_component_set host current 'bash, git, curl, platform, and permissions are ready; network is not required' ''
  fi
}

jsh_component_apply_host() {
  return 0
}

jsh_component_check_checkout() {
  JSH_CHECKOUT_ACTION=none
  if [ -n "${local_checkout}" ]; then
    if [ ! -d "${install_dir}" ]; then
      jsh_component_set checkout error "local checkout is missing: ${install_dir}" ''
      return 0
    fi
    checkout_root=$(git -C "${install_dir}" rev-parse --show-toplevel 2>/dev/null || true)
    if [ -z "${checkout_root}" ]; then
      jsh_component_set checkout error 'local setup source is not a Git checkout' ''
      return 0
    fi
    checkout_root=$(CDPATH='' cd -- "${checkout_root}" 2>/dev/null && pwd -P || true)
    install_root=$(CDPATH='' cd -- "${install_dir}" 2>/dev/null && pwd -P || true)
    if [ "${checkout_root}" != "${install_root}" ]; then
      jsh_component_set checkout error 'local setup source is not the checkout root' ''
      return 0
    fi
    dirty_checkout=$(git -C "${install_dir}" status --porcelain --untracked-files=all --ignore-submodules=none)
    if [ -n "${dirty_checkout}" ]; then
      jsh_component_set checkout warning \
        'local checkout has local changes; using current files without updating' ''
      return 0
    fi
    if ! jsh_component_local_upstream; then
      jsh_component_set checkout current \
        "using local checkout $(jsh_display_path "${install_dir}"); no upstream is configured" ''
      return 0
    fi
    remote_ref_lines=$(git -C "${install_dir}" ls-remote "${JSH_CHECKOUT_REMOTE}" \
      "refs/heads/${JSH_CHECKOUT_REF}" 2>/dev/null || true)
    remote_ref_hash=$(printf '%s\n' "${remote_ref_lines}" | awk \
      -v ref="refs/heads/${JSH_CHECKOUT_REF}" '$2 == ref { print $1; exit }' || true)
    if [ -z "${remote_ref_hash}" ]; then
      jsh_component_set checkout warning \
        "could not verify upstream ${JSH_CHECKOUT_REMOTE}/${JSH_CHECKOUT_REF}; using current checkout" ''
      return 0
    fi
    checkout_head=$(git -C "${install_dir}" rev-parse HEAD 2>/dev/null || true)
    if [ "${checkout_head}" = "${remote_ref_hash}" ]; then
      jsh_component_set checkout current \
        "local checkout is current with ${JSH_CHECKOUT_REMOTE}/${JSH_CHECKOUT_REF}" ''
    else
      JSH_CHECKOUT_ACTION=update
      jsh_component_set checkout changed \
        "${JSH_CHECKOUT_REMOTE}/${JSH_CHECKOUT_REF} has an update available" \
        "fast-forward local checkout to ${JSH_CHECKOUT_REMOTE}/${JSH_CHECKOUT_REF}"
    fi
    return 0
  fi

  if [ ! -e "${install_dir}" ] && [ ! -L "${install_dir}" ]; then
    JSH_CHECKOUT_ACTION=clone
    jsh_component_set checkout missing "checkout will be created at $(jsh_display_path "${install_dir}")" \
      "clone ${install_repo_display} at ${install_ref}"
    return 0
  fi
  if [ ! -d "${install_dir}" ]; then
    jsh_component_set checkout error "install path is not a directory: ${install_dir}" ''
    return 0
  fi

  checkout_root=$(git -C "${install_dir}" rev-parse --show-toplevel 2>/dev/null || true)
  if [ -z "${checkout_root}" ]; then
    jsh_component_set checkout error "existing path is not a Git checkout: ${install_dir}" ''
    return 0
  fi
  checkout_root=$(CDPATH='' cd -- "${checkout_root}" 2>/dev/null && pwd -P || true)
  install_root=$(CDPATH='' cd -- "${install_dir}" 2>/dev/null && pwd -P || true)
  if [ "${checkout_root}" != "${install_root}" ]; then
    jsh_component_set checkout error 'install path is not the checkout root' ''
    return 0
  fi

  checkout_origin=$(git -C "${install_dir}" remote get-url origin 2>/dev/null || true)
  if [ -z "${checkout_origin}" ]; then
    jsh_component_set checkout error 'existing checkout has no origin remote' ''
    return 0
  fi
  if [ "${checkout_origin}" != "${install_repo}" ]; then
    jsh_component_set checkout error "checkout origin does not match ${install_repo_display}" ''
    return 0
  fi
  dirty_checkout=$(git -C "${install_dir}" status --porcelain --untracked-files=all --ignore-submodules=none)
  if [ -n "${dirty_checkout}" ]; then
    jsh_component_set checkout warning \
      'existing checkout has local changes; using current files without updating' ''
    return 0
  fi
  if [ "${JSH_MODE}" = full ] \
    && ! git -C "${install_dir}" submodule foreach --quiet --recursive \
      'test -z "$(git status --porcelain --untracked-files=all)"' >/dev/null 2>&1; then
    jsh_component_set checkout warning \
      'a submodule has local changes; using current files without updating' ''
    return 0
  fi

  checkout_branch=$(git -C "${install_dir}" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  checkout_ref=${install_ref#refs/heads/}
  checkout_ref=${checkout_ref#refs/tags/}
  if [ -z "${checkout_branch}" ] || [ "${checkout_branch}" != "${checkout_ref}" ]; then
    jsh_component_set checkout error "checkout branch/ref does not match ${install_ref}" ''
    return 0
  fi

  remote_ref_lines=$(git -C "${install_dir}" ls-remote origin \
    "refs/heads/${checkout_ref}" "refs/tags/${checkout_ref}" 2>/dev/null || true)
  remote_ref_hash=$(printf '%s\n' "${remote_ref_lines}" | awk \
    -v branch="refs/heads/${checkout_ref}" -v tag="refs/tags/${checkout_ref}" \
    '$2 == branch { print $1; found=1; exit } $2 == tag { print $1; found=1; exit }')
  if [ -z "${remote_ref_hash}" ]; then
    jsh_component_set checkout error "origin does not provide ref ${install_ref}" ''
    return 0
  fi
  JSH_CHECKOUT_REMOTE=origin
  JSH_CHECKOUT_REF=${checkout_ref}
  checkout_head=$(git -C "${install_dir}" rev-parse HEAD 2>/dev/null || true)
  if [ "${checkout_head}" = "${remote_ref_hash}" ]; then
    jsh_component_set checkout current "${install_ref} is current at $(printf '%s' "${checkout_head}" | cut -c1-12)" ''
  else
    JSH_CHECKOUT_ACTION=update
    jsh_component_set checkout changed "${install_ref} has an update available" 'fast-forward checkout to origin'
  fi
}

jsh_xcode_ready_for_component() {
  [ "$(uname -s 2>/dev/null)" != Darwin ] || {
    command -v xcode-select >/dev/null 2>&1 && xcode-select -p >/dev/null 2>&1
  }
}

jsh_component_check_xcode() {
  if [ "$(uname -s 2>/dev/null)" != Darwin ]; then
    jsh_component_set xcode current 'not required on this platform' ''
  elif jsh_xcode_ready_for_component; then
    jsh_component_set xcode current 'Apple Command Line Tools are ready' ''
  else
    jsh_component_set xcode missing 'Apple Command Line Tools are not installed' 'install Apple Command Line Tools'
  fi
}

jsh_brew_path_for_component() {
  brew_search_paths=${JSH_BREW_PATHS:-'/opt/homebrew/bin /usr/local/bin /home/linuxbrew/.linuxbrew/bin'}
  for brew_bin in ${brew_search_paths}; do
    if [ -x "${brew_bin}/brew" ]; then
      case ":${PATH:-}:" in
        *":${brew_bin}:"*) ;;
        *)
          PATH="${brew_bin}${PATH:+:${PATH}}"
          export PATH
          ;;
      esac
      break
    fi
  done
  if command -v brew >/dev/null 2>&1; then
    brew_shellenv=$(brew shellenv 2>/dev/null || true)
    [ -z "${brew_shellenv}" ] || eval "${brew_shellenv}"
  fi
}

jsh_component_check_brew() {
  jsh_brew_path_for_component
  jsh_component_core_formulas
  if command -v brew >/dev/null 2>&1; then
    JSH_BREW_AVAILABLE=1
    brew_display=$(command -v brew)
    jsh_component_set brew current "available at ${brew_display}; PATH initialized" ''
  elif [ -z "${JSH_CORE_MISSING_FORMULAS}" ]; then
    JSH_BREW_AVAILABLE=0
    jsh_component_set brew current 'not required; core commands are already available' ''
  else
    JSH_BREW_AVAILABLE=0
    jsh_component_set brew missing 'Homebrew / Linuxbrew is not available' 'install Homebrew / Linuxbrew'
  fi
}

jsh_component_check_core() {
  if [ "$(jsh_component_state checkout)" = changed ]; then
    jsh_component_set core planned 'checkout update may change Brewfile.core' \
      're-read Brewfile.core and install missing packages after checkout update'
  elif [ -z "${JSH_CORE_MISSING_FORMULAS}" ]; then
    jsh_component_set core current 'task, jq, just, and zsh are available' ''
  elif [ "${JSH_BREW_AVAILABLE}" = 1 ]; then
    jsh_component_set core missing "missing: ${JSH_CORE_MISSING_FORMULAS}" \
      "install core packages from Brewfile.core"
  else
    jsh_component_set core planned "missing: ${JSH_CORE_MISSING_FORMULAS}" \
      'install core packages after Homebrew / Linuxbrew is ready'
  fi
}

jsh_component_check_vendor() {
  JSH_VENDOR_MISSING=
  JSH_VENDOR_ERRORS=
  if [ "$(jsh_component_state checkout)" = changed ]; then
    jsh_component_set vendor planned 'checkout update may change vendored assets' \
      'initialize submodules and restore vendored assets after checkout update'
    return 0
  fi
  if [ ! -d "${install_dir}" ]; then
    jsh_component_set vendor planned 'checkout must be ready first' 'initialize submodules and verify vendored assets'
    return 0
  fi
  if [ ! -r "${install_dir}/.gitmodules" ]; then
    jsh_component_set vendor error 'checkout has no .gitmodules file' ''
    return 0
  fi
  submodule_paths=$(git -C "${install_dir}" config --file .gitmodules --get-regexp '\.path$' 2>/dev/null | sed 's/^[^ ]* //') || true
  for submodule_path in ${submodule_paths}; do
    submodule_status=$(git -C "${install_dir}" submodule status -- "${submodule_path}" 2>/dev/null || true)
    case "${submodule_status}" in
      -*) JSH_VENDOR_MISSING="${JSH_VENDOR_MISSING}${JSH_VENDOR_MISSING:+, }${submodule_path}" ;;
      +* | U*) JSH_VENDOR_ERRORS="${JSH_VENDOR_ERRORS}${JSH_VENDOR_ERRORS:+, }${submodule_path} has local changes" ;;
      *)
        if [ ! -d "${install_dir}/${submodule_path}" ]; then
          JSH_VENDOR_MISSING="${JSH_VENDOR_MISSING}${JSH_VENDOR_MISSING:+, }${submodule_path}"
        elif ! git -C "${install_dir}/${submodule_path}" rev-parse --git-dir >/dev/null 2>&1; then
          JSH_VENDOR_MISSING="${JSH_VENDOR_MISSING}${JSH_VENDOR_MISSING:+, }${submodule_path}"
        elif [ -n "$(git -C "${install_dir}/${submodule_path}" status --porcelain --untracked-files=all)" ]; then
          JSH_VENDOR_ERRORS="${JSH_VENDOR_ERRORS}${JSH_VENDOR_ERRORS:+, }${submodule_path} has local changes"
        fi
        ;;
    esac
  done
  for vendored_asset in \
    vendor/fzf/install \
    vendor/fzf/bin/fzf \
    vendor/fzf-tab/fzf-tab.plugin.zsh \
    vendor/zsh-completions/src \
    vendor/zsh-plugins/zsh-autosuggestions.zsh \
    vendor/vim-config/autoload/plug.vim; do
    [ -e "${install_dir}/${vendored_asset}" ] \
      || JSH_VENDOR_MISSING="${JSH_VENDOR_MISSING}${JSH_VENDOR_MISSING:+, }${vendored_asset}"
  done
  if [ -n "${JSH_VENDOR_ERRORS}" ]; then
    jsh_component_set vendor error "${JSH_VENDOR_ERRORS}" ''
  elif [ -n "${JSH_VENDOR_MISSING}" ]; then
    jsh_component_set vendor missing "missing: ${JSH_VENDOR_MISSING}" 'initialize submodules and restore vendored assets'
  else
    jsh_component_set vendor current 'submodules and vendored assets are ready' ''
  fi
}

jsh_component_resolve_path() {
  resolve_parent=$(CDPATH='' cd -- "$(dirname "$1")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "${resolve_parent}" "$(basename "$1")"
}

jsh_component_link_target() {
  link_target=$(readlink "$1") || return 1
  case "${link_target}" in
    /*) jsh_component_resolve_path "${link_target}" ;;
    *) jsh_component_resolve_path "$(dirname "$1")/${link_target}" ;;
  esac
}

jsh_component_link_points_to() {
  [ -L "$2" ] || return 1
  link_source_path=$(jsh_component_resolve_path "$1") || return 1
  link_target_path=$(jsh_component_link_target "$2") || return 1
  [ "${link_source_path}" = "${link_target_path}" ]
}

jsh_component_state_has_link() {
  [ -r "${JSH_LINK_STATE}" ] || return 1
  while IFS='|' read -r managed_source managed_destination managed_backup || [ -n "${managed_source}${managed_destination}${managed_backup}" ]; do
    [ "${managed_source}" = "$1" ] && [ "${managed_destination}" = "$2" ] && return 0
  done <"${JSH_LINK_STATE}"
  return 1
}

jsh_component_vscode_user_dir() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) printf '%s\n' "${HOME}/Library/Application Support/Code/User" ;;
    *) printf '%s\n' "${XDG_CONFIG_HOME:-${HOME}/.config}/Code/User" ;;
  esac
}

jsh_component_install_entries() {
  for relative_path in .zshrc .bashrc .bash_profile .gitconfig .inputrc .tmux.conf \
    .vimrc .editorconfig .shellcheckrc .markdownlint.jsonc .prettierrc.json \
    .czrc .ripgreprc; do
    source_path="${install_dir}/dotfiles/${relative_path}"
    if [ -e "${source_path}" ] || [ -L "${source_path}" ]; then
      printf '%s|%s\n' "${source_path}" "${HOME}/${relative_path}"
    fi
  done
  config_source="${install_dir}/dotfiles/.config"
  if [ -d "${config_source}" ]; then
    for config_child in "${config_source}"/*; do
      [ -e "${config_child}" ] || [ -L "${config_child}" ] || continue
      printf '%s|%s\n' "${config_child}" "${XDG_CONFIG_HOME:-${HOME}/.config}/${config_child##*/}"
    done
  fi
  vscode_source="${install_dir}/dotfiles/.vscode/user"
  vscode_destination=$(jsh_component_vscode_user_dir)
  if [ -d "${vscode_source}" ]; then
    for vscode_child in "${vscode_source}"/*; do
      [ -e "${vscode_child}" ] || [ -L "${vscode_child}" ] || continue
      [ "${vscode_child##*/}" != prompts ] || continue
      printf '%s|%s\n' "${vscode_child}" "${vscode_destination}/${vscode_child##*/}"
    done
  fi
  agents_source="${install_dir}/dotfiles/.agents/agents"
  if [ -d "${agents_source}" ]; then
    printf '%s|%s\n' "${agents_source}" "${HOME}/.agents/agents"
    printf '%s|%s\n' "${agents_source}" "${HOME}/.copilot/agents"
    printf '%s|%s\n' "${agents_source}" "${HOME}/.codex/agents"
  fi
  source_path="${install_dir}/dotfiles/.codex/AGENTS.md"
  if [ -e "${source_path}" ] || [ -L "${source_path}" ]; then
    printf '%s|%s\n' "${source_path}" "${HOME}/.codex/AGENTS.md"
  fi
  source_path="${install_dir}/dotfiles/.copilot/copilot-instructions.md"
  if [ -e "${source_path}" ] || [ -L "${source_path}" ]; then
    printf '%s|%s\n' "${source_path}" "${HOME}/.copilot/copilot-instructions.md"
  fi
}

jsh_component_choose_launcher() {
  if [ -n "${JSH_BIN_DIR:-}" ]; then
    case "${JSH_BIN_DIR}" in
      '' | /) ;;
      /*)
        JSH_LAUNCHER_DESTINATION="${JSH_BIN_DIR%/}/jsh"
        return 0
        ;;
      *)
        JSH_LAUNCHER_DESTINATION=
        return 1
        ;;
    esac
  fi
  system_launcher=/usr/local/bin/jsh
  if jsh_component_link_points_to "${install_dir}/bin/jsh" "${system_launcher}" \
    || { [ ! -e "${system_launcher}" ] && [ ! -L "${system_launcher}" ] \
      && jsh_component_parent_writable "${system_launcher}"; } \
    || { [ ! -e "${system_launcher}" ] && [ ! -L "${system_launcher}" ] \
      && command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; }; then
    JSH_LAUNCHER_DESTINATION=${system_launcher}
  else
    JSH_LAUNCHER_DESTINATION="${HOME}/.local/bin/jsh"
  fi
  return 0
}

jsh_component_check_launcher() {
  if ! jsh_component_choose_launcher; then
    jsh_component_set launcher error 'JSH_BIN_DIR must be an absolute non-root path' ''
    return 0
  fi
  launcher_mode=
  [ ! -r "${JSH_MODE_FILE}" ] || IFS= read -r launcher_mode <"${JSH_MODE_FILE}"
  if [ "${JSH_MODE}" = lite ] && [ "${launcher_mode}" = install ]; then
    jsh_component_set launcher error 'managed full-mode links must be uninstalled before switching to lite mode' ''
    return 0
  fi
  launcher_source="${install_dir}/bin/jsh"
  launcher_display=$(jsh_display_path "${JSH_LAUNCHER_DESTINATION}")
  if [ "$(jsh_component_state checkout)" = changed ]; then
    jsh_component_set launcher planned "${launcher_display} will be rechecked after checkout update" \
      "reconcile launcher after checkout update"
    return 0
  fi
  if [ ! -e "${launcher_source}" ] && [ ! -L "${launcher_source}" ]; then
    jsh_component_set launcher planned "launcher source will be available after checkout" \
      "link ${launcher_display}"
  elif jsh_component_link_points_to "${launcher_source}" "${JSH_LAUNCHER_DESTINATION}"; then
    if jsh_component_state_has_link "${launcher_source}" "${JSH_LAUNCHER_DESTINATION}"; then
      if [ "${launcher_mode}" != "${install_mode}" ]; then
        jsh_component_set launcher changed "${launcher_display} is linked; setup mode needs recording" \
          "record ${JSH_MODE} mode"
      else
        jsh_component_set launcher current "${launcher_display} points to the checkout" ''
      fi
    else
      jsh_component_set launcher changed "${launcher_display} is correct but unmanaged" 'record managed launcher state'
    fi
  elif [ -e "${JSH_LAUNCHER_DESTINATION}" ] || [ -L "${JSH_LAUNCHER_DESTINATION}" ]; then
    jsh_component_set launcher changed "${launcher_display} points somewhere else" \
      "backup existing launcher and link ${launcher_display}"
  else
    jsh_component_set launcher missing "${launcher_display} is not linked" "link ${launcher_display}"
  fi
}

jsh_component_check_config() {
  if [ "$(jsh_component_state checkout)" = changed ]; then
    jsh_component_set config planned 'checkout update may change managed sources' \
      'reconcile managed links after checkout update'
    return 0
  fi
  if [ ! -d "${install_dir}/dotfiles" ]; then
    jsh_component_set config planned 'managed sources will be available after checkout' \
      'link managed HOME, XDG, and VS Code configuration'
    return 0
  fi
  legacy_prompts_source="${install_dir}/dotfiles/.vscode/user/prompts"
  legacy_prompts_destination="$(jsh_component_vscode_user_dir)/prompts"
  if jsh_component_state_has_link "${legacy_prompts_source}" "${legacy_prompts_destination}"; then
    jsh_component_set config changed "${legacy_prompts_destination} uses the legacy directory link" \
      'migrate VS Code prompts to individual managed links'
    return 0
  fi
  config_entries=$(jsh_component_install_entries)
  config_entry_count=0
  config_missing_count=0
  config_changed_count=0
  config_first_problem=
  while IFS='|' read -r config_source_path config_destination_path; do
    [ -n "${config_source_path}" ] || continue
    config_entry_count=$((config_entry_count + 1))
    if jsh_component_link_points_to "${config_source_path}" "${config_destination_path}"; then
      if ! jsh_component_state_has_link "${config_source_path}" "${config_destination_path}"; then
        config_changed_count=$((config_changed_count + 1))
        [ -n "${config_first_problem}" ] || config_first_problem="${config_destination_path} is unmanaged"
      fi
    elif [ -e "${config_destination_path}" ] || [ -L "${config_destination_path}" ]; then
      config_changed_count=$((config_changed_count + 1))
      [ -n "${config_first_problem}" ] || config_first_problem="${config_destination_path} has an existing file"
    else
      config_missing_count=$((config_missing_count + 1))
      [ -n "${config_first_problem}" ] || config_first_problem="${config_destination_path} is missing"
    fi
  done <<JSH_CONFIG_ENTRIES
${config_entries}
JSH_CONFIG_ENTRIES

  if [ "${config_entry_count}" -eq 0 ]; then
    jsh_component_set config error 'no managed configuration sources were found' ''
  elif [ "${config_changed_count}" -gt 0 ]; then
    jsh_component_set config changed "${config_first_problem}" \
      'reconcile managed HOME, XDG, and VS Code links (back up existing files)'
  elif [ "${config_missing_count}" -gt 0 ]; then
    jsh_component_set config missing "${config_first_problem}" \
      'link managed HOME, XDG, and VS Code configuration'
  else
    jsh_component_set config current 'managed HOME, XDG, and VS Code links are current' ''
  fi
}

jsh_component_evaluate() {
  while IFS='|' read -r component_name component_display component_dependencies component_check _component_plan component_apply component_modes; do
    jsh_component_mode_allowed "${component_modes}" || continue
    if ! jsh_component_dependencies_checkable "${component_dependencies}"; then
      jsh_component_set "${component_name}" skipped "blocked: ${JSH_DEPENDENCY_REASON}" ''
    elif ! "${component_check}"; then
      jsh_component_set "${component_name}" error 'component check failed' ''
    fi
  done <<JSH_COMPONENTS
$(jsh_component_registry)
JSH_COMPONENTS
}

jsh_component_render_row() {
  component_name=$1
  component_display=$2
  component_state=$(jsh_component_state "${component_name}")
  component_detail=$(jsh_component_detail "${component_name}")
  component_action=$(jsh_component_action "${component_name}")
  case "${component_state}" in
    missing | changed | planned)
      [ -z "${component_action}" ] || component_detail="${component_detail}; ${component_action}"
      ;;
  esac
  jsh_ui_init
  jsh_ui_status "${component_state}"
  [ "${JSH_UI_RICH}" = 1 ] || JSH_UI_MARK="[${JSH_UI_MARK}]"
  jsh_ui_text "${component_detail}"
  component_detail=${REPLY_TEXT}
  printf '%s%s%s %-29s %s\n' \
    "${JSH_UI_COLOR}" "${JSH_UI_MARK}" "${JSH_UI_RESET}" \
    "${component_display}" "${component_detail}"
}

jsh_component_render_plan() {
  JSH_PLAN_HEADING_SPACING=${1:-}
  if [ "${JSH_MODE}" = full ]; then
    jsh_ui_heading 'Setup plan (full)' "${JSH_PLAN_HEADING_SPACING}"
  else
    jsh_ui_heading 'Setup plan (lite)' "${JSH_PLAN_HEADING_SPACING}"
  fi
  while IFS='|' read -r component_name component_display component_dependencies component_check _component_plan component_apply component_modes; do
    jsh_component_mode_allowed "${component_modes}" || continue
    jsh_component_render_row "${component_name}" "${component_display}"
  done <<JSH_COMPONENTS
$(jsh_component_registry)
JSH_COMPONENTS
}

jsh_component_plan_has_errors() {
  for component_name in host checkout xcode brew core vendor launcher config; do
    case "$(jsh_component_state "${component_name}")" in
      error)
        JSH_PLAN_ERROR_COMPONENT=${component_name}
        return 0
        ;;
    esac
  done
  return 1
}

jsh_component_refresh_checkout_dependents() {
  jsh_component_core_formulas
  if [ "${JSH_MODE}" = full ]; then
    jsh_component_check_core
    jsh_component_check_vendor
  fi
  jsh_component_check_launcher
  if [ "${JSH_MODE}" = full ]; then
    jsh_component_check_config
  fi
  jsh_component_seed_current
  return 0
}

jsh_component_prompt() {
  [ "${JSH_DRY_RUN}" = 1 ] && return 0
  JSH_DECLINED=0
  while IFS='|' read -r component_name component_display component_dependencies component_check _component_plan component_apply component_modes; do
    jsh_component_mode_allowed "${component_modes}" || continue
    component_state=$(jsh_component_state "${component_name}")
    jsh_component_is_actionable "${component_state}" || continue
    if ! jsh_component_dependencies_allowed "${component_dependencies}"; then
      jsh_component_set "${component_name}" skipped "blocked: ${JSH_DEPENDENCY_REASON:-a dependency was not approved}" ''
      jsh_ui_row warning "${component_display} skipped: ${JSH_DEPENDENCY_REASON:-a dependency was not approved}"
      continue
    fi
    if [ "${JSH_ASSUME_YES}" = 1 ]; then
      jsh_component_set_approved "${component_name}" 1
      continue
    fi
    if ! [ -t 1 ] || ! [ -r /dev/tty ] || ! [ -w /dev/tty ]; then
      fail 'Noninteractive setup requires --yes when a component needs changes'
    fi
    component_action=$(jsh_component_action "${component_name}")
    prompt_verb=Apply
    if [ "${component_name}" = checkout ] && [ "${JSH_CHECKOUT_ACTION}" = update ]; then
      prompt_verb=Update
    fi
    jsh_read_key "${prompt_verb} ${component_display}? ${component_action} [y/N] " || exit 130
    case "${JSH_KEY}" in
      y | Y) jsh_component_set_approved "${component_name}" 1 ;;
      *)
        if [ "${component_name}" = checkout ] && [ "${JSH_CHECKOUT_ACTION}" = update ]; then
          JSH_CHECKOUT_ACTION=none
          jsh_component_set checkout warning 'upstream update declined; using current checkout' ''
          jsh_component_set_approved checkout 1
          jsh_component_set_succeeded checkout 1
          jsh_ui_row warning 'Keeping the current Git checkout'
          jsh_component_refresh_checkout_dependents
        else
          JSH_DECLINED=1
          jsh_component_set "${component_name}" skipped 'declined by user' ''
          jsh_ui_row note "${component_display} was skipped"
        fi
        ;;
    esac
  done <<JSH_COMPONENTS
$(jsh_component_registry)
JSH_COMPONENTS
}

jsh_component_apply_checkout() {
  case "${JSH_CHECKOUT_ACTION}" in
    clone)
      mkdir -p "$(dirname "${install_dir}")" || return 1
      jsh_spinner_start 'Cloning repository'
      if git clone --quiet --branch "${install_ref}" "${install_repo}" "${install_dir}" 2>/dev/null; then
        jsh_spinner_stop success 'Cloned repository'
      else
        jsh_spinner_stop error 'Failed to clone repository'
        return 1
      fi
      ;;
    update)
      checkout_remote=${JSH_CHECKOUT_REMOTE:-origin}
      checkout_ref=${JSH_CHECKOUT_REF:-${install_ref}}
      jsh_spinner_start 'Fetching repository updates'
      if git -C "${install_dir}" fetch --quiet "${checkout_remote}" "${checkout_ref}" 2>/dev/null; then
        jsh_spinner_stop success 'Fetched repository updates'
      else
        jsh_spinner_stop error 'Failed to fetch repository updates'
        return 1
      fi
      git -C "${install_dir}" merge-base --is-ancestor HEAD FETCH_HEAD \
        || {
          jsh_ui_row error 'Checkout has diverged; refusing to overwrite it' stderr
          return 1
        }
      if [ "$(git -C "${install_dir}" rev-parse HEAD)" != "$(git -C "${install_dir}" rev-parse FETCH_HEAD)" ]; then
        git -C "${install_dir}" merge --quiet --ff-only FETCH_HEAD \
          || {
            jsh_ui_row error 'Failed to fast-forward checkout' stderr
            return 1
          }
        jsh_ui_row success 'Fast-forwarded checkout'
      fi
      ;;
  esac
  return 0
}

jsh_component_apply_xcode() {
  [ "$(uname -s 2>/dev/null)" = Darwin ] || return 0
  command -v xcode-select >/dev/null 2>&1 || {
    jsh_ui_row error 'xcode-select is unavailable' stderr
    return 1
  }
  xcode-select --install >/dev/null 2>&1 || {
    jsh_ui_row error 'Failed to start Apple Command Line Tools installation' stderr
    return 1
  }
  xcode_wait_attempts=${JSH_XCODE_WAIT_ATTEMPTS:-900}
  xcode_wait_interval=${JSH_XCODE_POLL_INTERVAL:-2}
  case "${xcode_wait_attempts}" in '' | *[!0-9]*) xcode_wait_attempts=900 ;; esac
  case "${xcode_wait_interval}" in '' | *[!0-9]*) xcode_wait_interval=2 ;; esac
  jsh_spinner_start 'Waiting for Apple Command Line Tools'
  while [ "${xcode_wait_attempts}" -gt 0 ]; do
    if jsh_xcode_ready_for_component; then
      jsh_spinner_stop success 'Apple Command Line Tools are ready'
      return 0
    fi
    xcode_wait_attempts=$((xcode_wait_attempts - 1))
    sleep "${xcode_wait_interval}"
  done
  jsh_spinner_stop error 'Apple Command Line Tools did not become ready'
  jsh_ui_row note 'Complete the Apple Command Line Tools dialog, then rerun jsh' stderr
  return 1
}

jsh_component_install_homebrew() {
  jsh_brew_path_for_component
  command -v brew >/dev/null 2>&1 && return 0
  command -v curl >/dev/null 2>&1 || {
    jsh_ui_row error 'curl is required to install Homebrew / Linuxbrew' stderr
    return 1
  }
  jsh_spinner_start 'Installing Homebrew / Linuxbrew'
  brew_install_script=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh 2>/dev/null) || {
    jsh_spinner_stop error 'Failed to download the Homebrew / Linuxbrew installer'
    return 1
  }
  if [ "${JSH_ASSUME_YES}" = 1 ] && ! [ -t 0 ]; then
    if NONINTERACTIVE=1 bash -c "${brew_install_script}" >/dev/null 2>&1; then
      brew_install_status=0
    else
      brew_install_status=$?
    fi
  elif [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if bash -c "${brew_install_script}" </dev/tty >/dev/null 2>&1; then
      brew_install_status=0
    else
      brew_install_status=$?
    fi
  else
    if bash -c "${brew_install_script}" >/dev/null 2>&1; then
      brew_install_status=0
    else
      brew_install_status=$?
    fi
  fi
  if [ "${brew_install_status}" -ne 0 ]; then
    jsh_spinner_stop error 'Homebrew / Linuxbrew installation failed'
    return 1
  fi
  jsh_brew_path_for_component
  if command -v brew >/dev/null 2>&1; then
    jsh_spinner_stop success 'Homebrew / Linuxbrew is available'
    return 0
  fi
  jsh_spinner_stop error 'Homebrew / Linuxbrew was installed but is not on PATH'
  return 1
}

jsh_component_apply_brew() {
  jsh_component_install_homebrew
}

jsh_component_apply_core() {
  jsh_brew_path_for_component
  jsh_component_core_formulas
  command -v brew >/dev/null 2>&1 || {
    jsh_ui_row error 'Core dependencies require Homebrew / Linuxbrew' stderr
    return 1
  }
  for formula_name in ${JSH_CORE_MISSING_FORMULAS}; do
    jsh_spinner_start "Installing ${formula_name}"
    if brew install "${formula_name}" >/dev/null 2>&1; then
      jsh_spinner_stop success "Installed ${formula_name}"
    else
      jsh_spinner_stop error "Failed to install ${formula_name}"
      return 1
    fi
  done
  jsh_brew_path_for_component
  jsh_component_core_formulas
  if [ -n "${JSH_CORE_MISSING_FORMULAS}" ]; then
    jsh_ui_row error "Core dependencies are still missing: ${JSH_CORE_MISSING_FORMULAS}" stderr
    return 1
  fi
  return 0
}

jsh_component_apply_vendor() {
  jsh_spinner_start 'Initializing submodules and vendored assets'
  if git -C "${install_dir}" submodule sync --recursive >/dev/null 2>&1 \
    && git -C "${install_dir}" submodule update --quiet --init --recursive >/dev/null 2>&1 \
    && "${install_dir}/vendor/fzf/install" --bin >/dev/null 2>&1; then
    jsh_spinner_stop success 'Initialized submodules and vendored assets'
    return 0
  fi
  jsh_spinner_stop error 'Failed to initialize submodules and vendored assets'
  return 1
}

jsh_component_apply_links() {
  link_component=$1
  JSH_DIR="${install_dir}" \
    JSH_STATE_DIR="${JSH_STATE_DIR}" \
    JSH_LINK_STATE="${JSH_LINK_STATE}" \
    JSH_MODE_FILE="${JSH_MODE_FILE}" \
    JSH_BANNER_SHOWN=1 \
    JSH_INSTALL_QUIET=1 \
    JSH_INSTALL_COMPONENTS="${link_component}" \
    JSH_LAUNCHER_DESTINATION="${JSH_LAUNCHER_DESTINATION}" \
    bash "${install_dir}/bin/jsh" __apply-links --mode "${install_mode}"
}

jsh_component_apply_launcher() {
  jsh_component_apply_links launcher
}

jsh_component_apply_config() {
  jsh_component_apply_links config
}

jsh_component_apply() {
  JSH_APPLY_FAILURES=0
  JSH_APPLY_PRINTED=0
  while IFS='|' read -r component_name component_display component_dependencies component_check _component_plan component_apply component_modes; do
    jsh_component_mode_allowed "${component_modes}" || continue
    component_state=$(jsh_component_state "${component_name}")
    jsh_component_is_actionable "${component_state}" || continue
    if ! jsh_component_approved "${component_name}"; then
      continue
    fi
    if ! jsh_component_dependencies_ready_to_apply "${component_dependencies}"; then
      if [ "${JSH_APPLY_PRINTED}" = 0 ]; then
        jsh_ui_heading Apply
        JSH_APPLY_PRINTED=1
      fi
      jsh_component_set "${component_name}" skipped "blocked: ${JSH_DEPENDENCY_REASON}" ''
      jsh_ui_row warning "${component_display} skipped: ${JSH_DEPENDENCY_REASON}"
      JSH_APPLY_FAILURES=$((JSH_APPLY_FAILURES + 1))
      continue
    fi
    if [ "${JSH_APPLY_PRINTED}" = 0 ]; then
      jsh_ui_heading Apply
      JSH_APPLY_PRINTED=1
    fi
    if "${component_apply}"; then
      jsh_component_set "${component_name}" current 'reconciled' ''
      jsh_component_set_succeeded "${component_name}" 1
      jsh_ui_row success "${component_display} reconciled"
    else
      jsh_component_set "${component_name}" error 'apply failed; dependent actions were not run' ''
      jsh_component_set_succeeded "${component_name}" 0
      jsh_ui_row error "${component_display} failed" stderr
      JSH_APPLY_FAILURES=$((JSH_APPLY_FAILURES + 1))
    fi
  done <<JSH_COMPONENTS
$(jsh_component_registry)
JSH_COMPONENTS
  [ "${JSH_APPLY_FAILURES}" -eq 0 ]
}

jsh_component_finish() {
  jsh_ui_heading Complete
  if jsh_component_plan_has_errors; then
    jsh_ui_row warning "Setup completed with unresolved ${JSH_PLAN_ERROR_COMPONENT} state"
    jsh_ui_row note 'Resolve the reported component issue, then rerun jsh'
  elif [ "${JSH_DECLINED}" = 1 ]; then
    jsh_ui_row warning 'Setup completed with skipped components'
  elif [ "${JSH_MODE}" = full ]; then
    jsh_ui_row success 'Full setup is complete'
  else
    jsh_ui_row success 'Lite setup is complete'
    jsh_ui_row note 'Full-mode components were left unchanged'
  fi
  jsh_ui_row note 'Run `jsh doctor` to verify the installation'
  jsh_component_plan_has_errors && return 1
  return 0
}

jsh_install_reconcile() {
  jsh_parse_options "$@"
  JSH_TTY_STATE=
  trap 'jsh_spinner_cleanup; jsh_tty_restore' 0
  trap 'jsh_interrupted' 1 2 15
  HOME=${HOME:-}
  JSH_PLAN_HEADING_SPACING=
  [ -z "${JSH_MODE:-}" ] || JSH_PLAN_HEADING_SPACING=after-banner
  jsh_banner
  choose_mode
  install_mode=runtime
  [ "${JSH_MODE}" != full ] || install_mode=install

  local_checkout=
  if [ -z "${JSH_INSTALL_DIR:-}" ]; then
    local_checkout=${JSH_DIR}
  fi
  if [ -n "${local_checkout}" ]; then
    install_dir=${JSH_INSTALL_DIR:-${local_checkout}}
  else
    install_dir=${JSH_INSTALL_DIR:-${HOME}/.jsh}
  fi
  install_repo=${JSH_INSTALL_REPO:-https://github.com/jovalle/jsh.git}
  install_repo_display=$(jsh_display_repo "${install_repo}")
  install_ref=${JSH_INSTALL_REF:-main}
  JSH_SOURCE_ROOT=${install_dir}
  JSH_STATE_DIR=${JSH_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/jsh}
  JSH_LINK_STATE=${JSH_LINK_STATE:-${JSH_STATE_DIR}/managed-links}
  JSH_MODE_FILE=${JSH_MODE_FILE:-${JSH_STATE_DIR}/mode}

  jsh_component_core_formulas
  jsh_component_network_needed
  jsh_component_initialize
  jsh_component_evaluate
  jsh_component_render_plan "${JSH_PLAN_HEADING_SPACING}"
  jsh_component_seed_current
  if [ "${JSH_DRY_RUN}" = 1 ]; then
    jsh_ui_row note 'Dry run: no files, checkout, submodules, packages, or links were changed'
    jsh_component_plan_has_errors && return 1
    return 0
  fi
  jsh_component_prompt
  if ! jsh_component_apply; then
    return 1
  fi
  jsh_component_finish
  if [ "${JSH_DECLINED}" = 1 ]; then
    return 1
  fi
  return 0
}

_jsh_update() {
  local failures=0 work_dir command_output
  (($# == 0)) || {
    _jsh_error "unknown update option: $1"
    return 2
  }

  mkdir -p "${JSH_DIR}/tmp" || return 1
  work_dir=$(mktemp -d "${JSH_DIR}/tmp/jsh-update.XXXXXX") || return 1
  command_output="${work_dir}/output"
  _jsh_banner Update
  if ! command -v just >/dev/null 2>&1; then
    _jsh_ui_row error 'Submodules' 'just is required'
    failures=$((failures + 1))
  else
    jsh_spinner_start 'Updating submodules...'
    if (cd "${JSH_DIR}" && jsh_spinner_exec "${command_output}" just update); then
      jsh_spinner_hide
      _jsh_ui_row success 'Submodules' 'updated from their configured remotes'
    else
      jsh_spinner_hide
      [[ ! -s "${command_output}" ]] || cat "${command_output}" >&2
      _jsh_ui_row error 'Submodules' 'update failed'
      failures=$((failures + 1))
    fi
  fi

  if ! command -v task >/dev/null 2>&1; then
    _jsh_ui_row error 'Packages' 'task is required'
    failures=$((failures + 1))
  else
    jsh_spinner_start 'Updating packages...'
    if (cd "${JSH_DIR}" && jsh_spinner_exec "${command_output}" task packages); then
      jsh_spinner_hide
      _jsh_ui_row success 'Packages' 'installed and upgraded'
    else
      jsh_spinner_hide
      [[ ! -s "${command_output}" ]] || cat "${command_output}" >&2
      _jsh_ui_row error 'Packages' 'update failed'
      failures=$((failures + 1))
    fi
  fi
  rm -rf "${work_dir}"
  ((failures == 0))
}

usage() {
  _jsh_banner
  _jsh_ui_init
  printf '%s%sUsage%s: jsh [shell [-l] | -c COMMAND [args...]]\n' \
    "${_JSH_UI_BOLD}" "${_JSH_UI_CYAN}" "${_JSH_UI_RESET}"
  printf '       jsh <command> [options]\n'
  _jsh_ui_heading Commands
  cat <<'USAGE'
  shell [-l]                          Open the isolated jsh shell runtime
  -c COMMAND [args...]                Run a command inside the jsh runtime
  install [--mode lite|full] [-n] [-y]
                                      Reconcile the checkout and configured components
  status [-v|--verbose] [--porcelain] Summarize jsh and workstation health
  update                              Update submodules and managed packages
  audit                               Find and optionally remove unmanaged Homebrew packages
  repair [-n|--dry-run]               Prune dead stale managed-link state
  doctor [--porcelain] [--strict]     Show comprehensive status diagnostics
  uninstall [-n] [--purge]            Restore originals; optionally remove the checkout
  version                             Show the jsh version
  help                                Show this help
USAGE
}

purge_checkout() {
  local dry_run="$1" checkout_root dirty head upstream
  if [[ "${dry_run}" == 0 && -e "${JSH_LINK_STATE}" ]]; then
    _jsh_error 'unresolved managed links remain; checkout retained'
    return 1
  fi
  case "${JSH_DIR}" in
    '' | / | "${HOME}")
      _jsh_error "unsafe purge path: ${JSH_DIR}"
      return 1
      ;;
    "${HOME}"/*) ;;
    *)
      _jsh_error "checkout is outside HOME: ${JSH_DIR}"
      return 1
      ;;
  esac
  checkout_root=$(git -C "${JSH_DIR}" rev-parse --show-toplevel 2>/dev/null) || {
    _jsh_error 'checkout is not a Git repository'
    return 1
  }
  checkout_root=$(cd "${checkout_root}" && pwd -P) || return 1
  [[ "${checkout_root}" == "${JSH_DIR}" ]] || {
    _jsh_error 'purge path is not the checkout root'
    return 1
  }
  dirty=$(git -C "${JSH_DIR}" status --porcelain --untracked-files=all --ignored)
  if [[ -n "${dirty}" ]]; then
    _jsh_error 'checkout has local or ignored files; checkout retained'
    printf '%s\n' "${dirty}" >&2
    return 1
  fi
  head=$(git -C "${JSH_DIR}" rev-parse HEAD 2>/dev/null) || return 1
  upstream=$(git -C "${JSH_DIR}" rev-parse '@{upstream}' 2>/dev/null) || {
    _jsh_error 'checkout has no upstream; checkout retained'
    return 1
  }
  if [[ "${head}" != "${upstream}" ]]; then
    _jsh_error 'checkout has local or missing upstream commits; checkout retained'
    return 1
  fi
  if [[ "${dry_run}" == 1 ]]; then
    _jsh_message plan "remove checkout ${JSH_DIR}"
    return 0
  fi
  cd "${HOME}" || return 1
  command rm -rf "${JSH_DIR}"
}

trap 'jsh_spinner_cleanup' EXIT

if (($# == 0)); then
  configured_mode=""
  [[ ! -r "${JSH_MODE_FILE}" ]] || IFS= read -r configured_mode <"${JSH_MODE_FILE}"
  if [[ "${configured_mode}" == install ]]; then
    usage
  else _jsh_launch_runtime; fi
  exit $?
fi

command_name="$1"
shift

case "${command_name}" in
  shell)
    _jsh_launch_runtime "$@"
    ;;
  -c)
    _jsh_run_command "$@"
    ;;
  install)
    jsh_install_reconcile "$@"
    ;;
  __apply-links)
    _jsh_apply_links "$@"
    ;;
  status)
    _jsh_status "$@"
    ;;
  update)
    _jsh_update "$@"
    ;;
  audit)
    _jsh_audit "$@"
    ;;
  repair)
    _jsh_repair "$@"
    ;;
  doctor)
    _jsh_doctor "$@"
    ;;
  uninstall)
    uninstall_dry_run=0
    uninstall_purge=0
    while (($# > 0)); do
      case "$1" in
        --dry-run | -n) uninstall_dry_run=1 ;;
        --purge) uninstall_purge=1 ;;
        *)
          _jsh_error "unknown uninstall option: $1"
          exit 2
          ;;
      esac
      shift
    done
    if [[ "${uninstall_dry_run}" == 1 ]]; then
      _jsh_uninstall --dry-run
    else _jsh_uninstall; fi
    uninstall_status=$?
    ((uninstall_status == 0)) || exit "${uninstall_status}"
    ((uninstall_purge == 0)) || purge_checkout "${uninstall_dry_run}"
    ;;
  version | --version | -V)
    printf 'jsh 1.0.0\n'
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    _jsh_error "unknown command: ${command_name}"
    usage >&2
    exit 2
    ;;
esac
