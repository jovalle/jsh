#!/bin/sh
# Open this checkout's shell runtime without installing or configuring the machine.

set -eu
launcher=$0
case ${launcher} in /*) ;; *) launcher=${PWD}/${launcher} ;; esac
while [ -L "${launcher}" ]; do
	parent=$(CDPATH='' cd -P "${launcher%/*}" && pwd)
	target=$(readlink "${launcher}")
	case ${target} in /*) launcher=${target} ;; *) launcher=${parent}/${target} ;; esac
done
JSH_ROOT=$(CDPATH='' cd -P "${launcher%/*}/.." && pwd)
JSH_RUNTIME_DIR=${JSH_RUNTIME_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/jsh/runtime}
export JSH_ROOT JSH_RUNTIME_DIR
case ${1:-} in
-h | --help)
	printf '%s\n' 'Usage: jsh [shell-options]' \
		'       jsh update [GROUP ...]' \
		'Open Zsh, or Bash when Zsh is unavailable.' \
		'Update runs install.sh --update without closing open apps, then lists apps to restart.' \
		'Install and configure with install.sh and scripts/*.sh.'
	exit 0
	;;
update)
	shift
	JSH_KEEP_APPS=1
	export JSH_KEEP_APPS
	exec bash "${JSH_ROOT}/install.sh" --update "$@"
	;;
'' | -*) ;;
*)
	printf 'jsh: expected shell options; use install.sh or scripts/*.sh for setup\n' >&2
	exit 2
	;;
esac
[ "$#" -gt 0 ] || set -- -i
if command -v zsh >/dev/null 2>&1; then
	ZDOTDIR=${JSH_ROOT}/dotfiles
	export ZDOTDIR
	exec zsh -d "$@"
fi
command -v bash >/dev/null 2>&1 || {
	printf 'jsh: Zsh or Bash is required\n' >&2
	exit 127
}
# Bash ignores --rcfile for login shells; reject that mode before opening an empty runtime.
skip_next=0
for argument; do
	if [ "${skip_next}" = 1 ]; then
		skip_next=0
		continue
	fi
	case ${argument} in
	--) break ;;
	--login)
		printf 'jsh: Bash fallback does not support login mode; use jsh -i\n' >&2
		exit 2
		;;
	--*) ;;
	-[!-]*)
		case ${argument#-} in
		*l*)
			printf 'jsh: Bash fallback does not support login mode; use jsh -i\n' >&2
			exit 2
			;;
		esac
		case ${argument#-} in *c*) break ;; *o* | *O*) skip_next=1 ;; esac
		;;
	*) break ;;
	esac
done
exec bash --noprofile --rcfile "${JSH_ROOT}/dotfiles/.bashrc" "$@"
