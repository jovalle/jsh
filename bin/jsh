#!/bin/sh
# Open an isolated zsh with this checkout's dotfiles, including through symlinks.

set -eu
launcher=$0
case ${launcher} in /*) ;; *) launcher=${PWD}/${launcher} ;; esac
while [[ -L "${launcher}" ]]; do
  parent=$(CDPATH='' cd -P "${launcher%/*}" && pwd)
  target=$(readlink "${launcher}")
  case ${target} in /*) launcher=${target} ;; *) launcher=${parent}/${target} ;; esac
done
root=$(CDPATH='' cd -P "${launcher%/*}/.." && pwd)
command -v zsh >/dev/null 2>&1 || {
  printf 'jsh: zsh is required. Run: just install core\n' >&2
  exit 127
}
[[ -d "${root}/local/vendor/zsh-autosuggestions" ]] ||
  printf 'jsh: shell plugins are missing. Run: just install runtime\n' >&2
JSH_RUNTIME_DIR=${JSH_RUNTIME_DIR:-${root}/local/runtime}
ZDOTDIR=${root}/dotfiles
export JSH_RUNTIME_DIR ZDOTDIR
[[ "$#" -gt 0 ]] || set -- -i
exec zsh -d "$@"
