#!/usr/bin/env bash
# shellcheck shell=bash
#
# Run Neovim with Jsh-local runtime files, falling back to Vim or Vi.

set -o errexit
set -o nounset

jsh_root="${JSH_DIR:-${HOME}/.jsh}"
jsh_local="${JSH_LOCAL_DIR:-${jsh_root}/local}"

jsh_error() {
  if [[ "${JSH_PLAIN_OUTPUT:-0}" != 1 && "${TERM:-dumb}" != dumb &&
    -z ${NO_COLOR+x} && "${JSH_COLOR:-auto}" != never ]] \
    && { [[ -t 2 ]] || [[ "${JSH_COLOR:-auto}" == always ]]; }; then
    printf '\033[31m✖\033[0m %s\n' "$*" >&2
  else
    printf '[error] %s\n' "$*" >&2
  fi
}

if [[ "${1:-}" == --bootstrap ]]; then
  [[ "${JSH_OFFLINE:-0}" != 1 ]] || {
    jsh_error 'jvim: cannot bootstrap plugins while JSH_OFFLINE=1'
    exit 1
  }
  export JSH_ALLOW_NETWORK_BOOTSTRAP=1
  shift
fi

export XDG_CONFIG_HOME="${JSH_NVIM_CONFIG_HOME:-${jsh_root}/dotfiles/.config}"
export XDG_DATA_HOME="${JSH_NVIM_DATA_HOME:-${jsh_local}/share}"
export XDG_CACHE_HOME="${JSH_NVIM_CACHE_HOME:-${jsh_local}/cache}"
export XDG_STATE_HOME="${JSH_NVIM_STATE_HOME:-${jsh_local}/state}"

if [[ ! -d "${XDG_DATA_HOME}/nvim" || ! -d "${XDG_CACHE_HOME}/nvim" || ! -d "${XDG_STATE_HOME}/nvim" ]]; then
  mkdir -p \
    "${XDG_DATA_HOME}/nvim" \
    "${XDG_CACHE_HOME}/nvim" \
    "${XDG_STATE_HOME}/nvim"
fi

editor_bin="${jsh_local}/neovim/bin/nvim"
if [[ ! -x "${editor_bin}" ]]; then
  # Jsh's bin directory precedes Homebrew in PATH, so resolve Neovim while
  # explicitly excluding this wrapper's directory to prevent future recursion.
  wrapper_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
  search_path=""
  old_ifs="${IFS}"
  IFS=:
  for path_entry in ${PATH}; do
    if [[ -n "${path_entry}" && "${path_entry}" != "${wrapper_dir}" ]]; then
      search_path="${search_path:+${search_path}:}${path_entry}"
    fi
  done
  IFS="${old_ifs}"

  editor_bin=""
  for editor in nvim vim vi; do
    editor_bin="$(PATH="${search_path}" command -v "${editor}" || true)"
    [[ -z "${editor_bin}" ]] || break
  done
fi

if [[ -z "${editor_bin}" ]]; then
  jsh_error 'jvim: nvim, vim, and vi are not available in PATH'
  exit 127
fi

exec "${editor_bin}" "$@"
