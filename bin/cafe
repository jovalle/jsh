#!/usr/bin/env python3

import ctypes
import os
import platform
import shutil
import subprocess
import sys
import time
from ctypes import wintypes
from pathlib import Path


APP_NAME = "caffeine"
LINUX_CHILD_ARGUMENT = "--linux-inhibited"
MACOS_CHILD_ARGUMENT = "--macos-inhibited"
REASON = "Keep the screen active"
WINDOWS_ACTIVITY_INTERVAL_SECONDS = 30


def print_validation(summary: str, inspection_command: str) -> None:
    print(f"Validation: PASS - {summary}")
    print(f"Inspect: {inspection_command}", flush=True)


def wait_until_stopped(status: str, on_interval=None) -> None:
    print(f"Caffeine active: {status}")
    print("Press Ctrl+C to stop.", flush=True)

    try:
        while True:
            if on_interval is not None:
                on_interval()
            time.sleep(WINDOWS_ACTIVITY_INTERVAL_SECONDS)
    except KeyboardInterrupt:
        print("\nCaffeine stopped.", flush=True)


def run_linux() -> None:
    if sys.argv[1:] == [LINUX_CHILD_ARGUMENT]:
        inhibitor = shutil.which("gnome-session-inhibit")
        if inhibitor is None:
            raise RuntimeError("gnome-session-inhibit is required on Linux")

        result = subprocess.run(
            [inhibitor, "--list"],
            check=True,
            capture_output=True,
            text=True,
        )
        if f"{APP_NAME}: {REASON}" not in result.stdout:
            raise RuntimeError("GNOME idle and suspend inhibitor was not registered")
        print_validation(
            "GNOME idle and suspend inhibitor registered",
            "gnome-session-inhibit --list",
        )
        wait_until_stopped("idle lock, display sleep, and system sleep are inhibited")
        return

    if sys.argv[1:]:
        raise RuntimeError(f"usage: {Path(sys.argv[0]).name}")

    inhibitor = shutil.which("gnome-session-inhibit")
    if inhibitor is None:
        raise RuntimeError("gnome-session-inhibit is required on Linux")

    command = [
        inhibitor,
        "--app-id",
        APP_NAME,
        "--reason",
        REASON,
        "--inhibit",
        "idle:suspend",
        sys.executable,
        str(Path(__file__).resolve()),
        LINUX_CHILD_ARGUMENT,
    ]
    os.execv(inhibitor, command)


def run_macos() -> None:
    if sys.argv[1:] == [MACOS_CHILD_ARGUMENT]:
        result = subprocess.run(
            ["ps", "-p", str(os.getppid()), "-o", "comm="],
            check=True,
            capture_output=True,
            text=True,
        )
        if Path(result.stdout.strip()).name != "caffeinate":
            raise RuntimeError("macOS caffeinate assertion owner was not started")
        print_validation(
            "macOS display, user-idle, and system sleep assertions started",
            "pmset -g assertions",
        )
        wait_until_stopped("idle lock, display sleep, and system sleep are inhibited")
        return

    if sys.argv[1:]:
        raise RuntimeError(f"usage: {Path(sys.argv[0]).name}")

    inhibitor = shutil.which("caffeinate")
    if inhibitor is None:
        raise RuntimeError("caffeinate is required on macOS")

    command = [
        inhibitor,
        "-d",
        "-i",
        "-s",
        "-u",
        sys.executable,
        str(Path(__file__).resolve()),
        MACOS_CHILD_ARGUMENT,
    ]
    os.execv(inhibitor, command)


def windows_input_types():
    class KeyboardInput(ctypes.Structure):
        _fields_ = [
            ("virtual_key", wintypes.WORD),
            ("scan_code", wintypes.WORD),
            ("flags", wintypes.DWORD),
            ("time", wintypes.DWORD),
            ("extra_info", wintypes.WPARAM),
        ]

    class MouseInput(ctypes.Structure):
        _fields_ = [
            ("x", wintypes.LONG),
            ("y", wintypes.LONG),
            ("mouse_data", wintypes.DWORD),
            ("flags", wintypes.DWORD),
            ("time", wintypes.DWORD),
            ("extra_info", wintypes.WPARAM),
        ]

    class HardwareInput(ctypes.Structure):
        _fields_ = [
            ("message", wintypes.DWORD),
            ("parameter_low", wintypes.WORD),
            ("parameter_high", wintypes.WORD),
        ]

    class InputValue(ctypes.Union):
        _fields_ = [
            ("mouse", MouseInput),
            ("keyboard", KeyboardInput),
            ("hardware", HardwareInput),
        ]

    class Input(ctypes.Structure):
        _anonymous_ = ("value",)
        _fields_ = [("type", wintypes.DWORD), ("value", InputValue)]

    return KeyboardInput, Input


def run_windows() -> None:
    if sys.argv[1:]:
        raise RuntimeError(f"usage: {Path(sys.argv[0]).name}")

    execution_state_continuous = 0x80000000
    execution_state_system_required = 0x00000001
    execution_state_display_required = 0x00000002
    input_keyboard = 1
    virtual_key_f15 = 0x7E
    keyeventf_keyup = 0x0002
    keyboard_input, input_type = windows_input_types()

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    user32 = ctypes.WinDLL("user32", use_last_error=True)
    kernel32.SetThreadExecutionState.argtypes = [wintypes.DWORD]
    kernel32.SetThreadExecutionState.restype = wintypes.DWORD
    user32.SendInput.argtypes = [wintypes.UINT, ctypes.POINTER(input_type), ctypes.c_int]
    user32.SendInput.restype = wintypes.UINT

    required_state = (
        execution_state_continuous
        | execution_state_system_required
        | execution_state_display_required
    )
    if not kernel32.SetThreadExecutionState(required_state):
        raise ctypes.WinError(ctypes.get_last_error())

    key_events = (input_type * 2)(
        input_type(
            type=input_keyboard,
            keyboard=keyboard_input(virtual_key=virtual_key_f15),
        ),
        input_type(
            type=input_keyboard,
            keyboard=keyboard_input(
                virtual_key=virtual_key_f15,
                flags=keyeventf_keyup,
            ),
        ),
    )

    def report_activity() -> None:
        sent_events = user32.SendInput(
            len(key_events),
            key_events,
            ctypes.sizeof(input_type),
        )
        if sent_events != len(key_events):
            raise ctypes.WinError(ctypes.get_last_error())

    try:
        report_activity()
        print_validation(
            "Windows display and system execution state set; F15 activity sent",
            "powercfg /requests",
        )
        wait_until_stopped(
            "idle lock, display sleep, and system sleep are inhibited",
            report_activity,
        )
    finally:
        kernel32.SetThreadExecutionState(execution_state_continuous)


def main() -> int:
    system = platform.system()
    try:
        if system == "Linux":
            run_linux()
        elif system == "Darwin":
            run_macos()
        elif system == "Windows":
            run_windows()
        else:
            raise RuntimeError(f"unsupported operating system: {system}")
    except (OSError, RuntimeError) as error:
        print(f"{APP_NAME}: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
