#!/usr/bin/env bash
# shellcheck shell=bash
#
# Cross-platform utility to keep your system awake during long-running tasks.
# Works on macOS (caffeinate), Linux (systemd-inhibit, gnome-session-inhibit,
# xdg-screensaver), and falls back to keeping a process running.
#
# "Un cafe para mantener el sistema despierto"

set -euo pipefail

# =============================================================================
# Configuration
# =============================================================================

readonly SCRIPT_NAME="${0##*/}"
case $0 in
  /*) launcher=$0 ;;
  *) launcher=${PWD}/$0 ;;
esac
if [[ -z ${JSH_ROOT:-} ]]; then
  if [[ -n ${JSH_DIR:-} ]]; then
    JSH_ROOT=${JSH_DIR}
  elif [[ -f ${launcher%/*}/../lib/ui.sh ]]; then
    JSH_ROOT=$(CDPATH='' cd -P "${launcher%/*}/.." && pwd -P)
  else
    JSH_ROOT=${HOME}/.jsh
  fi
fi
# shellcheck source=../lib/ui.sh
. "${JSH_ROOT}/lib/ui.sh"
jsh::init

# Default duration (seconds) - 0 means indefinite
CAFE_DURATION="${CAFE_DURATION:-0}"

# Default inhibit reasons
CAFE_REASON="${CAFE_REASON:-User requested via cafe command}"

# Platform and backend overrides keep behavior deterministic in tests.
CAFE_PLATFORM="${CAFE_PLATFORM:-$(uname -s)}"
CAFE_CAFFEINATE_BIN="${CAFE_CAFFEINATE_BIN:-caffeinate}"

# PID file for background mode
readonly CAFE_PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/cafe.${USER:-$(id -un)}.pid"

CAFE_ACTIVE_PID=
CAFE_BACKEND_PID=
CAFE_READY_FILE=
CAFE_STOP_FILE=

# =============================================================================
# Output
# =============================================================================

if [[ "${JSH_PLAIN_OUTPUT:-0}" != 1 && "${TERM:-dumb}" != dumb &&
  -z ${NO_COLOR+x} && "${JSH_COLOR:-auto}" != never ]] \
  && { [[ -t 1 ]] || [[ "${JSH_COLOR:-auto}" == always ]]; }; then
  C_RESET=$'\033[0m' C_DIM=$'\033[2m' C_CYAN=$'\033[36m'
else
  C_RESET='' C_DIM=''
  C_CYAN=''
fi

die() {
  local message=$1
  shift
  jsh::log_error "${message}"
  for message in "$@"; do
    jsh::log_detail "  ${message}" >&2
  done
  exit 1
}
_debug() { printf '%sdebug:%s %s\n' "${C_DIM}" "${C_RESET}" "$*" >&2; }
jsh_command_preview() { printf '  %s$%s %s\n' "${C_CYAN}" "${C_RESET}" "$*"; }
cli_version() { printf 'cafe 1.0.1\n'; }
cli_help() {
  cat <<'EOF'
Usage: cafe [options] [command...]

Options:
  -t, --time DURATION  Keep awake for a duration such as 30m or 2h
  -d, --display        Also prevent display sleep
  -i, --idle           Prevent idle sleep
  -s, --system         Also prevent system sleep
  -b, --background     Run in the background
  -r, --reason TEXT    Set the displayed inhibit reason
      --status         Show background status
      --stop           Stop the background instance
      --xfce-status    Print XFCE Genmon status
      --xfce-toggle    Toggle Cafe from XFCE Genmon
  -v, --verbose        Show debug output
  -h, --help           Show help
      --version        Show version
EOF
}

# Override debug with script-specific env var
debug() { [[ "${CAFE_DEBUG:-0}" == "1" ]] && _debug "$@" || true; }

# =============================================================================
# Utilities
# =============================================================================

# Parse duration string to seconds
parse_duration() {
  local input="$1"
  local total=0

  # If it's just a number, assume seconds
  if [[ "${input}" =~ ^[0-9]+$ ]]; then
    printf '%s' "${input}"
    return 0
  fi

  # Parse combined format like "1h30m"
  local remaining="${input}"

  # Hours
  if [[ "${remaining}" =~ ([0-9]+)h(ours?|r)? ]]; then
    total=$((total + BASH_REMATCH[1] * 3600))
    remaining="${remaining/${BASH_REMATCH[0]}/}"
  fi

  # Minutes
  if [[ "${remaining}" =~ ([0-9]+)m(in(utes?)?)? ]]; then
    total=$((total + BASH_REMATCH[1] * 60))
    remaining="${remaining/${BASH_REMATCH[0]}/}"
  fi

  # Seconds
  if [[ "${remaining}" =~ ([0-9]+)s(ec(onds?)?)? ]]; then
    total=$((total + BASH_REMATCH[1]))
  fi

  if [[ "${total}" -eq 0 ]]; then
    die "Invalid duration format: ${input}" "Examples: 3600, 30m, 2h, 1h30m"
  fi

  printf '%s' "${total}"
}

# Format seconds to human-readable
format_duration() {
  local seconds="$1"
  local hours=$((seconds / 3600))
  local minutes=$(((seconds % 3600) / 60))
  local secs=$((seconds % 60))

  if [[ "${hours}" -gt 0 ]]; then
    printf '%dh%02dm%02ds' "${hours}" "${minutes}" "${secs}"
  elif [[ "${minutes}" -gt 0 ]]; then
    printf '%dm%02ds' "${minutes}" "${secs}"
  else
    printf '%ds' "${secs}"
  fi
}

render_tui_frame() {
  local frame=$(( $1 % 12 )) elapsed=$2
  local lines=${LINES:-24} columns=${COLUMNS:-80}
  local hours=$((elapsed / 3600)) minutes=$(((elapsed % 3600) / 60)) seconds=$((elapsed % 60))
  local -a steam=(
    '•    ' ' •   ' '  •  ' '   • ' '    •' '   • '
    '  •  ' ' •   ' '•    ' ' •   ' '  •  ' '   • '
  )

  if ((lines <= 3 || columns <= 12)); then
    printf 'Cafe'
    return
  fi

  if ((lines <= 10 || columns <= 24)); then
    printf 'Cafe %s\nCtrl+C to stop' "${steam[frame]// /}"
    return
  fi

  local rule
  printf -v rule '%*s' "${columns}" ''
  rule=${rule// /=}
  printf '%s\n%s\n   Cafe\n   %02dh %02dm %02ds\n   Method %s\n   Ctrl+C to stop\n%s' \
    "${rule}" "   ${steam[frame]}" "${hours}" "${minutes}" "${seconds}" \
    "${CAFE_METHOD:-unknown}" "${rule}"
}

enter_tui() {
  printf '\033[?1049h\033[H\033[?25l'
}

leave_tui() {
  printf '\033[?25h\033[?1049l'
}

wait_for_process() {
  local process_pid=$1 process_status
  CAFE_ACTIVE_PID=${process_pid}
  if wait "${process_pid}"; then
    process_status=0
  else
    process_status=$?
  fi
  CAFE_ACTIVE_PID=
  return "${process_status}"
}

run_tracked() {
  "$@" &
  wait_for_process "$!"
}

cleanup_active_state() {
  [[ -z "${CAFE_STOP_FILE}" ]] || : >"${CAFE_STOP_FILE}"
  if [[ -n "${CAFE_ACTIVE_PID}" ]]; then
    kill "${CAFE_ACTIVE_PID}" 2>/dev/null || true
    wait "${CAFE_ACTIVE_PID}" 2>/dev/null || true
    CAFE_ACTIVE_PID=
  fi
  if [[ -n "${CAFE_BACKEND_PID}" ]]; then
    kill "${CAFE_BACKEND_PID}" 2>/dev/null || true
    wait "${CAFE_BACKEND_PID}" 2>/dev/null || true
    CAFE_BACKEND_PID=
  fi
  [[ -z "${CAFE_READY_FILE}" ]] || rm -f "${CAFE_READY_FILE}"
  [[ -z "${CAFE_STOP_FILE}" ]] || rm -f "${CAFE_STOP_FILE}"
}

handle_signal() {
  local signal=$1 exit_status=130
  [[ "${signal}" != TERM ]] || exit_status=143
  cleanup_active_state
  printf '\n'
  jsh::log_note "Stopped"
  exit "${exit_status}"
}

# Check if background cafe is running
is_running() {
  if [[ -f "${CAFE_PID_FILE}" ]]; then
    local pid
    pid=$(cat "${CAFE_PID_FILE}" 2>/dev/null || true)
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
    # Stale PID file
    rm -f "${CAFE_PID_FILE}"
  fi
  return 1
}

# Show status
show_status() {
  if is_running; then
    local pid
    pid=$(cat "${CAFE_PID_FILE}")
    jsh::status ok "Cafe running, PID ${pid}"

    # Try to show remaining time on macOS
    if [[ "$(uname -s)" == "Darwin" ]]; then
      local start elapsed
      if stat -f %m "${CAFE_PID_FILE}" &>/dev/null; then
        start=$(stat -f %m "${CAFE_PID_FILE}")
        elapsed=$(($(date +%s) - start))
        jsh::log_detail "  Running for $(format_duration "${elapsed}")"
      fi
    fi
    return 0
  else
    jsh::status skip "Cafe not running"
    return 1
  fi
}

# Stop background cafe
stop_cafe() {
  if [[ -f "${CAFE_PID_FILE}" ]]; then
    local pid
    pid=$(cat "${CAFE_PID_FILE}" 2>/dev/null || true)
    if [[ -n "${pid}" ]]; then
      if kill -0 "${pid}" 2>/dev/null; then
        kill "${pid}" 2>/dev/null || true
        # Wait briefly for clean shutdown
        sleep 0.5
        # Force kill if still running
        kill -9 "${pid}" 2>/dev/null || true
        jsh::log_success "Stopped cafe (PID: ${pid})"
      fi
    fi
    rm -f "${CAFE_PID_FILE}"
  else
    jsh::log_note "No background cafe found"
  fi
}

show_xfce_status() {
  local icon tip root
  if is_running; then
    icon=cafe-on.svg
    tip="Cafe: Active (Sleep disabled - Click to allow sleep)"
  else
    icon=cafe-off.svg
    tip="Cafe: Inactive (Normal sleep - Click to disable sleep)"
  fi

  root=${JSH_ROOT:-${HOME}/.jsh}
  printf '<img>%s/assets/icons/%s</img><tool>%s</tool><click>%s/bin/cafe --xfce-toggle</click>\n' \
    "${root}" "${icon}" "${tip}" "${root}"
}

toggle_xfce() {
  local cafe_command plugin_file id
  cafe_command=${BASH_SOURCE[0]}

  if is_running; then
    stop_cafe >/dev/null 2>&1 || true
    xfconf-query -c xfce4-screensaver -p /saver/enabled -s true 2>/dev/null || true
    xfconf-query -c xfce4-screensaver -p /lock/enabled -s true 2>/dev/null || true
    xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/dpms-enabled -s true 2>/dev/null || true
    xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/presentation-mode -s false 2>/dev/null || true
    DISPLAY="${DISPLAY:-:0}" xset +dpms 2>/dev/null || true
    DISPLAY="${DISPLAY:-:0}" xset s on 2>/dev/null || true
  else
    "${cafe_command}" -b -d -s -i >/dev/null 2>&1 || true
    xfconf-query -c xfce4-screensaver -p /saver/enabled -s false 2>/dev/null || true
    xfconf-query -c xfce4-screensaver -p /lock/enabled -s false 2>/dev/null || true
    xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/dpms-enabled -s false 2>/dev/null || true
    xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/presentation-mode -n -t bool -s true 2>/dev/null || true
    DISPLAY="${DISPLAY:-:0}" xset -dpms 2>/dev/null || true
    DISPLAY="${DISPLAY:-:0}" xset s off 2>/dev/null || true
    DISPLAY="${DISPLAY:-:0}" xfce4-screensaver-command -d 2>/dev/null || true
  fi

  for plugin_file in "${HOME}/.config/xfce4/panel"/genmon-*.rc; do
    [[ -r "${plugin_file}" ]] || continue
    if grep -q -- '--xfce-status' "${plugin_file}" 2>/dev/null; then
      id=$(basename "${plugin_file}" .rc | sed 's/genmon-//')
      DISPLAY="${DISPLAY:-:0}" xfce4-panel --plugin-event="genmon-${id}:refresh:bool:true" 2>/dev/null || true
    fi
  done
}

# =============================================================================
# Inhibit Implementations
# =============================================================================

# macOS caffeinate
run_caffeinate() {
  local duration="$1"
  local display="$2"
  local system="$3"
  shift 3
  local cmd=("$@")

  local args=()

  # -i: prevent idle sleep
  args+=(-i)

  # -d: prevent display sleep
  [[ "${display}" == "true" ]] && args+=(-d)

  # -s: prevent system sleep
  [[ "${system}" == "true" ]] && args+=(-s)

  if [[ ${#cmd[@]} -gt 0 ]]; then
    debug "Running: caffeinate ${args[*]} -- ${cmd[*]}"
    run_tracked "${CAFE_CAFFEINATE_BIN}" "${args[@]}" -- "${cmd[@]}"
  else
    [[ "${duration}" -gt 0 ]] && cmd=(sleep "${duration}") || cmd=(sleep infinity)
    debug "Running: caffeinate ${args[*]} -- ${cmd[*]}"
    run_tracked "${CAFE_CAFFEINATE_BIN}" "${args[@]}" -- "${cmd[@]}"
  fi
}

# Linux systemd-inhibit
# Returns 0 on success, 1 on failure (allows cascade to next method)
run_systemd_inhibit() {
  local duration="$1"
  local display="$2"
  local system="$3"
  local reason="$4"
  shift 4

  local cmd=("$@")
  local what=idle
  [[ "${system}" != true ]] || what=idle:sleep:shutdown
  local args=(
    --what="${what}"
    --who="${SCRIPT_NAME}"
    --why="${reason}"
    --mode=block
  )

  if [[ ${#cmd[@]} -eq 0 ]]; then
    [[ "${duration}" -gt 0 ]] && cmd=(sleep "${duration}") || cmd=(sleep infinity)
  fi
  debug "Running: systemd-inhibit --what=${what} --mode=block"
  run_tracked systemd-inhibit "${args[@]}" -- "${cmd[@]}" 2>/dev/null
}

run_powershell_inhibit() {
  local duration=$1 display=$2
  shift 4
  local cmd=("$@") state=0x80000001 attempt command_status=0
  [[ "${display}" != true ]] || state=0x80000003

  CAFE_READY_FILE="${XDG_RUNTIME_DIR:-/tmp}/cafe.${USER:-$(id -un)}.$$.ready"
  CAFE_STOP_FILE="${XDG_RUNTIME_DIR:-/tmp}/cafe.${USER:-$(id -un)}.$$.stop"
  rm -f "${CAFE_READY_FILE}" "${CAFE_STOP_FILE}"
  WSLENV="${WSLENV:+${WSLENV}:}CAFE_READY_FILE:CAFE_STOP_FILE"
  export CAFE_READY_FILE CAFE_STOP_FILE WSLENV

  powershell.exe -NoProfile -NonInteractive -Command \
    "[void][Cafe.NativeMethods]::SetThreadExecutionState(${state}); SetThreadExecutionState; while (-not (Test-Path \$env:CAFE_STOP_FILE)) { Start-Sleep -Milliseconds 50 }; [void][Cafe.NativeMethods]::SetThreadExecutionState(0x80000000)" &
  CAFE_BACKEND_PID=$!

  for ((attempt = 0; attempt < 250; attempt++)); do
    [[ ! -e "${CAFE_READY_FILE}" ]] || break
    if ! kill -0 "${CAFE_BACKEND_PID}" 2>/dev/null; then
      wait "${CAFE_BACKEND_PID}" 2>/dev/null || true
      CAFE_BACKEND_PID=
      cleanup_active_state
      return 1
    fi
    sleep 0.02
  done
  [[ -e "${CAFE_READY_FILE}" ]] || {
    cleanup_active_state
    return 1
  }

  if [[ ${#cmd[@]} -eq 0 ]]; then
    [[ "${duration}" -gt 0 ]] && cmd=(sleep "${duration}") || cmd=(sleep infinity)
  fi
  if run_tracked "${cmd[@]}"; then
    command_status=0
  else
    command_status=$?
  fi
  : >"${CAFE_STOP_FILE}"
  wait "${CAFE_BACKEND_PID}" 2>/dev/null || true
  CAFE_BACKEND_PID=
  rm -f "${CAFE_READY_FILE}" "${CAFE_STOP_FILE}"
  CAFE_READY_FILE='' CAFE_STOP_FILE=''
  return "${command_status}"
}

# Linux gnome-session-inhibit
# Returns 0 on success, 1 on failure (allows cascade to next method)
run_gnome_inhibit() {
  local duration="$1"
  local display="$2"
  local system="$3"
  local reason="$4"
  shift 4
  local cmd=("$@")

  local what="idle:suspend"
  [[ "${display}" == "true" ]] && what="${what}:idle"

  # gnome-session-inhibit uses space-separated args, not = format
  local args=(
    --app-id "${SCRIPT_NAME}"
    --reason "${reason}"
    --inhibit "${what}"
  )

  if [[ ${#cmd[@]} -gt 0 ]]; then
    debug "Trying: gnome-session-inhibit ${args[*]} -- ${cmd[*]}"
    if run_tracked gnome-session-inhibit "${args[@]}" -- "${cmd[@]}" 2>/dev/null; then
      return 0
    fi
  else
    # Use --inhibit-only when no command is provided
    if [[ "${duration}" -gt 0 ]]; then
      # With duration, use timeout to limit the inhibit
      debug "Trying: gnome-session-inhibit ${args[*]} -- sleep ${duration}"
      if run_tracked gnome-session-inhibit "${args[@]}" -- sleep "${duration}" 2>/dev/null; then
        return 0
      fi
    else
      # No duration, use --inhibit-ony for indefinite inhibit
      debug "Trying: gnome-session-inhibit ${args[*]} --inhibit-only"
      if run_tracked gnome-session-inhibit "${args[@]}" --inhibit-only 2>/dev/null; then
        return 0
      fi
    fi
  fi

  debug "gnome-session-inhibit failed"
  return 1
}

# X11 xdg-screensaver fallback
# Returns 0 on success, 1 on failure (allows cascade to next method)
run_xdg_inhibit() {
  local duration="$1"
  shift 4 # Skip duration, display, system, reason
  local cmd=("$@")

  # Requires X11 display
  if [[ -z "${DISPLAY:-}" ]]; then
    debug "xdg-screensaver requires DISPLAY (no X11 session)"
    return 1
  fi

  # Get a window ID (use root window if none)
  local window_id
  if command -v xdotool &>/dev/null; then
    window_id=$(xdotool getactivewindow 2>/dev/null || echo "root")
  else
    window_id="root"
  fi

  # Test if xdg-screensaver actually works
  if ! xdg-screensaver suspend "${window_id}" 2>/dev/null; then
    debug "xdg-screensaver suspend failed"
    return 1
  fi

  debug "xdg-screensaver inhibit active"

  # Cleanup on exit
  cleanup() {
    xdg-screensaver resume "${window_id}" 2>/dev/null || true
  }
  trap cleanup EXIT

  if [[ ${#cmd[@]} -gt 0 ]]; then
    "${cmd[@]}"
  else
    if [[ "${duration}" -gt 0 ]]; then
      sleep "${duration}"
    else
      sleep infinity
    fi
  fi
  return 0
}

# A wrapped command can still run without inhibition, but idle waiting cannot
# prevent sleep and must not claim success.
run_fallback() {
  local duration="$1"
  shift 4 # Skip duration, display, system, reason
  local cmd=("$@")

  jsh::log_warn "No system inhibit method available, using fallback"
  jsh::log_note "System may still sleep - consider installing systemd-inhibit"

  if [[ ${#cmd[@]} -gt 0 ]]; then
    "${cmd[@]}"
  else
    die "No supported system inhibit method is available"
  fi
}

# =============================================================================
# Cascading Inhibit Runner
# =============================================================================

# Try each inhibit method in sequence until one succeeds
# This handles cases where a tool exists but fails (e.g., permissions)
run_inhibit() {
  local duration="$1"
  local display="$2"
  local system="$3"
  local reason="$4"
  shift 4
  local cmd=("$@")

  local methods=()
  local method
  local method_status=0

  # Build list of available methods based on platform
  case "${CAFE_PLATFORM}" in
    Darwin)
      command -v "${CAFE_CAFFEINATE_BIN}" &>/dev/null && methods+=(caffeinate)
      ;;
    WSL)
      command -v powershell.exe &>/dev/null && methods+=(powershell)
      ;;
    Linux)
      command -v systemd-inhibit &>/dev/null && methods+=(systemd-inhibit)
      command -v gnome-session-inhibit &>/dev/null && methods+=(gnome-session-inhibit)
      command -v xdg-screensaver &>/dev/null && methods+=(xdg-screensaver)
      ;;
  esac

  # Always have fallback as last resort
  methods+=(fallback)

  # Try each method until one succeeds
  for method in "${methods[@]}"; do
    debug "Trying inhibit method: ${method}"

    case "${method}" in
      caffeinate)
        if run_caffeinate "${duration}" "${display}" "${system}" "${cmd[@]}"; then
          return 0
        else
          method_status=$?
        fi
        ;;
      powershell)
        if run_powershell_inhibit "${duration}" "${display}" "${system}" "${reason}" "${cmd[@]}"; then
          return 0
        else
          method_status=$?
        fi
        ;;
      systemd-inhibit)
        if run_systemd_inhibit "${duration}" "${display}" "${system}" "${reason}" "${cmd[@]}"; then
          return 0
        else
          method_status=$?
        fi
        ;;
      gnome-session-inhibit)
        if run_gnome_inhibit "${duration}" "${display}" "${system}" "${reason}" "${cmd[@]}"; then
          return 0
        else
          method_status=$?
        fi
        ;;
      xdg-screensaver)
        if run_xdg_inhibit "${duration}" "${display}" "${system}" "${reason}" "${cmd[@]}"; then
          return 0
        else
          method_status=$?
        fi
        ;;
      fallback)
        if [[ ${#cmd[@]} -gt 0 ]]; then
          run_fallback "${duration}" "${display}" "${system}" "${reason}" "${cmd[@]}"
        else
          run_fallback "${duration}" "${display}" "${system}" "${reason}"
        fi
        return $?
        ;;
    esac

    if [[ ${#cmd[@]} -gt 0 ]]; then
      return "${method_status}"
    fi

    debug "${method} failed, trying next method..."
  done

  return 0
}

# Get the first available method name (for display purposes)
get_primary_method() {
  case "${CAFE_PLATFORM}" in
    Darwin)
      command -v "${CAFE_CAFFEINATE_BIN}" &>/dev/null && {
        printf 'caffeinate'
        return
      }
      ;;
    WSL)
      command -v powershell.exe &>/dev/null && {
        printf 'powershell.exe'
        return
      }
      ;;
    Linux)
      command -v systemd-inhibit &>/dev/null && {
        printf 'systemd-inhibit'
        return
      }
      command -v gnome-session-inhibit &>/dev/null && {
        printf 'gnome-session-inhibit'
        return
      }
      command -v xdg-screensaver &>/dev/null && {
        printf 'xdg-screensaver'
        return
      }
      ;;
  esac
  printf 'fallback'
}

# =============================================================================
# Main
# =============================================================================

main() {
  local duration="${CAFE_DURATION}"
  local display=false
  local system=false
  local background=false
  local reason="${CAFE_REASON}"
  local verbose=false

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        cli_help
        exit 0
        ;;
      --version)
        cli_version
        exit 0
        ;;
      --status)
        show_status
        exit $?
        ;;
      --stop)
        stop_cafe
        exit 0
        ;;
      --xfce-status)
        show_xfce_status
        exit 0
        ;;
      --xfce-toggle)
        toggle_xfce
        exit 0
        ;;
      -t | --time)
        [[ $# -lt 2 ]] && die "Option $1 requires an argument"
        duration=$(parse_duration "$2")
        shift 2
        ;;
      -d | --display)
        display=true
        shift
        ;;
      -i | --idle)
        # Idle-only is the default behavior, this is a no-op for compatibility
        shift
        ;;
      -s | --system)
        system=true
        shift
        ;;
      -b | --background)
        background=true
        shift
        ;;
      -r | --reason)
        [[ $# -lt 2 ]] && die "Option $1 requires an argument"
        reason="$2"
        shift 2
        ;;
      -v | --verbose)
        verbose=true
        CAFE_DEBUG=1
        export CAFE_DEBUG
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "Unknown option: $1 (use --help for usage)"
        ;;
      *)
        break
        ;;
    esac
  done

  # Remaining args are the command to wrap
  local cmd=("$@")

  # Get primary method name (for display - actual method may cascade)
  local method
  method=$(get_primary_method)
  CAFE_METHOD=${method}
  export CAFE_METHOD
  debug "Primary inhibit method: ${method} (will cascade on failure)"

  # Check for existing background process
  if [[ "${background}" == "true" ]]; then
    if is_running; then
      jsh::log_warn "Cafe is already running in background"
      show_status
      exit 0
    fi
    if [[ "${method}" == fallback && ${#cmd[@]} -eq 0 ]]; then
      die "No supported system inhibit method is available"
    fi
  fi

  # Show what we're doing
  if [[ "${verbose}" == "true" || "${background}" != "true" ]]; then
    if [[ ${#cmd[@]} -gt 0 ]]; then
      jsh::log_note "Running command with sleep inhibited..."
    elif [[ "${duration}" -gt 0 ]]; then
      jsh::log_note "Keeping awake for $(format_duration "${duration}")..."
    else
      jsh::log_note "Keeping awake indefinitely (Ctrl+C to stop)..."
    fi
    jsh::status info "Method ${method}, automatic"
    jsh::status info "Display sleep ${display}"
    jsh::status info "System sleep ${system}"
  fi

  # Background mode
  if [[ "${background}" == "true" ]]; then
    (
      cleanup_background() {
        local owner
        owner=$(cat "${CAFE_PID_FILE}" 2>/dev/null || true)
        [[ "${owner}" != "${BASHPID}" ]] || rm -f "${CAFE_PID_FILE}"
      }
      trap 'cleanup_active_state; cleanup_background' EXIT

      # Daemonize
      cd /
      exec >/dev/null 2>&1
      exec </dev/null

      while [[ ! -e "${CAFE_PID_FILE}" ]]; do
        sleep 0.01
      done

      # Run inhibit with automatic cascade on failure
      if [[ ${#cmd[@]} -gt 0 ]]; then
        run_inhibit "${duration}" "${display}" "${system}" "${reason}" "${cmd[@]}"
      else
        run_inhibit "${duration}" "${display}" "${system}" "${reason}"
      fi
    ) &

    local bg_pid=$!
    printf '%s' "${bg_pid}" >"${CAFE_PID_FILE}"
    jsh::log_success "Started in background (PID: ${bg_pid})"
    jsh_command_preview "${SCRIPT_NAME} --stop"
    exit 0
  fi

  # Foreground mode - use cascading inhibit
  if [[ ${#cmd[@]} -gt 0 ]]; then
    run_inhibit "${duration}" "${display}" "${system}" "${reason}" "${cmd[@]}"
  else
    run_inhibit "${duration}" "${display}" "${system}" "${reason}"
  fi

  if [[ ${#cmd[@]} -eq 0 && "${duration}" -gt 0 ]]; then
    jsh::log_success "Cafe stopped"
  fi
}

# Handle interrupts gracefully
trap 'handle_signal INT' INT
trap 'handle_signal TERM' TERM

if [[ "${CAFE_SOURCE_ONLY:-0}" != 1 ]]; then
  main "$@"
fi
