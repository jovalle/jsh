#!/usr/bin/env python3
"""
ventoy: Automated ISO reconciliation and updater for Ventoy drives.

Dynamically fetches the latest upstream releases for:
  - Windows 11 Pro / Multi-Edition (via msdl / Microsoft CDN)
  - Ubuntu Desktop LTS (Noble / Resolute)
  - Ubuntu Server LTS
  - Fedora Workstation (latest stable)
  - Fedora Server (latest stable)
  - Fedora CoreOS (stable metal stream)
  - Linux Mint Cinnamon
  - Talos Linux Bare-Metal (Kubernetes OS)
  - Kali Linux Live
  - Rescue & Diagnostics Toolkit:
      - SystemRescue (system-rescue.org)
      - GParted Live
      - Clonezilla Live
      - Arch Linux Installation & Rescue Media
      - Tails Amnesic Incognito Live System
      - Proxmox VE Bare-Metal Installer
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

VERSION = "1.1.0"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"


# ANSI Terminal Colors
class Colors:
    HEADER = "\033[95m"
    BLUE = "\033[94m"
    CYAN = "\033[96m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    RED = "\033[91m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    NC = "\033[0m"

    @classmethod
    def strip_if_not_tty(cls):
        if not sys.stdout.isatty():
            cls.HEADER = ""
            cls.BLUE = ""
            cls.CYAN = ""
            cls.GREEN = ""
            cls.YELLOW = ""
            cls.RED = ""
            cls.BOLD = ""
            cls.DIM = ""
            cls.NC = ""


Colors.strip_if_not_tty()


def fetch_url(url, timeout=15):
    """Fetch URL contents using curl with fallback to urllib."""
    try:
        p = subprocess.run(
            ["curl", "-sL", "--compressed", "-m", str(timeout), "-A", USER_AGENT, url],
            capture_output=True,
            text=True,
            timeout=timeout + 3,
        )
        if p.returncode == 0 and p.stdout:
            return p.stdout
    except Exception:
        pass

    # Fallback to urllib
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "*/*"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", errors="ignore")


def format_bytes(n):
    """Format bytes into human-readable string."""
    if n is None or n < 0:
        return "Unknown"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if n < 1024.0 or unit == "TB":
            return f"{n:.2f} {unit}" if unit in ["GB", "TB"] else f"{n:.1f} {unit}"
        n /= 1024.0
    return f"{n:.2f} TB"


# ==============================================================================
# Upstream Distro Resolvers
# ==============================================================================


def resolve_win11():
    """Resolve latest Windows 11 Consumer / Pro x64 download from Microsoft."""
    msdl_path = shutil.which("msdl") or "/usr/local/bin/msdl"
    if os.path.exists(msdl_path):
        try:
            # Query msdl list to find newest Windows 11 product ID
            proc = subprocess.run([msdl_path, "--list"], capture_output=True, text=True, timeout=8)
            combined = (proc.stdout or "") + "\n" + (proc.stderr or "")
            candidates = []
            for line in combined.splitlines():
                m = re.match(r"\s*(\d+)\s+(Windows 11\b.*)", line)
                if m:
                    pid, title = int(m.group(1)), m.group(2).strip()
                    if "Arm64" not in title and "China" not in title:
                        candidates.append((pid, title))

            latest_pid = sorted(candidates, key=lambda x: x[0])[-1][0] if candidates else 3321
            dl_proc = subprocess.run(
                [msdl_path, "--id", str(latest_pid), "--lang", "English", "--no-contribute"],
                input="\n",
                capture_output=True,
                text=True,
                timeout=12,
            )
            out = (dl_proc.stdout or "") + "\n" + (dl_proc.stderr or "")
            link_match = re.search(r"(https://software\.download\.prss\.microsoft\.com[^\s]+)", out)
            if link_match:
                url = link_match.group(1)
                fn_match = re.search(r"/([^/?]+)\.iso", url)
                filename = f"{fn_match.group(1)}.iso" if fn_match else "Win11_English_x64.iso"
                return {"url": url, "filename": filename, "version": filename.replace(".iso", "")}
        except Exception:
            pass

    # Microsoft official static direct evaluation / LTSC media
    static_url = "https://software-static.download.prss.microsoft.com/dbazure/888969d5-f34g-4e03-ac9d-1f9786c66749/26100.1742.240906-0331.ge_release_svc_refresh_CLIENT_LTSC_EVAL_x64FRE_en-us.iso"
    return {
        "url": static_url,
        "filename": "Win11_24H2_Enterprise_LTSC_en-us.iso",
        "version": "Win11-24H2-LTSC",
        "note": "Official Microsoft CDN Media",
    }


def resolve_ubuntu(flavor="desktop"):
    """Resolve latest Ubuntu LTS Desktop or Server ISO."""
    html = fetch_url("https://releases.ubuntu.com/")
    versions = sorted(
        re.findall(r'href="(\d+\.\d+(?:\.\d+)?)/"', html),
        key=lambda x: [int(p) for p in x.split(".")],
    )
    lts_dirs = [v for v in versions if int(v.split(".")[0]) % 2 == 0 and v.split(".")[1] == "04"]
    target_ver = lts_dirs[-1]

    vhtml = fetch_url(f"https://releases.ubuntu.com/{target_ver}/")
    kw = "desktop" if flavor == "desktop" else "live-server"
    pattern = rf'(ubuntu-{target_ver}[^"]*-{kw}-amd64\.iso)'
    matches = re.findall(pattern, vhtml)
    if not matches:
        raise RuntimeError(
            f"Could not find Ubuntu {flavor} ISO in releases.ubuntu.com/{target_ver}/"
        )
    iso_name = matches[-1]
    url = f"https://releases.ubuntu.com/{target_ver}/{iso_name}"

    sha = None
    try:
        sums = fetch_url(f"https://releases.ubuntu.com/{target_ver}/SHA256SUMS")
        for line in sums.splitlines():
            if iso_name in line:
                sha = line.split()[0]
                break
    except Exception:
        pass

    return {
        "url": url,
        "filename": iso_name,
        "version": iso_name.replace(f"-{kw}-amd64.iso", "").replace("ubuntu-", ""),
        "sha256": sha,
    }


def resolve_fedora(edition="Workstation"):
    """Resolve latest Fedora Workstation or Server ISO."""
    mirrors = [
        "https://mirrors.kernel.org/fedora/releases/",
        "https://dl.fedoraproject.org/pub/fedora/linux/releases/",
    ]
    for mirror in mirrors:
        try:
            html = fetch_url(mirror)
            matches = re.findall(r'href="(\d+)/"', html)
            versions = sorted(set(int(x) for x in matches))
            for v in reversed(versions):
                try:
                    url = f"{mirror}{v}/{edition}/x86_64/iso/"
                    vhtml = fetch_url(url)
                    isos = re.findall(rf'(Fedora-(?:{edition}|Server)[^"]*\.iso)', vhtml)
                    if isos:
                        if edition == "Server":
                            isos = [i for i in isos if "netinst" not in i] or isos
                        target_iso = isos[0]
                        return {
                            "url": f"{url}{target_iso}",
                            "filename": target_iso,
                            "version": f"Fedora-{v}",
                        }
                except Exception:
                    continue
        except Exception:
            continue
    raise RuntimeError(f"Fedora {edition} release not found")


def resolve_coreos():
    """Resolve latest Fedora CoreOS stable metal ISO."""
    raw = fetch_url("https://builds.coreos.fedoraproject.org/streams/stable.json")
    data = json.loads(raw)
    metal = data["architectures"]["x86_64"]["artifacts"]["metal"]["formats"]["iso"]["disk"]
    url = metal["location"]
    fn = url.split("/")[-1]
    return {
        "url": url,
        "filename": fn,
        "version": fn.replace("fedora-coreos-", "").replace("-live-iso.x86_64.iso", ""),
        "sha256": metal.get("sha256"),
    }


def resolve_linux_mint():
    """Resolve latest Linux Mint Cinnamon 64-bit ISO."""
    html = fetch_url("https://mirrors.kernel.org/linuxmint/stable/")
    versions = sorted(
        re.findall(r'href="(\d+(?:\.\d+)?)/"', html), key=lambda x: [int(p) for p in x.split(".")]
    )
    latest = versions[-1]
    vhtml = fetch_url(f"https://mirrors.kernel.org/linuxmint/stable/{latest}/")
    isos = re.findall(r'(linuxmint-[^"]*-cinnamon-64bit\.iso)', vhtml)
    if not isos:
        raise RuntimeError(f"Linux Mint ISO not found in version {latest}")
    target_iso = isos[0]
    sha = None
    try:
        sums = fetch_url(f"https://mirrors.kernel.org/linuxmint/stable/{latest}/sha256sum.txt")
        for line in sums.splitlines():
            if target_iso in line:
                sha = line.split()[0]
                break
    except Exception:
        pass

    return {
        "url": f"https://mirrors.kernel.org/linuxmint/stable/{latest}/{target_iso}",
        "filename": target_iso,
        "version": f"Mint-{latest}",
        "sha256": sha,
    }


def resolve_talos():
    """Resolve latest Talos Linux bare-metal ISO from SideroLabs GitHub releases."""
    raw = fetch_url("https://api.github.com/repos/siderolabs/talos/releases/latest")
    data = json.loads(raw)
    tag = data["tag_name"]
    for asset in data["assets"]:
        if asset["name"] == "metal-amd64.iso":
            url = asset["browser_download_url"]
            fn = f"talos-{tag}-metal-amd64.iso"
            sha = None
            for a2 in data["assets"]:
                if a2["name"] == "sha256sum.txt":
                    try:
                        sums = fetch_url(a2["browser_download_url"])
                        for line in sums.splitlines():
                            if "metal-amd64.iso" in line:
                                sha = line.split()[0]
                                break
                    except Exception:
                        pass
            return {"url": url, "filename": fn, "version": tag, "sha256": sha}
    raise RuntimeError("Talos metal-amd64.iso asset not found in GitHub release")


def resolve_kali():
    """Resolve latest Kali Linux Live 64-bit ISO."""
    html = fetch_url("https://cdimage.kali.org/current/")
    isos = re.findall(r"(kali-linux-[\d\.]+-live-amd64\.iso)", html)
    if not isos:
        raise RuntimeError("Kali Live ISO not found")
    target_iso = sorted(set(isos))[-1]
    sha = None
    try:
        sums = fetch_url("https://cdimage.kali.org/current/SHA256SUMS")
        for line in sums.splitlines():
            if target_iso in line:
                sha = line.split()[0]
                break
    except Exception:
        pass

    return {
        "url": f"https://cdimage.kali.org/current/{target_iso}",
        "filename": target_iso,
        "version": target_iso.replace("kali-linux-", "").replace("-live-amd64.iso", ""),
        "sha256": sha,
    }


def resolve_systemrescue():
    """Resolve latest SystemRescue amd64 ISO."""
    html = fetch_url("https://www.system-rescue.org/Download/")
    urls = re.findall(r'href="(https://[^"]*systemrescue-[^"]*-amd64\.iso)"', html)
    if not urls:
        raise RuntimeError("SystemRescue download URL not found")
    url = urls[0]
    fn = url.split("/")[-1]
    ver = re.search(r"systemrescue-([0-9\.]+)-amd64", fn)
    return {"url": url, "filename": fn, "version": ver.group(1) if ver else "latest"}


def resolve_gparted():
    """Resolve latest GParted Live amd64 ISO via SourceForge release RSS."""
    rss = fetch_url("https://sourceforge.net/projects/gparted/rss?path=/gparted-live-stable")
    urls = re.findall(r'(https://[^"]*gparted-live-([0-9\.\-]+)-amd64\.iso)', rss)
    if not urls:
        raise RuntimeError("GParted release ISO not found in RSS")
    url, ver = urls[0]
    fn = f"gparted-live-{ver}-amd64.iso"
    direct_url = f"https://downloads.sourceforge.net/project/gparted/gparted-live-stable/{ver}/{fn}"
    return {"url": direct_url, "filename": fn, "version": ver}


def resolve_clonezilla():
    """Resolve latest Clonezilla Live amd64 ISO via SourceForge release RSS."""
    rss = fetch_url("https://sourceforge.net/projects/clonezilla/rss?path=/clonezilla_live_stable")
    urls = re.findall(r'(https://[^"]*clonezilla-live-([0-9\.\-]+)-amd64\.iso)', rss)
    if not urls:
        raise RuntimeError("Clonezilla release ISO not found in RSS")
    url, ver = urls[0]
    fn = f"clonezilla-live-{ver}-amd64.iso"
    direct_url = (
        f"https://downloads.sourceforge.net/project/clonezilla/clonezilla_live_stable/{ver}/{fn}"
    )
    return {"url": direct_url, "filename": fn, "version": ver}


def resolve_archlinux():
    """Resolve latest monthly Arch Linux ISO."""
    html = fetch_url("https://geo.mirror.pkgbuild.com/iso/latest/")
    isos = re.findall(r'href="(archlinux-[^"]*\.iso)"', html)
    if not isos:
        raise RuntimeError("Arch Linux ISO not found")
    target_iso = isos[0]
    sha = None
    try:
        sums = fetch_url("https://geo.mirror.pkgbuild.com/iso/latest/sha256sums.txt")
        for line in sums.splitlines():
            if target_iso in line:
                sha = line.split()[0]
                break
    except Exception:
        pass
    ver = re.search(r"archlinux-([0-9\.]+)-x86_64", target_iso)
    return {
        "url": f"https://geo.mirror.pkgbuild.com/iso/latest/{target_iso}",
        "filename": target_iso,
        "version": ver.group(1) if ver else "latest",
        "sha256": sha,
    }


def resolve_tails():
    """Resolve latest Tails Live ISO."""
    html = fetch_url("https://tails.net/install/download/")
    m = re.findall(
        r'(https://download\.tails\.net/tails/stable/tails-amd64-([^/"]+)/tails-amd64-[^/"]+\.iso)',
        html,
    )
    if not m:
        raise RuntimeError("Tails ISO link not found")
    url, ver = m[0]
    fn = url.split("/")[-1]
    return {"url": url, "filename": fn, "version": ver}


def resolve_proxmox():
    """Resolve latest Proxmox VE bare-metal installer ISO."""
    html = fetch_url("https://enterprise.proxmox.com/iso/")
    isos = re.findall(r'(proxmox-ve_[0-9][^"\'>\s]*\.iso)', html)
    if not isos:
        raise RuntimeError("Proxmox VE ISO not found")
    x86_isos = [i for i in set(isos) if "arm64" not in i]
    target_iso = sorted(x86_isos)[-1]
    ver = re.search(r"proxmox-ve_([0-9\.\-]+)\.iso", target_iso)
    return {
        "url": f"https://enterprise.proxmox.com/iso/{target_iso}",
        "filename": target_iso,
        "version": ver.group(1) if ver else "latest",
    }


