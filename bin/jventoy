DISTROS = {
    "win11": {
        "name": "Windows 11 Pro x64",
        "category": "windows",
        "rel_dir": "windows",
        "pattern": r"^(?:Win11_|win11|26100\.).*?\.iso$",
        "resolver": resolve_win11,
    },
    "ubuntu-desktop": {
        "name": "Ubuntu Desktop LTS",
        "category": "ubuntu",
        "rel_dir": "ubuntu",
        "pattern": r"^ubuntu-[\d\.]+-desktop-amd64\.iso$",
        "resolver": lambda: resolve_ubuntu("desktop"),
    },
    "ubuntu-server": {
        "name": "Ubuntu Server LTS",
        "category": "ubuntu",
        "rel_dir": "ubuntu",
        "pattern": r"^ubuntu-[\d\.]+-live-server-amd64\.iso$",
        "resolver": lambda: resolve_ubuntu("server"),
    },
    "fedora-workstation": {
        "name": "Fedora Workstation",
        "category": "fedora",
        "rel_dir": "fedora",
        "pattern": r"^Fedora-Workstation-Live-.*?\.iso$",
        "resolver": lambda: resolve_fedora("Workstation"),
    },
    "fedora-server": {
        "name": "Fedora Server DVD",
        "category": "fedora",
        "rel_dir": "fedora",
        "pattern": r"^Fedora-Server-dvd-.*?\.iso$",
        "resolver": lambda: resolve_fedora("Server"),
    },
    "coreos": {
        "name": "Fedora CoreOS Metal",
        "category": "fedora",
        "rel_dir": "fedora",
        "pattern": r"^fedora-coreos-.*?\.iso$",
        "resolver": resolve_coreos,
    },
    "linux-mint": {
        "name": "Linux Mint Cinnamon",
        "category": "mint",
        "rel_dir": "mint",
        "pattern": r"^linuxmint-[\d\.]+-cinnamon-64bit\.iso$",
        "resolver": resolve_linux_mint,
    },
    "talos": {
        "name": "Talos Linux Bare-Metal",
        "category": "talos",
        "rel_dir": "talos",
        "pattern": r"^talos-.*?\.iso$",
        "resolver": resolve_talos,
    },
    "kali": {
        "name": "Kali Linux Live 64-bit",
        "category": "kali",
        "rel_dir": "kali",
        "pattern": r"^kali-linux-[\d\.]+-live-amd64\.iso$",
        "resolver": resolve_kali,
    },
    "systemrescue": {
        "name": "SystemRescue Live",
        "category": "rescue",
        "rel_dir": "rescue",
        "pattern": r"^systemrescue-.*?\.iso$",
        "resolver": resolve_systemrescue,
    },
    "gparted": {
        "name": "GParted Live",
        "category": "rescue",
        "rel_dir": "rescue",
        "pattern": r"^gparted-live-.*?\.iso$",
        "resolver": resolve_gparted,
