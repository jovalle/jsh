    "clonezilla": {
        "name": "Clonezilla Live",
        "category": "rescue",
        "rel_dir": "rescue",
        "pattern": r"^clonezilla-live-.*?\.iso$",
        "resolver": resolve_clonezilla,
    },
    "archlinux": {
        "name": "Arch Linux Install/Live",
        "category": "rescue",
        "rel_dir": "rescue",
        "pattern": r"^archlinux-.*?\.iso$",
        "resolver": resolve_archlinux,
    },
    "tails": {
