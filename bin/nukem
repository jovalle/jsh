#!/usr/bin/env bash
# shellcheck shell=bash
#
# Safely removes finalizers from a namespace that's stuck terminating.
# This is a destructive operation - use with caution.

set -euo pipefail

SELF=nukem
case $0 in
  /*) launcher=$0 ;;
  *) launcher=${PWD}/$0 ;;
esac
if [[ -z ${JSH_ROOT:-} ]]; then
  if [[ -n ${JSH_DIR:-} ]]; then
    JSH_ROOT=${JSH_DIR}
  elif [[ -f ${launcher%/*}/../lib/ui.sh ]]; then
    JSH_ROOT=$(CDPATH='' cd -P "${launcher%/*}/.." && pwd -P)
  else
    JSH_ROOT=${HOME}/.jsh
  fi
fi
# shellcheck source=../lib/ui.sh
. "${JSH_ROOT}/lib/ui.sh"
if exec 9<>/dev/tty 2> /dev/null; then
  jsh::init --input-fd 9 --output-fd 9 --owns-fd
else
  jsh::init
fi
trap 'jsh::cleanup' EXIT

# Timeout for kubectl operations (seconds)
readonly KUBECTL_TIMEOUT="${NUKEM_TIMEOUT:-30}"

# =============================================================================
# Output
# =============================================================================

if [[ "${JSH_PLAIN_OUTPUT:-0}" != 1 && "${TERM:-dumb}" != dumb &&
  -z ${NO_COLOR+x} && "${JSH_COLOR:-auto}" != never ]] \
  && { [[ -t 2 ]] || [[ "${JSH_COLOR:-auto}" == always ]]; }; then
  C_RESET=$'\033[0m' C_DIM=$'\033[2m'
else
  C_RESET='' C_DIM=''
fi

die() {
  jsh::log_error "$@"
  exit 1
}
_debug() { printf '%sdebug:%s %s\n' "${C_DIM}" "${C_RESET}" "$*" >&2; }
cli_version() { printf '%s 1.0.1\n' "${SELF}"; }
cli_help() {
  cat <<EOF
Usage: ${SELF} [options] <namespace>

Options:
  -l, --list          List namespaces stuck in Terminating
  -f, --force         Skip confirmation
  -n, --dry-run       Preview finalizer removal
  -c, --context CTX   Use a kubectl context
  -v, --verbose       Show debug output
  -h, --help          Show help
      --version       Show version
EOF
}

# Override debug with script-specific env var
debug() { [[ "${NUKEM_DEBUG:-0}" == "1" ]] && _debug "$@" || true; }

# =============================================================================
# Utilities
# =============================================================================

# Check if kubectl is available
require_kubectl() {
  if ! command -v kubectl &>/dev/null; then
    die "kubectl is required but not installed"
  fi
}

# Build kubectl command with optional context
kubectl_cmd() {
  local cmd=(kubectl)
  [[ -n "${KUBECTL_CONTEXT:-}" ]] && cmd+=(--context "${KUBECTL_CONTEXT}")
  cmd+=(--request-timeout="${KUBECTL_TIMEOUT}s")
  "${cmd[@]}" "$@"
}

# List namespaces stuck in Terminating state
list_terminating() {
  jsh::log_note "Checking for namespaces in Terminating state..."

  local namespaces
  namespaces=$(kubectl_cmd get namespaces -o jsonpath='{range .items[?(@.status.phase=="Terminating")]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)

  if [[ -z "${namespaces}" ]]; then
    jsh::log_success "No namespaces stuck in Terminating state"
    return 0
  fi

  printf '\n'
  jsh::log_info "Terminating Namespaces"
  while IFS= read -r ns; do
    local finalizers
    finalizers=$(kubectl_cmd get namespace "${ns}" -o jsonpath='{.spec.finalizers}' 2>/dev/null || echo "[]")
    if [[ "${finalizers}" != "[]" && "${finalizers}" != "" ]]; then
      jsh::status warn "${ns} finalizers ${finalizers}"
    else
      jsh::status skip "${ns} no finalizers"
    fi
  done <<<"${namespaces}"
}

# Get namespace details
get_namespace_info() {
  local ns="$1"

  # Check if namespace exists
  if ! kubectl_cmd get namespace "${ns}" &>/dev/null; then
    die "Namespace '${ns}' not found"
  fi

  # Get namespace phase
  local phase
  phase=$(kubectl_cmd get namespace "${ns}" -o jsonpath='{.status.phase}' 2>/dev/null)

  if [[ "${phase}" != "Terminating" ]]; then
    die "Namespace '${ns}' is not in Terminating state (current: ${phase:-Active})"
  fi

  # Get finalizers
  local finalizers
  finalizers=$(kubectl_cmd get namespace "${ns}" -o jsonpath='{.spec.finalizers}' 2>/dev/null || echo "[]")

  printf '%s' "${finalizers}"
}

# Remove finalizers from namespace
remove_finalizers() {
  local ns="$1"
  local dry_run="${2:-false}"

  if [[ "${dry_run}" == "true" ]]; then
    jsh::log_note "[DRY RUN] Would remove finalizers from namespace '${ns}'"

    # Show current state
    printf '\n'
    jsh::log_info "Current Namespace JSON"
    kubectl_cmd get namespace "${ns}" -o json | head -30
    jsh::log_detail "  Output truncated"

    jsh::log_note "[DRY RUN] Would POST to: /api/v1/namespaces/${ns}/finalize"
    return 0
  fi

  debug "Fetching namespace JSON..."
  local ns_json
  ns_json=$(kubectl_cmd get namespace "${ns}" -o json)

  debug "Removing finalizers from JSON..."
  # Remove finalizers array (handles both array content and empty array)
  local modified_json
  modified_json=$(echo "${ns_json}" | tr -d '\n' | sed 's/"finalizers":\s*\[[^]]*\]/"finalizers": []/')

  debug "Applying modified namespace via finalize endpoint..."
  if echo "${modified_json}" | kubectl_cmd replace --raw "/api/v1/namespaces/${ns}/finalize" -f - &>/dev/null; then
    jsh::log_success "Finalizers removed from namespace '${ns}'"

    # Wait a moment and check if it's gone
    sleep 2
    if ! kubectl_cmd get namespace "${ns}" &>/dev/null; then
      jsh::log_success "Namespace '${ns}' has been deleted"
    else
      jsh::log_note "Namespace may take a moment to fully delete"
    fi
    return 0
  else
    die "Failed to remove finalizers from namespace '${ns}'"
  fi
}

# =============================================================================
# Main
# =============================================================================

main() {
  local namespace=""
  local force=false
  local dry_run=false
  local list_mode=false

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        cli_help
        exit 0
        ;;
      --version)
        cli_version
        exit 0
        ;;
      -l | --list)
        list_mode=true
        shift
        ;;
      -f | --force)
        force=true
        shift
        ;;
      -n | --dry-run)
        dry_run=true
        shift
        ;;
      -c | --context)
        [[ $# -lt 2 ]] && die "Option $1 requires an argument"
        KUBECTL_CONTEXT="$2"
        shift 2
        ;;
      -v | --verbose)
        NUKEM_DEBUG=1
        export NUKEM_DEBUG
        shift
        ;;
      -*)
        die "Unknown option: $1 (use --help for usage)"
        ;;
      *)
        if [[ -z "${namespace}" ]]; then
          namespace="$1"
        else
          die "Unexpected argument: $1"
        fi
        shift
        ;;
    esac
  done

  # Check requirements
  require_kubectl

  # Handle list mode
  if [[ "${list_mode}" == "true" ]]; then
    list_terminating
    exit 0
  fi

  # Require namespace argument
  if [[ -z "${namespace}" ]]; then
    die "Namespace argument required (use --help for usage)"
  fi

  # Validate namespace exists and is terminating
  jsh::log_note "Checking namespace '${namespace}'..."
  local finalizers
  finalizers=$(get_namespace_info "${namespace}")

  if [[ "${finalizers}" == "[]" || -z "${finalizers}" ]]; then
    jsh::log_warn "Namespace '${namespace}' has no finalizers (may delete on its own)"
    if ! jsh::confirm "Proceed anyway?" --default no; then
      jsh::log_note "Operation cancelled"
      exit 3
    fi
  fi

  # Show warning and get confirmation
  if [[ "${force}" != "true" && "${dry_run}" != "true" ]]; then
    printf '\n'
    jsh::log_info "Destructive Operation"
    jsh::status error "Namespace ${namespace}"
    jsh::status warn "Finalizers ${finalizers}"
    jsh::log_detail "  Irreversible; external resources may be orphaned."
    jsh::log_detail "  Continue only when these finalizers are known to be stuck."

    if ! jsh::confirm "Are you sure you want to proceed?" --default no; then
      jsh::log_note "Operation cancelled"
      exit 3
    fi
  fi

  # Execute
  remove_finalizers "${namespace}" "${dry_run}"
}

# Handle interrupts gracefully
trap 'printf "\n"; die "Interrupted"' INT TERM

main "$@"
