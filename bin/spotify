#!/usr/bin/env bash
# Update and control Spotify through the desktop client.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
readonly SCRIPT_DIR
readonly SPOTIFY_CONFIGURE_SCRIPT=${SPOTIFY_CONFIGURE_SCRIPT:-"${SCRIPT_DIR}/../scripts/unix/configure/spotify.sh"}
readonly SPOTIFY_PLAY_ROUTE=spotify:search:spotifix-random-playlist

usage() {
  cat << 'EOF'
Usage: spotify [restart|stop|open|play]

Commands:
  restart  Close and reopen Spotify
  stop     Close Spotify
  open     Open Spotify
  play     Open Spotify and play a random saved playlist

With no command, update Spicetify and configure Spotify.
EOF
}

spotify_is_running() {
  pgrep -x spotify > /dev/null 2>&1 ||
    pgrep -f 'Spotify.app/Contents/MacOS/Spotify' > /dev/null 2>&1
}

spotify_flatpak_is_running() {
  pgrep -f '/app/extra/share/spotify/spotify' > /dev/null 2>&1
}

spotify_flatpak_is_installed() {
  command -v flatpak > /dev/null 2>&1 && flatpak info com.spotify.Client > /dev/null 2>&1
}

spotify_native_binary() {
  local candidate
  for candidate in "${SPOTIFY_BINARY:-}" /usr/bin/spotify /usr/local/bin/spotify; do
    [[ -n ${candidate} && -x ${candidate} ]] || continue
    [[ ! ${candidate} -ef ${BASH_SOURCE[0]} ]] || continue
    printf '%s\n' "${candidate}"
    return 0
  done
  return 1
}

open_spotify() {
  local uri=${1:-} platform=${SPOTIFY_PLATFORM:-$(uname -s)} binary
  local -a command

  case ${platform} in
    Darwin)
      if [[ -n ${uri} ]]; then
        open "${uri}"
      else
        open -a Spotify
      fi
      ;;
    Linux)
      # shellcheck disable=SC2310 # Backend detection is intentionally used as a predicate.
      if spotify_flatpak_is_installed; then
        command=(flatpak run com.spotify.Client)
      elif binary=$(spotify_native_binary); then
        command=("${binary}")
      else
        printf 'spotify: Spotify is not installed.\n' >&2
        return 1
      fi
      [[ -z ${uri} ]] || command+=("--uri=${uri}")
      "${command[@]}" > /dev/null 2>&1 &
      ;;
    *)
      printf 'spotify: unsupported platform: %s\n' "${platform}" >&2
      return 1
      ;;
  esac
}

stop_spotify() {
  local platform=${SPOTIFY_PLATFORM:-$(uname -s)} attempt
  # shellcheck disable=SC2310 # Running state is intentionally used as a predicate.
  spotify_is_running || return 0

  case ${platform} in
    Darwin) osascript -e 'tell application "Spotify" to quit' > /dev/null ;;
    Linux)
      # shellcheck disable=SC2310 # Backend detection is intentionally used as a predicate.
      if spotify_flatpak_is_running && command -v flatpak > /dev/null 2>&1; then
        flatpak kill com.spotify.Client > /dev/null 2>&1
      else
        pkill -TERM -x spotify > /dev/null 2>&1
      fi
      ;;
    *)
      printf 'spotify: unsupported platform: %s\n' "${platform}" >&2
      return 1
      ;;
  esac

  for ((attempt = 0; attempt < 50; attempt++)); do
    # shellcheck disable=SC2310 # Running state is intentionally used as a predicate.
    spotify_is_running || return 0
    sleep 0.2
  done
  printf 'spotify: Spotify did not stop.\n' >&2
  return 1
}

restart_spotify() {
  stop_spotify
  open_spotify
}

play_random_playlist() {
  local timestamp
  timestamp=$(date +%s)
  open_spotify "${SPOTIFY_PLAY_ROUTE}-${timestamp}-${RANDOM}"
}

configure_spotify() {
  "${SPOTIFY_CONFIGURE_SCRIPT}" --yes
}

update_spicetify() {
  command -v spicetify > /dev/null 2>&1 || {
    printf 'spotify: spicetify is not installed.\n' >&2
    return 1
  }
  spicetify update
}

main() {
  case ${1:-} in
    '')
      update_spicetify
      configure_spotify
      ;;
    restart) restart_spotify ;;
    stop) stop_spotify ;;
    open) open_spotify ;;
    play) play_random_playlist ;;
    -h | --help | help) usage ;;
    *)
      printf 'spotify: unknown command: %s\n' "$1" >&2
      usage >&2
      return 2
      ;;
  esac
}

if [[ ${SPOTIFY_SOURCE_ONLY:-0} != 1 ]]; then
  main "$@"
fi
