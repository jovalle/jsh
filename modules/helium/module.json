{
  "description": "Helium browser with its managed policy and preferences",
  "install": [
    { "brew": { "casks": ["helium-browser"] } },
    {
      "appimage": {
        "name": "helium",
        "release": "https://api.github.com/repos/imputnet/helium-linux/releases/latest",
        "architectures": { "aarch64": "arm64", "x86_64": "x86_64" }
      }
    }
  ],
  "configure": [{ "script": "configure.py" }]
}
