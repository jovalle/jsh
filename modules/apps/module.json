{
  "description": "Desktop apps without managed settings",
  "install": [
    {
      "brew": {
        "formulae": ["spicetify-cli"],
        "casks": [
          "android-platform-tools",
          "citrix-workspace",
          "foobar2000",
          "signal",
          "spotify",
          "tailscale-app",
          "todoist-app",
          "vorssaint",
          "zoom"
        ]
      },
      "when": { "platform": "darwin" }
    },
    {
      "brew": { "casks": ["bambu-studio", "elgato-stream-deck", "macfuse", "mounty"] },
      "when": { "platform": "darwin", "host": "archon" }
    },
    { "flatpak": ["com.spotify.Client", "com.todoist.Todoist"] }
  ],
  "configure": [{ "script": "foobar.py", "when": { "platform": "darwin" } }]
}
