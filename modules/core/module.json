{
  "description": "Base shell, Git, Python, and system packages the other modules rely on",
  "install": [
    { "brew": { "formulae": ["bash", "curl", "git", "python", "zsh"] }, "when": { "platform": "darwin" } },
    { "apt": ["bash", "ca-certificates", "curl", "git", "python3", "zsh", "procps"] },
    { "dnf": ["bash", "ca-certificates", "curl", "git", "python3", "zsh", "procps-ng"] }
  ]
}
