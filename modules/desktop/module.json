{
  "description": "GNOME and XFCE appearance, panel, screensaver, extensions, and settings files",
  "when": { "desktop": ["gnome", "xfce"] },
  "install": [
    {
      "apt": [
        "fontconfig",
        "xfce4-appfinder",
        "arc-theme",
        "papirus-icon-theme",
        "pavucontrol",
        "xfce4-clipman-plugin",
        "xfce4-cpugraph-plugin",
        "xfce4-docklike-plugin",
        "xfce4-fsguard-plugin",
        "xfce4-genmon-plugin",
        "xfce4-netload-plugin",
        "xfce4-pulseaudio-plugin",
        "xfce4-screensaver",
        "xfce4-systemload-plugin",
        "xfce4-taskmanager",
        "xfce4-terminal"
      ],
      "when": { "desktop": "xfce" }
    },
    {
      "dnf": [
        "fontconfig",
        "xfce4-appfinder",
        "arc-theme",
        "papirus-icon-theme",
        "pavucontrol",
        "xfce4-clipman-plugin",
        "xfce4-cpugraph-plugin",
        "xfce4-docklike-plugin",
        "xfce4-fsguard-plugin",
        "xfce4-genmon-plugin",
        "xfce4-netload-plugin",
        "xfce4-pulseaudio-plugin",
        "xfce4-screensaver",
        "xfce4-systemload-plugin",
        "xfce4-taskmanager",
        "xfce4-terminal"
      ],
      "when": { "desktop": "xfce" }
    },
    { "script": "extensions.py", "when": { "desktop": "gnome" } },
    {
      "apt": [
        "build-essential",
        "pkg-config",
        "patch",
        "intltool",
        "libgtk-3-dev",
        "libpulse-dev",
        "libxfce4panel-2.0-dev",
        "libxfce4ui-2-dev",
        "libxfconf-0-dev",
        "libkeybinder-3.0-dev",
        "libnotify-dev",
        "libwnck-3-dev",
        "libexo-2-dev",
        "libxfce4windowing-0-dev"
      ],
      "when": { "desktop": "xfce", "platform": "debian", "host": "colossus" }
    }
  ],
  "configure": [
    { "script": "plugin.py", "when": { "desktop": "xfce", "platform": "debian", "host": "colossus" } },
    { "script": "desktop.sh" },
    { "script": "extensions.py", "when": { "desktop": "gnome" } }
  ]
}
