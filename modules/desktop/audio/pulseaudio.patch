+/* Prefer the active port, then device metadata for USB and Bluetooth devices. */
+static gint
+jsh_output_kind (const gchar *value)
+{
+  gchar *lower;
+  gint kind = 0;
+
+  if (value == NULL)
+    return 0;
+  lower = g_ascii_strdown (value, -1);
+  if (strstr (lower, "headphone") || strstr (lower, "headset"))
+    kind = 1;
+  else if (strstr (lower, "speaker"))
+    kind = -1;
+  g_free (lower);
+  return kind;
+}
+
+static gboolean
+jsh_is_headphones (const gchar *port, const gchar *port_description,
+                   const gchar *form_factor, const gchar *icon_name)
+{
+  gint kind = jsh_output_kind (port);
+  if (!kind)
+    kind = jsh_output_kind (port_description);
+  if (!kind)
+    kind = jsh_output_kind (form_factor);
+  if (!kind)
+    kind = jsh_output_kind (icon_name);
+  return kind == 1;
+}
