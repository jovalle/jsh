+
+static gboolean
+jsh_mic_poll (gpointer data)
+{
+  PulseaudioButton *button = data;
+  GSubprocess *process;
+  gchar *script;
+  GError *error = NULL;
+
+  if (button->jsh_pending)
+    return G_SOURCE_CONTINUE;
+  script = g_build_filename (g_get_home_dir (), ".jsh", "modules", "audio",
+                             "microphone.py", NULL);
+  button->jsh_setting = button->jsh_desired >= 0;
+  process = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE |
+                              G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+                              &error, "python3", script,
+                              button->jsh_setting ?
+                                (button->jsh_desired ? "--mute" : "--unmute") : "--panel",
+                              NULL);
+  if (button->jsh_setting)
+    button->jsh_desired = -1;
+  g_free (script);
+  if (process == NULL)
+    {
+      g_clear_error (&error);
+      button->jsh_setting = FALSE;
+      button->jsh_state = -1;
+      if (button->menu != NULL)
+        pulseaudio_menu_set_jsh_mic_state (button->menu, -1);
+      return G_SOURCE_CONTINUE;
+    }
+  button->jsh_pending = TRUE;
+  g_subprocess_communicate_utf8_async (process, NULL, NULL, jsh_mic_done,
+                                       g_object_ref (button));
+  g_object_unref (process);
+  return G_SOURCE_CONTINUE;
+}
