# =============================================================================

# Example: Override a jsh alias for your machine
# unalias ll
# alias ll='ls -lAhF'

# Example: Override a jsh function
# Old function can't be unset, but you can define a wrapper
# my_grep() {
#     grep --color=auto --exclude-dir=node_modules --exclude-dir=.git "$@"
# }

