{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge submodule updates",
      "matchManagers": ["git-submodules"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
