            "spotify",
            "tailscale-app",
            "todoist-app",
            "visual-studio-code",
            "vorssaint",
            "waterfox",
            "zoom"
          ]
        }
      }
    },
    {
      "id": "linux",
      "match": { "os": ["linux"] },
      "install": {
        "flatpak": ["com.spotify.Client", "com.todoist.Todoist"]
      }
    },
    {
      "id": "linux-nondebian",
      "match": { "distro": ["arch", "fedora"] },
      "install": {
        "flatpak": ["com.visualstudio.code", "net.waterfox.waterfox"]
