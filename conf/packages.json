{
  "schema": 1,
  "layers": [
    {
      "id": "core",
      "match": { "os": ["darwin", "linux"] },
      "install": {
        "apt": ["bash", "curl", "git", "jq", "make", "python3", "unzip", "zip", "zsh"],
        "dnf": ["bash", "curl", "git", "jq", "make", "python3", "unzip", "zip", "zsh"],
        "pacman": ["bash", "curl", "git", "jq", "make", "python", "unzip", "zip", "zsh"],
        "brew": {
          "formulae": ["bash", "gum", "jq", "unzip", "zip", "zsh"]
        }
      }
    },
    {
      "id": "unix",
      "match": { "os": ["darwin", "linux"] },
      "install": {
        "brew": {
