            "make",
            "mpv",
            "ncdu",
            "neovim",
            "netcat",
            "nmap",
            "node",
            "opencode",
            "parallel",
            "pnpm",
            "poetry",
            "readline",
            "ripgrep",
            "rsync",
            "rtk",
            "sops",
            "speedtest-go",
            "spicetify-cli",
            "sshpass",
            "stow",
            "summarize",
            "syncthing",
            "tmux",
            "tree",
            "uv",
            "watch",
            "xguot/difi/difi",
            "xorriso",
            "xz",
            "yamllint",
            "yq",
            "zoxide"
          ]
        },
        "uv": ["graphifyy", "pre-commit-hooks", "tmail-cli"],
        "npm": { "rea-agents": "*" }
      }
    },
    {
      "id": "contrib",
      "match": { "os": ["darwin", "linux"] },
      "install": {
        "brew": {
          "formulae": [
            "actionlint",
            "autopep8",
            "black",
            "commitizen",
            "commitlint",
            "eslint",
            "gitleaks",
            "hadolint",
            "markdownlint-cli",
            "pre-commit",
            "prettier",
            "pylint",
            "shellcheck",
            "shfmt"
          ]
        }
      }
    },
    {
      "id": "macos",
      "match": { "os": ["darwin"] },
      "install": {
        "brew": {
          "taps": ["gromgit/fuse"],
          "formulae": ["bash-completion", "displayplacer", "duti", "gromgit/fuse/ntfs-3g-mac", "imagemagick"],
          "casks": [
            "android-platform-tools",
            "antigravity-cli",
            "chatgpt",
            "citrix-workspace",
            "codex",
            "copilot-cli",
            "font-jetbrains-mono-nerd-font",
