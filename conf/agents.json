{
  "schema": 2,
  "mcp": {
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "rea": {
      "command": ["rea", "mcp"]
    }
  },
  "skills": {
    "path": "~/.agents/skills",
    "source": "dotfiles/.agents/skills",
    "keep": ["180g", "atomize", "graphify", "reverse-engineer-anything"]
  },
  "agents": [
    {
      "id": "agy",
      "name": "Antigravity CLI",
      "os": ["darwin"],
      "command": "agy",
      "check": ["agy", "--version"],
      "links": ["~/.gemini", "~/.gemini/antigravity-cli/skills"],
      "inventory": {
        "mcp": [
          {
            "format": "agy",
            "path": "~/.gemini/config/mcp_config.json"
          }
        ],
        "plugins": ["~/.gemini/config/plugins"],
        "skills": ["~/.gemini/config/skills", "~/.gemini/antigravity-cli/skills"],
        "agents": ["~/.gemini/agents"],
        "commands": ["~/.gemini/commands"]
      },
      "keep": {
        "agents": ["gsd-*"],
        "commands": ["gsd"],
        "skills": ["gsd-*"],
        "plugins": ["android-cli-plugin", "chrome-devtools-plugin", "modern-web-guidance-plugin"]
      }
    },
    {
      "id": "chatgpt",
      "name": "ChatGPT",
      "os": ["darwin"],
      "app": "ChatGPT.app"
    },
    {
      "id": "codex",
      "name": "Codex",
      "os": ["darwin"],
      "command": "codex",
      "check": ["codex", "login", "status"],
      "links": ["~/.codex", "~/.codex/skills"],
      "inventory": {
        "mcp": [
          {
            "format": "codex",
            "path": "~/.codex/config.toml"
          }
        ],
        "plugins": [
          {
            "format": "codex",
            "path": "~/.codex/config.toml"
          }
        ],
        "skills": ["~/.codex/skills"],
        "agents": ["~/.codex/agents"],
        "commands": ["~/.codex/prompts"]
      },
      "keep": {
        "mcp": ["computer-use", "node_repl"],
        "plugins": [
          "*@openai-bundled",
          "*@openai-primary-runtime",
          "cloudflare@openai-curated",
          "modern-go-guidelines@goland-codex-marketplace",
          "ponytail@ponytail"
        ]
      }
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot CLI",
      "os": ["darwin"],
      "command": "copilot",
      "check": ["copilot", "--version"],
      "links": ["~/.copilot", "~/.copilot/skills"]
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "command": "opencode",
      "check": ["opencode", "--version"],
      "links": [
        "~/.config/opencode",
        "~/.config/opencode/agent",
        "~/.config/opencode/agents",
        "~/.config/opencode/command",
        "~/.config/opencode/commands",
        "~/.config/opencode/plugin",
        "~/.config/opencode/plugins"
      ],
      "plugins": "~/.config/opencode/opencode.json",
      "reload": ["opencode", "reload"],
      "inventory": {
        "mcp": [
          {
            "format": "opencode",
            "path": "~/.config/opencode/opencode.json"
          }
        ],
        "plugins": [
          {
            "format": "opencode",
            "path": "~/.config/opencode/opencode.json"
          },
          "~/.config/opencode/plugins"
        ],
        "skills": ["~/.config/opencode/skills"],
        "agents": ["~/.config/opencode/agents"],
        "commands": ["~/.config/opencode/commands"],
        "skill_commands": "~/.config/opencode/commands"
      },
      "keep": {
        "agents": ["gsd-*"],
        "commands": ["gsd-*"],
        "mcp": ["gsd"],
        "skills": ["gsd-*"]
      }
    }
  ]
}
