  "associations": {
    "linux": {
      "browserDesktopAlternative": "net.waterfox.waterfox.desktop",
      "citrixIcaDesktop": "jsh-citrix-ica.desktop",
      "citrixReceiverDesktop": "jsh-citrix-receiver.desktop",
      "htmlDesktop": "waterfox.desktop",
      "httpDesktop": "waterfox.desktop",
      "httpsDesktop": "waterfox.desktop"
    },
    "macos": {
      "citrixBundleId": "com.citrix.receiver.nomas",
      "htmlBundleId": "net.waterfox.waterfox",
      "htmlType": "public.html",
      "httpBundleId": "net.waterfox.waterfox",
      "httpsBundleId": "net.waterfox.waterfox",
