  "search": {
    "default": "Google",
    "privateDefault": "DuckDuckGo"
  },
  "toolbar": {
    "placements": {
      "TabsToolbar": ["tabbrowser-tabs", "new-tab-button"]
    },
    "remove": [
      "alltabs-button",
      "firefox-view-button",
      "history-panelmenu",
      "import-button",
      "waterfox-blocker-toolbar-button"
    ]
  },
