{
  "agent": {
    "button": false,
    "enable_feedback": false,
    "enabled": false,
    "notify_when_agent_waiting": "never",
    "play_sound_when_agent_done": "never",
    "prevent_idle_sleep": false,
    "show_merge_conflict_indicator": false
  },
  "auto_install_extensions": {
    "html": false
  },
  "auto_update_extensions": {
    "html": false,
    "macos-classic": false,
    "nvim-nightfox": false,
    "vscode-dark-modern": false
  },
  "auto_update": false,
  "base_keymap": "SublimeText",
  "buffer_font_family": "JetBrainsMono NF",
  "buffer_font_fallbacks": ["Menlo", "monospace"],
  "buffer_font_size": 12,
  "calls": {
    "mute_on_join": true,
    "share_on_join": false
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "diagnostics": {
    "button": false,
    "inline": {
      "enabled": false
    }
  },
  "disable_ai": true,
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "none"
  },
  "enable_language_server": false,
  "ensure_final_newline_on_save": true,
  "file_types": {
    "Shell Script": ["*.list"],
    "YAML": ["*.yaml.*"]
  },
  "format_on_save": "off",
  "global_lsp_settings": {
    "button": false
  },
  "granted_extension_capabilities": [],
  "gutter": {
    "breakpoints": false,
    "runnables": false
  },
  "hover_popover_delay": 1000,
  "jupyter": {
    "enabled": false
  },
  "line_ending": "prefer_lf",
  "linked_edits": false,
  "load_direnv": "disabled",
  "minimap": {
    "show": "never"
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "private_files": ["**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt", "**/.dev.vars", "**/secrets.yml"],
  "project_panel": {
    "auto_reveal_entries": false
  },
  "projects_online_by_default": false,
  "read_ssh_config": false,
  "redact_private_values": true,
  "session": {
    "trust_all_worktrees": false
  },
  "show_call_status_icon": false,
  "show_edit_predictions": false,
  "soft_wrap": "editor_width",
  "sticky_scroll": {
    "enabled": true
  },
  "tab_size": 2,
  "tasks": {
    "enabled": false,
    "prefer_lsp": false
  },
  "telemetry": {
    "anthropic_retention": false,
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "copy_on_select": true,
    "detect_venv": "off",
    "font_family": "JetBrainsMono NF",
    "font_fallbacks": ["Meslo", "Menlo", "monospace"],
    "font_size": 12,
    "max_scroll_history_lines": 10000
  },
  "theme": {
    "dark": "VSCode Dark Modern",
    "light": "One Light",
    "mode": "dark"
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_menu": false,
    "show_user_picture": false
  },
  "toolbar": {
    "agent_review": false,
    "quick_actions": false
  },
  "ui_font_size": 16,
  "vim_mode": false,
  "wrap_guides": [100]
}
