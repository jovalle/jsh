#compdef j p

_j() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --verbose)'{-v,--verbose}'[Show search steps]' \
    '(-c --code)'{-c,--code}'[Open in VS Code without changing directory]' \
    '(-a --add)'{-a,--add}'[Add the current directory]' \
    '--remove[Remove the current directory]' \
    '--db[Show tracked directories and scores]' \
    '--clean[Remove directories that no longer exist]' \
    '(-r --remote)'{-r,--remote}'[Open a remote project in VS Code]:remote project:->remote' \
    '1:directory or project:->target' \
    '*:query:->target'

  case $state in
    remote)
      local -a remotes
      remotes=(${(f)"$(_gitx_list_remotes 2>/dev/null)"})
      _describe -t remotes 'remote project' remotes
      ;;
    target)
      _j_targets
      ;;
  esac
}

_j_targets() {
  setopt localoptions null_glob

  local project_paths="${JSH_PROJECTS:-${HOME}/.jsh,${HOME}/projects/*,${HOME}/Projects/*}"
  local entry dir name path count last
  local -a targets
  local -A seen

  targets=('.:current directory' '-:previous directory')
  seen[.]=1

  for entry in ${(s:,:)project_paths}; do
    entry="${entry/#\~/${HOME}}"
    entry="${entry#"${entry%%[![:space:]]*}"}"
    entry="${entry%"${entry##*[![:space:]]}"}"

    if [[ "$entry" == *'*'* ]]; then
      for dir in ${~entry}; do
        [[ -d "$dir" ]] || continue
        name="${dir##*/}"
        [[ -n "${seen[$name]:-}" ]] && continue
        targets+=("${name}:${dir/#${HOME}/\~}")
        seen[$name]=1
      done
    elif [[ -d "$entry" ]]; then
      name="${entry##*/}"
      [[ -n "${seen[$name]:-}" ]] && continue
      targets+=("${name}:${entry/#${HOME}/\~}")
      seen[$name]=1
    fi
  done

  if [[ -f "${J_DATA:-}" ]]; then
    while IFS='|' read -r path count last; do
      [[ -d "$path" ]] || continue
      name="${path##*/}"
      [[ -n "${seen[$name]:-}" ]] && continue
      targets+=("${name}:${path/#${HOME}/\~}")
      seen[$name]=1
    done < "${J_DATA}"
  fi

  _describe -t projects 'directory or project' targets
  _directories
}

_j "$@"
