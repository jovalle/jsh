#compdef jsh

_jsh() {
  local -a commands
  commands=(
  'shell:open the isolated jsh runtime'
  'install:install the launcher and managed dotfile links'
  'status:show shell mode and managed-link state'
  'repair:prune stale managed-link state'
  'doctor:report shell and command dependencies'
  'uninstall:restore managed dotfiles and remove the launcher'
  'version:show the jsh version'
  'help:show usage'
  )

  if ((CURRENT == 2)); then
  _describe 'command' commands
  return
  fi

  case "${words[2]}" in
  shell)
  _arguments '-l[open a login shell]'
  ;;
  install)
  _arguments \
    '(-n --dry-run)'{-n,--dry-run}'[preview changes]' \
    '--mode=[select setup mode]:mode:(runtime install)'
  ;;
  status)
  _arguments '--porcelain[print machine-readable state]'
  ;;
  repair)
  _arguments '(-n --dry-run)'{-n,--dry-run}'[preview changes]'
  ;;
  doctor)
  _arguments \
    '--porcelain[print machine-readable dependencies]' \
    '--strict[fail when optional dependencies are missing]'
  ;;
  uninstall)
  _arguments \
    '(-n --dry-run)'{-n,--dry-run}'[preview changes]' \
    '--purge[remove a clean fully rolled-back checkout]'
  ;;
  esac
}

_jsh "$@"
