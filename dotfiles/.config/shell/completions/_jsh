#compdef jsh

_jsh() {
  local command description help_output line pending_command reading_commands=0
  local -a commands

  if ((CURRENT == 2)); then
    if ! help_output="$(COLUMNS=200 JSH_PLAIN_OUTPUT=1 JSH_COLOR=never \
      "${JSH_DIR}/bin/jsh" help 2>/dev/null)"; then
      _message "unable to load jsh commands from ${JSH_DIR}/bin/jsh help"
      return 1
    fi
    while IFS= read -r line; do
      if [[ "${line}" == Commands ]]; then
        reading_commands=1
        continue
      fi
      (( reading_commands )) || continue
      if [[ "${line}" == '  '[^[:space:]]* ]]; then
        command="${${line#  }%%[[:space:]]*}"
        description="${line#  }"
        if [[ "${description}" == *'  '* ]]; then
          description="${description#*  }"
          description="${description#"${description%%[![:space:]]*}"}"
          commands+=("${command}:${(L)description[1]}${description[2,-1]}")
          pending_command=''
        else
          pending_command="${command}"
        fi
      elif [[ -n "${pending_command}" && -n "${line//[[:space:]]/}" ]]; then
        description="${line#"${line%%[![:space:]]*}"}"
        commands+=("${pending_command}:${(L)description[1]}${description[2,-1]}")
        pending_command=''
      fi
    done <<<"${help_output}"
    for command in ${(ok)JSH_COMMAND_DESCRIPTIONS}; do
      description="${JSH_COMMAND_DESCRIPTIONS[${command}]//:/\\:}"
      commands+=("${command}:${description}")
    done
    if (( ! ${#commands} )); then
      _message "unable to find commands in ${JSH_DIR}/bin/jsh help output"
      return 1
    fi
    _describe 'command' commands
    return
  fi

  case "${words[2]}" in
  -c)
    if (( CURRENT == 3 )); then
      _command_names
    else
      _normal
    fi
    ;;
  shell)
    _arguments '-l[open a login shell]'
    ;;
  install)
    _arguments \
      '(-n --dry-run)'{-n,--dry-run}'[preview changes]' \
      '(-y --yes)'{-y,--yes}'[apply changes without prompting]' \
      '(-v --verbose)'{-v,--verbose}'[show command output]' \
      '--mode=[select setup mode]:mode:(lite full)'
    ;;
  status)
    _arguments \
      '(-v --verbose)'{-v,--verbose}'[show detailed status]' \
      '--porcelain[print machine-readable state]'
    ;;
  repair)
    _arguments '(-n --dry-run)'{-n,--dry-run}'[preview changes]'
    ;;
  doctor)
    _arguments \
      '--porcelain[print machine-readable dependencies]' \
      '--strict[fail when optional dependencies are missing]'
    ;;
  env)
    local -a env_commands
    env_commands=(
      'status:show the current project environment'
      'trust:trust a project .jshrc file'
      'reload:reload the current project environment'
    )
    if (( CURRENT == 3 )); then
      _describe 'command' env_commands
    elif [[ "${words[3]}" == trust ]] && (( CURRENT == 4 )); then
      _files
    fi
    ;;
  uninstall)
    _arguments \
      '(-n --dry-run)'{-n,--dry-run}'[preview changes]' \
      '--purge[remove a clean fully rolled-back checkout]'
    ;;
  esac
}

_jsh "$@"
