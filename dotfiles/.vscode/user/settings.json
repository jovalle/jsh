{
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
      "comments": false,
      "other": true,
      "strings": true
    },
    "editor.tabSize": 2
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[graphql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace",
    "editor.tabSize": 2,
    "gitlens.codeLens.scopes": ["document"]
  },
  "[less]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    },
    "editor.wordWrap": "on"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.tabSize": 4
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[toml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[yaml]": {
    "diffEditor.ignoreTrimWhitespace": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "black-formatter.args": ["--line-length", "100"],
  "chat.agent.maxRequests": 1000,
  "chat.agent.thinkingStyle": "collapsedPreview",
  "chat.mcp.gallery.enabled": true,
  "chat.requestQueuing.defaultAction": "queue",
  "chat.tools.terminal.autoApprove": {
    "awk": true,
    "cat": true,
    "date": true,
    "echo": true,
    "file": true,
    "find": true,
    "git branch": true,
    "git check-ignore": true,
    "git diff": true,
    "git log": true,
    "git mv": true,
    "git remote": true,
    "git show": true,
    "git status": true,
    "grep": true,
    "head": true,
    "jq": true,
    "ls": true,
    "mv": true,
    "npx biome": true,
    "printf": true,
    "pwd": true,
    "rg": true,
    "rtk": true,
    "sed": true,
    "shellcheck": true,
    "tail": true,
    "task": true,
    "test": true,
    "wc": true,
    "which": true,
    "whoami": true
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "diffEditor.wordWrap": "on",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "JetBrainsMono NF, Menlo, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.hover.delay": 1000,
  "editor.inlineSuggest.enabled": true,
  "editor.insertSpaces": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.rulers": [100],
  "editor.stickyScroll.enabled": true,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "editor.wordWrap": "on",
  "eslint.enable": true,
  "eslint.validate": ["javascript", "typescript"],
  "explorer.autoReveal": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "*.list": "dotenv",
    "*.yaml.*": "yaml"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/node_modules": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.fetchOnPull": true,
  "git.inputValidationLength": 72,
  "git.inputValidationSubjectLength": 50,
  "git.openRepositoryInParentFolders": "always",
  "git.pruneOnFetch": true,
  "git.replaceTagsWhenPull": true,
  "github.copilot.advanced": {
    "debug.filterLogCategories": [],
    "debug.overrideEngine": "",
    "debug.overrideProxyUrl": "",
    "debug.testOverrideProxyUrl": ""
  },
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": true,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlens.advanced.messages": {
    "suppressGitMissingWarning": true,
    "suppressLineUncommittedWarning": true
  },
  "go.formatTool": "goimports",
  "go.toolsManagement.autoUpdate": true,
  "go.useLanguageServer": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "makefile.configureOnOpen": true,
  "material-icon-theme.folders.theme": "specific",
  "prettier.requireConfig": true,
  "python.analysis.typeCheckingMode": "standard",
  "python.defaultInterpreterPath": "/usr/local/bin/python",
  "redhat.telemetry.enabled": false,
  "remote.SSH.configFile": "~/.ssh/config",
  "remote.SSH.remotePlatform": {
    "gateway": "linux",
    "mothership": "linux",
    "ms-01": "linux",
    "ms-02": "linux",
    "ms-03": "linux",
    "nexus": "linux",
    "stargate": "linux",
    "starport": "linux",
    "warpgate": "linux",
    "watchtower": "linux"
  },
  "remote.SSH.useExecServer": true,
  "remote.SSH.useLocalServer": false,
  "runOnSave.commands": [
    {
      "command": "perl -i -pe 'BEGIN{$/=undef} s/^\\s+//s' ${file}",
      "finishStatusMessage": "",
      "runIn": "backend",
      "runningStatusMessage": ""
    }
  ],
  "scm.defaultViewMode": "tree",
  "search.defaultViewMode": "tree",
  "security.workspace.trust.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "settingsSync.ignoredExtensions": [],
  "settingsSync.ignoredSettings": [],
  "shellcheck.enable": true,
  "shellcheck.run": "onSave",
  "shellformat.flag": "-i 2 -ci -sr",
  "sync.autoDownload": true,
  "sync.autoUpload": true,
  "sync.quietSync": true,
  "telemetry.telemetryLevel": "off",
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "JetBrainsMono NF, Meslo, Menlo, monospace",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "icon": "terminal-bash",
      "path": "bash"
    },
    "fish": {
      "icon": "terminal-bash",
      "path": "fish"
    },
    "tmux": {
      "icon": "terminal-tmux",
      "path": "tmux"
    },
    "zsh": {
      "icon": "terminal-bash",
      "path": "zsh"
    }
  },
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.history": 100,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.stickyScroll.enabled": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vim.useSystemClipboard": true,
  "window.autoDetectColorScheme": false,
  "workbench.colorCustomizations": {
    "terminal.ansiBlack": "#000000",
    "terminal.ansiBlue": "#2472C8",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightBlue": "#3B8EEA",
    "terminal.ansiBrightCyan": "#29B8DB",
    "terminal.ansiBrightGreen": "#23D18B",
    "terminal.ansiBrightMagenta": "#D670D6",
    "terminal.ansiBrightRed": "#F14C4C",
    "terminal.ansiBrightWhite": "#E5E5E5",
    "terminal.ansiBrightYellow": "#F5F543",
    "terminal.ansiCyan": "#11A8CD",
    "terminal.ansiGreen": "#0DBC79",
    "terminal.ansiMagenta": "#BC3FBC",
    "terminal.ansiRed": "#CD3131",
    "terminal.ansiWhite": "#E5E5E5",
    "terminal.ansiYellow": "#E5E510",
    "terminal.background": "#1F1F1F",
    "terminal.foreground": "#CCCCCC",
    "terminal.selectionBackground": "#264F78",
    "terminalCursor.background": "#1F1F1F",
    "terminalCursor.foreground": "#CCCCCC"
  },
  "workbench.colorTheme": "Dark Modern",
  "workbench.editorAssociations": {
    "*.plist": "default"
  },
  "workbench.iconTheme": "material-icon-theme",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredHighContrastColorTheme": "Dark+",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.tree.enableStickyScroll": true,
  "yaml.customTags": ["!ENV scalar", "!ENV sequence", "!reference sequence"],
  "yaml.format.bracketSpacing": true,
  "yaml.format.enable": true,
  "yaml.format.singleQuote": false,
  "yaml.validate": true
}
