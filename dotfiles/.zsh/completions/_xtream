#compdef xtream

if (( CURRENT == 2 )); then
  local -a commands=(
    'search:Search live channels'
    'play:Play a channel by name or ID'
    'refresh:Download the current lineup'
    'list:List live channels'
  )
  _describe 'command' commands
elif [[ $words[2] == play ]] && (( CURRENT == 3 )); then
  local id name
  local -a ids names
  while IFS=$'\t' read -r id name; do
    [[ -n $id ]] || continue
    ids+=("$id")
    names+=("$id  $name")
  done < <(command xtream search --cached --limit 40 -- "$PREFIX" 2>/dev/null)
  (( ${#ids} )) && compadd -U -d names -a ids
fi
