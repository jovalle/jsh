[core]
  quotepath = false
  autocrlf = input
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  editor = vim
  symlinks = true
  # jsh's global hooks reject Co-authored-by trailers, then run each repository's .git/hooks.
  hooksPath = ~/.jsh/lib/git/hooks
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[diff]
  algorithm = histogram
  tool = vimdiff
[difftool]
  prompt = false
[merge]
  conflictStyle = zdiff3
  tool = vimdiff
[rerere]
  enabled = true
[push]
  default = simple
[pull]
  rebase = true
[rebase]
  autoStash = true
[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[lfs]
  fetchinclude = *

# =============================================================================
# User Identity & Signing
# =============================================================================
# Configure via ~/.gitconfig.local or gitx profile:
#
#   [user]
#       name = Your Name
#       email = your@email.com
#       signingkey = YOUR_GPG_KEY_ID
#
#   [gpg]
#       program = gpg
#
#   [commit]
#       gpgsign = true
[credential "https://github.com"]
	helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
  helper = !gh auth git-credential
